---
// src/pages/admin/cursos/[moduloId].astro
import CursoLayout from '../../../layouts/CursoLayout.astro';

// Obtener parámetros
const { moduloId } = Astro.params;
const url = Astro.url;
const searchParams = url.searchParams;
const cursoId = searchParams.get('cursoId');

console.log('=== DEBUG [moduloId].astro ===');
console.log('moduloId:', moduloId);
console.log('cursoId from URL:', cursoId);
console.log('URL completa:', url.toString());
---

<!-- DEBUG visible en la página -->
<div id="debug-info" style="display: none; background: yellow; padding: 10px; margin-bottom: 10px;">
    Debug: moduloId=<span id="debug-moduloId"></span>, cursoId=<span id="debug-cursoId"></span>
</div>
<script is:inline>
    document.getElementById('debug-moduloId').textContent = '${moduloId}';
    document.getElementById('debug-cursoId').textContent = '${cursoId}';
    document.getElementById('debug-info').style.display = 'block';
</script>

<CursoLayout cursoId="${cursoId}" moduloId="${moduloId}">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">
            Crear Nueva Lección - Módulo ${moduloId}
        </h2>
        
        <div class="mb-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
            <p class="text-blue-700 dark:text-blue-300">
                <strong>Debug Info:</strong> Curso: ${cursoId} | Módulo: ${moduloId}
            </p>
        </div>
        
        <form id="form-nueva-leccion" class="space-y-6">
            <div>
                <label for="titulo-leccion" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Título de la Lección *
                </label>
                <input
                    type="text"
                    id="titulo-leccion"
                    name="titulo"
                    required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition-colors"
                    placeholder="Ej: Introducción a los conceptos básicos..."
                />
            </div>

            <div class="flex items-center space-x-4 pt-4">
                <button
                    type="submit"
                    class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                >
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path>
                    </svg>
                    Crear Lección
                </button>

                <a
                    href="/admin/cursos/${cursoId}"
                    class="inline-flex items-center px-6 py-3 bg-gray-200 dark:bg-gray-600 hover:bg-gray-300 dark:hover:bg-gray-500 text-gray-700 dark:text-gray-300 font-medium rounded-lg transition-colors"
                >
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <script is:inline>
        console.log('=== CLIENT SCRIPT [moduloId].astro ===');
        console.log('moduloId:', '${moduloId}');
        console.log('cursoId:', '${cursoId}');

        document.getElementById('form-nueva-leccion')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const leccionData = {
                titulo: formData.get('titulo'),
                modulo_id: parseInt('${moduloId}')
            };

            console.log('Enviando datos:', leccionData);

            try {
                const response = await fetch('http://localhost:8000/api/lecciones/', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(leccionData)
                });

                if (response.ok) {
                    alert('Lección creada exitosamente!');
                    window.location.href = '/admin/cursos/${cursoId}';
                } else {
                    throw new Error('Error al crear la lección');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al crear la lección: ' + error.message);
            }
        });
    </script>
</CursoLayout>