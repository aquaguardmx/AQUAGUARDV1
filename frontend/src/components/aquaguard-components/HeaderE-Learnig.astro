---
// src/components/Header.astro

interface NavItem {
  name: string;
  href: string;
}

const navItems: NavItem[] = [
  { name: "Inicio", href: "/usuario/index-elearning" },
  { name: "Cursos", href: "/usuario/cursos" },
  { name: "Mis Cursos", href: "/usuario/mis-cursos" },
  { name: "Recursos", href: "/recursos" },
  { name: "Sobre Nosotros", href: "/nosotros" },
];

const currentPath = Astro.url.pathname;

// Función para determinar si un item está activo
function isActiveItem(itemHref: string, currentPath: string): boolean {
  const normalizedCurrent = currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
  const normalizedHref = itemHref.endsWith('/') ? itemHref.slice(0, -1) : itemHref;
  
  if (normalizedHref === "" || normalizedHref === "/") {
    return normalizedCurrent === "" || normalizedCurrent === "/";
  }
  
  return normalizedCurrent === normalizedHref || 
         normalizedCurrent.startsWith(normalizedHref + '/');
}

// Función para obtener el nombre del rol basado en id_rol
function getRoleName(idRol: number): string {
  const roles: { [key: number]: string } = {
    1: 'admin',
    2: 'usuario', 
    3: 'docente'
  };
  return roles[idRol] || 'usuario';
}
---

<header class="bg-white shadow-sm border-b border-blue-50 sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center space-x-2 flex-shrink-0">
        <a href="/" class="flex items-center space-x-2">
          <img src="/img/logo.png" alt="AquaLearn" class="w-8 h-8 sm:w-10 sm:h-10" />
          <span class="text-lg sm:text-xl font-bold text-blue-600">AquaLearn</span>
        </a>
      </div>

      <!-- Navegación Desktop -->
      <div class="hidden lg:flex items-center space-x-6 xl:space-x-8">
        {
          navItems.map((item) => {
            const isActive = isActiveItem(item.href, currentPath);
            return (
              <a
                href={item.href}
                class={`px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 hover-lift ${
                  isActive
                    ? "text-blue-600 bg-blue-50 border-b-2 border-blue-400"
                    : "text-gray-600 hover:text-blue-500 hover:bg-blue-50"
                }`}
                data-active={isActive}
                data-href={item.href}
                data-current={currentPath}
              >
                {item.name}
              </a>
            );
          })
        }
        
        <!-- Botón Crear Curso - Solo para admin y docente (se muestra dinámicamente con JS) -->
        <div id="create-course-desktop"></div>
      </div>

      <!-- Contenedor del menú / login - SOLO DESKTOP -->
      <div id="user-section" class="hidden lg:flex items-center space-x-4">
        <!-- Aquí se rellena dinámicamente con JS -->
      </div>

      <!-- Botones móviles - SOLO MÓVIL -->
      <div class="flex items-center space-x-2 lg:hidden">
        <!-- Botón usuario móvil - SOLO se muestra en móvil cuando está logueado -->
        <div id="mobile-user-button" class="hidden">
          <!-- Botón simple de usuario para móvil -->
        </div>
        
        <!-- Botón menú móvil -->
        <button
          type="button"
          class="p-2 text-gray-500 hover:text-blue-500 transition-colors duration-200 rounded-lg hover:bg-blue-50"
          id="mobile-menu-button"
          aria-label="Abrir menú"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            id="menu-icon"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Menú móvil - OCULTO POR DEFAULT -->
    <div class="hidden lg:hidden" id="mobile-menu">
      <div class="px-2 pt-2 pb-4 space-y-1 bg-white border-t border-blue-50 shadow-lg">
        {
          navItems.map((item) => {
            const isActive = isActiveItem(item.href, currentPath);
            return (
              <a
                href={item.href}
                class={`block px-3 py-3 rounded-md text-base font-medium transition-colors duration-200 border-l-4 ${
                  isActive
                    ? "text-blue-600 bg-blue-50 border-blue-400"
                    : "text-gray-600 hover:text-blue-500 hover:bg-blue-50 border-transparent"
                }`}
                data-active={isActive}
                data-href={item.href}
                data-current={currentPath}
              >
                {item.name}
              </a>
            );
          })
        }
        
        <!-- Botón Crear Curso Móvil -->
        <div id="create-course-mobile"></div>
        
        <!-- Sección de usuario en móvil - SOLO se muestra aquí -->
        <div class="border-t border-blue-100 pt-4 mt-4" id="mobile-menu-user">
          <!-- Contenido dinámico para móvil -->
        </div>
      </div>
    </div>
  </nav>
</header>

