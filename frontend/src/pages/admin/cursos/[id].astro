---
// src/pages/admin/cursos/[id]/index.astro

// 1. Importa tu nuevo Layout
import CursoLayout from "../../../layouts/CursoLayout.astro";

const { id } = Astro.params; // id es: string | undefined

// --- AÑADE ESTA VALIDACIÓN ---
// Si no hay ID, no podemos renderizar.
// Puedes redirigir o mostrar un error.
if (!id) {
    // Redirigimos a la página de cursos o a un 404
    return Astro.redirect("/admin/cursos");
}
// Después de este 'if', TypeScript sabe que 'id' SÓLO puede ser 'string'

// Obtener los módulos para pasarlos al layout
let modulos = [];
try {
    const modulosResponse = await fetch(
        `http://localhost:8000/api/cursos/${id}/modulos`,
    );

    if (modulosResponse.ok) {
        const modulosData = await modulosResponse.json();
        if (Array.isArray(modulosData)) {
            modulos = modulosData;
        } else if (modulosData?.data && Array.isArray(modulosData.data)) {
            modulos = modulosData.data;
        } else if (modulosData?.modulos && Array.isArray(modulosData.modulos)) {
            modulos = modulosData.modulos;
        }
    }
} catch (error) {
    console.error("Error cargando módulos:", error);
}
---

<CursoLayout cursoId={id} modulos={modulos}>
    <!-- Contenido Principal -->
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-8">

            <!-- Área Principal - Vista Estática Mejorada -->
            <main class="flex-1 min-w-0">
                <div class="welcome-state">
                    <!-- Partículas decorativas -->
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>

                    <div class="welcome-content">
                        <!-- Cambié el cohete por una ola que representa mejor la temática -->
                        <div class="welcome-icon">🌊</div>
                        <h1 class="welcome-title">Sumérgete en la Creación</h1>
                        <p class="welcome-subtitle">
                            Convierte tu pasión por el medio ambiente en
                            experiencias educativas inspiradoras. Diseña,
                            organiza y comparte conocimiento que cuida nuestro
                            planeta.
                        </p>

                        <div class="feature-grid">
                            <div class="feature-card">
                                <div class="feature-icon">🐠</div>
                                <h3>Ecosistemas Organizados</h3>
                                <p class="text-sm">
                                    Estructura tu contenido en módulos naturales
                                    y fluidos
                                </p>
                            </div>

                            <div class="feature-card">
                                <div class="feature-icon">📚</div>
                                <h3>Contenido Sostenible</h3>
                                <p class="text-sm">
                                    Crea lecciones con conciencia ambiental y
                                    educativa
                                </p>
                            </div>

                            <div class="feature-card">
                                <div class="feature-icon">🌿</div>
                                <h3>Interfaz Natural</h3>
                                <p class="text-sm">
                                    Diseño intuitivo que fluye como los ríos
                                </p>
                            </div>

                            <div class="feature-card">
                                <div class="feature-icon">🔍</div>
                                <h3>Exploración Profunda</h3>
                                <p class="text-sm">
                                    Herramientas para un aprendizaje inmersivo
                                </p>
                            </div>
                        </div>

                        <div class="guide-card">
                            <h4
                                class="font-bold text-xl text-teal-900 dark:text-cyan-100 mb-6 flex items-center"
                            >
                                <span class="text-2xl mr-3">🎯</span>
                                Navega por la Creación en 4 Olas
                            </h4>
                            <div class="guide-steps">
                                <div class="guide-step">
                                    <div class="guide-step-content">
                                        <p>
                                            <strong
                                                >Agrega tu primer módulo</strong
                                            > usando el botón "+" en el panel lateral
                                        </p>
                                    </div>
                                </div>
                                <div class="guide-step">
                                    <div class="guide-step-content">
                                        <p>
                                            <strong>Nombra y organiza</strong> tus
                                            módulos con temática ambiental
                                        </p>
                                    </div>
                                </div>
                                <div class="guide-step">
                                    <div class="guide-step-content">
                                        <p>
                                            <strong
                                                >Crea lecciones envolventes</strong
                                            > con contenido ecológico y práctico
                                        </p>
                                    </div>
                                </div>
                                <div class="guide-step">
                                    <div class="guide-step-content">
                                        <p>
                                            <strong
                                                >Comparte tu conocimiento</strong
                                            > y inspira a proteger nuestro planeta
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</CursoLayout>

<style>
    .welcome-state {
        position: relative;
        overflow: hidden;
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f0fdfa 0%, #ecfdf5 100%);
        border-radius: 24px;
        padding: 3rem 2rem;
    }

    .dark .welcome-state {
        background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
    }

    .particle {
        position: absolute;
        background: rgba(16, 185, 129, 0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .particle:nth-child(1) {
        width: 120px;
        height: 120px;
        top: 10%;
        left: 5%;
        animation-delay: 0s;
    }

    .particle:nth-child(2) {
        width: 80px;
        height: 80px;
        top: 20%;
        right: 10%;
        animation-delay: 1.5s;
    }

    .particle:nth-child(3) {
        width: 100px;
        height: 100px;
        bottom: 15%;
        left: 15%;
        animation-delay: 3s;
    }

    .particle:nth-child(4) {
        width: 60px;
        height: 60px;
        bottom: 10%;
        right: 5%;
        animation-delay: 4.5s;
    }

    @keyframes float {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }
        50% {
            transform: translateY(-20px) rotate(180deg);
        }
    }

    .welcome-content {
        text-align: center;
        max-width: 800px;
        position: relative;
        z-index: 10;
    }

    .welcome-icon {
        font-size: 6rem;
        margin-bottom: 2rem;
        animation: wave 3s ease-in-out infinite;
    }

    @keyframes wave {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }
        25% {
            transform: translateY(-10px) rotate(5deg);
        }
        75% {
            transform: translateY(-5px) rotate(-5deg);
        }
    }

    .welcome-title {
        font-size: 3.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #0d9488 0%, #059669 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1.5rem;
        line-height: 1.2;
    }

    .dark .welcome-title {
        background: linear-gradient(135deg, #5eead4 0%, #34d399 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .welcome-subtitle {
        font-size: 1.25rem;
        color: #475569;
        margin-bottom: 3rem;
        line-height: 1.6;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .dark .welcome-subtitle {
        color: #cbd5e1;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
    }

    .dark .feature-card {
        background: rgba(15, 118, 110, 0.3);
        border: 1px solid rgba(94, 234, 212, 0.3);
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(16, 185, 129, 0.15);
    }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .feature-card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f766e;
        margin-bottom: 0.75rem;
    }

    .dark .feature-card h3 {
        color: #5eead4;
    }

    .feature-card p {
        color: #64748b;
        line-height: 1.5;
    }

    .dark .feature-card p {
        color: #94a3b8;
    }

    .guide-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 2px solid #0d9488;
        border-radius: 20px;
        padding: 2.5rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .dark .guide-card {
        background: rgba(15, 118, 110, 0.4);
        border: 2px solid #5eead4;
    }

    .guide-steps {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .guide-step {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        background: rgba(16, 185, 129, 0.1);
        border-radius: 12px;
        border-left: 4px solid #0d9488;
    }

    .dark .guide-step {
        background: rgba(94, 234, 212, 0.1);
        border-left: 4px solid #5eead4;
    }

    .guide-step-content p {
        color: #475569;
        margin: 0;
        line-height: 1.5;
    }

    .dark .guide-step-content p {
        color: #cbd5e1;
    }

    .guide-step strong {
        color: #0f766e;
    }

    .dark .guide-step strong {
        color: #5eead4;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .welcome-title {
            font-size: 2.5rem;
        }
        
        .welcome-subtitle {
            font-size: 1.125rem;
        }
        
        .feature-grid {
            grid-template-columns: 1fr;
        }
        
        .guide-card {
            padding: 1.5rem;
        }
    }
</style>