---
// src/components/curso/ContenidoPrincipal.astro

const { id } = Astro.params;


interface Leccion {
  tipo: string;
  completado?: boolean;
}

interface Modulo {
  completado: boolean;
  lecciones: Leccion[];
}

interface Curso {
  id_curso: string;
  descripcion: string;
  modulos: Modulo[];
}

const { curso }: { curso?: Curso } = Astro.props;

// Validaciones para evitar errores
const modulosValidos = curso?.modulos || [];
const todosLosModulosCompletados = modulosValidos.length > 0 
  ? modulosValidos.slice(0, -1).every((modulo: Modulo) => modulo.completado)
  : false;

// Buscar el quiz de forma segura
const quiz = modulosValidos.length >= 4 
  ? modulosValidos[3]?.lecciones?.[0] 
  : null;

const totalLecciones = modulosValidos.flatMap((m: Modulo) => m.lecciones || []);
const leccionesNormales = totalLecciones.filter((l: Leccion) => l.tipo !== 'quiz');
const totalQuizzes = totalLecciones.filter((l: Leccion) => l.tipo === 'quiz');
---

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700">
  <!-- Bienvenida al Curso -->
  <div class="text-center py-8">
    <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-teal-400 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg">
      <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
    </div>
    
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
      Bienvenido al curso
    </h2>
    
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
      {curso?.descripcion}
    </p>
    
    <div class="grid md:grid-cols-3 gap-6 mb-8">
      <div class="text-center p-6 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800">
        <div class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-2">
          {modulosValidos.length}
        </div>
        <div class="text-gray-600 dark:text-gray-300 font-medium">Módulos</div>
      </div>
      
      <div class="text-center p-6 bg-green-50 dark:bg-green-900/20 rounded-xl border border-green-100 dark:border-green-800">
        <div class="text-2xl font-bold text-green-600 dark:text-green-400 mb-2">
          {leccionesNormales.length}
        </div>
        <div class="text-gray-600 dark:text-gray-300 font-medium">Lecciones</div>
      </div>
      
      <div class="text-center p-6 bg-orange-50 dark:bg-orange-900/20 rounded-xl border border-orange-100 dark:border-orange-800">
        <div class="text-2xl font-bold text-orange-600 dark:text-orange-400 mb-2">
          {totalQuizzes.length}
        </div>
        <div class="text-gray-600 dark:text-gray-300 font-medium">Evaluaciones</div>
      </div>
    </div>

    <!-- Estado del Quiz -->
    {quiz && (
      <div class={`
        p-6 rounded-2xl border-2 mb-6 text-left max-w-2xl mx-auto
        ${todosLosModulosCompletados 
          ? 'bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800' 
          : 'bg-orange-50 dark:bg-orange-900/20 border-orange-200 dark:border-orange-800'
        }
      `}>
        <div class="flex items-start gap-4">
          <div class={`
            w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0
            ${todosLosModulosCompletados ? 'bg-green-500' : 'bg-orange-500'}
          `}>
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
              {todosLosModulosCompletados ? '¡Quiz Disponible!' : 'Quiz Bloqueado'}
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              {todosLosModulosCompletados 
                ? 'Has completado todos los módulos. Ahora puedes realizar el quiz final para evaluar tus conocimientos.'
                : 'Completa todos los módulos anteriores para desbloquear el quiz final.'
              }
            </p>
            {todosLosModulosCompletados ? (
              <button class="bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-xl transition-all transform hover:scale-105 shadow-lg">
                Realizar Quiz Final
              </button>
            ) : (
              <div class="flex items-center gap-2 text-orange-600 dark:text-orange-400 font-medium">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                </svg>
                Disponible al completar todos los módulos
              </div>
            )}
          </div>
        </div>
      </div>
    )}

    <!-- Botón de inicio -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a 
        href={`/curso/${id}/leccion/1`}
        class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-4 px-8 rounded-xl transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-2 justify-center"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
        </svg>
        Comenzar Curso
      </a>
      
      <button class="border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:border-blue-500 hover:text-blue-500 font-semibold py-4 px-8 rounded-xl transition-all flex items-center gap-2 justify-center">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13l-3 3m0 0l-3-3m3 3V8m0 13a9 9 0 110-18 9 9 0 010 18z"/>
        </svg>
        Descargar Material
      </button>
    </div>
  </div>
</div>