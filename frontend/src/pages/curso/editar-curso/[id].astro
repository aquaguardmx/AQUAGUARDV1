        // Funciones de eliminación
        function setupEliminarModulo() {
            document.querySelectorAll('.eliminar-modulo').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    const moduloId = this.getAttribute('data-modulo-id');
                    const modulosActuales = document.querySelectorAll('.modulo-item').length;
                    
                    if (modulosActuales <= 1) {
                        mostrarMensaje('Debe haber al menos un módulo en el curso', 'error');
                        return;
                    }

                    if (confirm('¿Estás seguro de que quieres eliminar este módulo?')) {
                        try {
                            mostrarMensaje('Eliminando módulo...', 'success');
                            const response = await fetch(`${API_URL}/modulos/${moduloId}`, { method: 'DELETE' });

                            if (response.ok) {
                                mostrarMensaje('Módulo eliminado correctamente. Recargando...', 'success');
                                setTimeout(() => window.location.reload(), 500);
                            } else {
                                const errorData = await response.json().catch(() => ({ message: 'Error desconocido' }));
                                mostrarMensaje('Error al eliminar el módulo: ' + (errorData.message || response.status), 'error');
                            }
                        } catch (error) {
                            mostrarMensaje('Error de conexión al eliminar módulo: ' + error.message, 'error');
                        }
                    }
                });
            });
        }

        function setupEliminarLeccion() {
            document.querySelectorAll('.eliminar-leccion').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    const leccionId = this.getAttribute('data-leccion-id');
                    const modulo = this.closest('.modulo-item');
                    const leccionesEnModulo = modulo ? modulo.querySelectorAll('.leccion-item').length : 0;
                    
                    if (leccionesEnModulo <= 1) {
                        mostrarMensaje('Cada módulo debe tener al menos una lección', 'error');
                        return;
                    }

                    if (confirm('¿Estás seguro de que quieres eliminar esta lección?')) {
                        try {
                            mostrarMensaje('Eliminando lección...', 'success');
                            const response = await fetch(`${API_URL}/lecciones/${leccionId}`, { method: 'DELETE' });

                            if (response.ok) {
                                mostrarMensaje('Lección eliminada correctamente. Recargando...', 'success');
                                setTimeout(() => window.location.reload(), 500);
                            } else {
                                const errorData = await response.json().catch(() => ({ message: 'Error desconocido' }));
                                mostrarMensaje('Error al eliminar la lección: ' + (errorData.message || response.status), 'error');
                            }
                        } catch (error) {
                            mostrarMensaje('Error de conexión al eliminar lección: ' + error.message, 'error');
                        }
                    }
                });
            });
        }

        // Event Listeners para el quiz
        if (agregarQuizBtn) {
            agregarQuizBtn.addEventListener('click', function(e) {
                e.preventDefault();
                mostrarModalQuiz();
            });
        }

        cancelarQuizBtn.addEventListener('click', ocultarModalQuiz);

// Función alternativa más robusta para guardar quiz
guardarQuizBtn.addEventListener('click', async function() {
    const puntajeMinimo = document.getElementById('puntaje-minimo').value;
    const tiempoLimite = document.getElementById('tiempo-limite').value;
    
    if (preguntas.length === 0) {
        mostrarMensaje('Agrega al menos una pregunta al quiz', 'error');
        return;
    }

    if (!CURSO_ID || isNaN(CURSO_ID)) {
        mostrarMensaje('Error: ID del curso no válido', 'error');
        return;
    }

    try {
        mostrarMensaje('Guardando quiz...', 'success');
        
        const quizData = {
            curso_id: CURSO_ID,
            titulo: `Quiz Final - ${document.querySelector('h1').textContent.trim()}`,
            preguntas: preguntas.map(pregunta => ({
                texto_pregunta: pregunta.enunciado,
                tipo_pregunta: pregunta.tipo,
                opciones: pregunta.opciones.map(opcion => ({
                    texto_opcion: opcion.texto,
                    es_correcta: opcion.correcta
                }))
            }))
        };

        console.log('📡 Enviando quiz a:', `${API_URL}/quizzes/`);
        console.log('📦 Datos del quiz:', quizData);

        const response = await fetch(`${API_URL}/quizzes/`, {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(quizData)
        });

        // Manejo simplificado de respuesta
        if (response.ok) {
            const data = await response.json();
            console.log('✅ Quiz guardado exitosamente:', data);
            mostrarMensaje('Quiz guardado correctamente', 'success');
            ocultarModalQuiz();
            actualizarEstadoQuiz();
        } else {
            // Manejo de error simplificado
            let errorText;
            try {
                errorText = await response.text();
                const errorData = JSON.parse(errorText);
                throw new Error(errorData.message || errorData.error || `Error ${response.status}`);
            } catch (parseError) {
                throw new Error(errorText || `Error ${response.status}: ${response.statusText}`);
            }
        }

    } catch (error) {
        console.error('❌ Error completo al guardar quiz:', error);
        mostrarMensaje('Error al guardar el quiz: ' + error.message, 'error');
    }
});

        agregarPreguntaBtn.addEventListener('click', function() {
            // Resetear formulario
            formPregunta.reset();
            opcionesContainer.innerHTML = '';
            opcionCounter = 2;
            
            // Agregar dos opciones por defecto
            for (let i = 0; i < 2; i++) {
                agregarOpcion();
            }
            
            preguntaActualId = null;
            modalPreguntaTitulo.textContent = 'Agregar Nueva Pregunta';
            mostrarModalPregunta();
        });

        cancelarPreguntaBtn.addEventListener('click', ocultarModalPregunta);

        agregarOpcionBtn.addEventListener('click', agregarOpcion);

        formPregunta.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const enunciado = document.getElementById('enunciado-pregunta').value.trim();
            const tipo = document.getElementById('tipo-pregunta').value;
            const puntos = parseInt(document.getElementById('puntos-pregunta').value);
            
            // Validaciones básicas
            if (!enunciado) {
                mostrarMensaje('El enunciado de la pregunta es requerido', 'error');
                return;
            }

            const opcionesItems = opcionesContainer.querySelectorAll('.opcion-item');
            const opciones = [];
            let tieneCorrecta = false;

            opcionesItems.forEach((item, index) => {
                const texto = item.querySelector('.texto-opcion').value.trim();
                const correcta = item.querySelector('.respuesta-correcta').checked;
                
                if (!texto) {
                    mostrarMensaje(`La opción ${index + 1} no puede estar vacía`, 'error');
                    return;
                }

                if (correcta) {
                    tieneCorrecta = true;
                }

                opciones.push({
                    texto: texto,
                    correcta: correcta,
                    orden: index
                });
            });

            if (!tieneCorrecta) {
                mostrarMensaje('Debes seleccionar una opción correcta', 'error');
                return;
            }

            if (opciones.length < 2) {
                mostrarMensaje('Debe haber al menos 2 opciones', 'error');
                return;
            }

            // Crear o actualizar pregunta
            const nuevaPregunta = {
                id: preguntaActualId || Date.now(), // ID temporal
                enunciado: enunciado,
                tipo: tipo,
                puntos: puntos,
                opciones: opciones,
                orden: preguntas.length
            };

            if (preguntaActualId) {
                // Editar pregunta existente
                const index = preguntas.findIndex(p => p.id == preguntaActualId);
                if (index !== -1) {
                    preguntas[index] = nuevaPregunta;
                }
            } else {
                // Agregar nueva pregunta
                preguntas.push(nuevaPregunta);
            }

            renderizarPreguntas();
            ocultarModalPregunta();
            mostrarMensaje(`Pregunta ${preguntaActualId ? 'actualizada' : 'agregada'} correctamente`, 'success');
        });

        // Eventos generales
        if (estadoSelect) {
            estadoSelect.addEventListener('change', async function() {
                const publicado = this.value === 'true';
                try {
                    const response = await fetch(`${API_URL}/cursos/${CURSO_ID}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ publicado: publicado })
                    });
                    
                    if (response.ok) {
                        mostrarMensaje(`Curso ${publicado ? 'publicado' : 'cambiado a borrador'} correctamente`);
                    } else {
                        const errorData = await response.json().catch(() => ({ message: 'Error desconocido' }));
                        mostrarMensaje('Error al actualizar el estado del curso: ' + (errorData.message || response.status), 'error');
                        this.value = !publicado;
                    }
                } catch (error) {
                    mostrarMensaje('Error de conexión al actualizar estado: ' + error.message, 'error');
                    this.value = !publicado;
                }
            });
        }

        if (guardarBtn) {
            guardarBtn.addEventListener('click', () => mostrarMensaje('Cambios guardados correctamente'));
        }
        if (vistaPreviaBtn) {
            vistaPreviaBtn.addEventListener('click', () => window.open(`/curso/${CURSO_ID}`, '_blank'));
        }

        // Inicializar todo
        function inicializarEventListeners() {
            setupEliminarModulo();
            setupAgregarLeccion();
            setupEliminarLeccion();
            setupEditor();
            setupVideoPreview();
            setupUrlValidation();
            setupCerrarModalExterno(modalModulo, modalModuloContent);
            setupCerrarModalExterno(modalLeccion, modalLeccionContent);
            setupCerrarModalExterno(modalQuiz, modalQuizContent);
            setupCerrarModalExterno(modalPregunta, modalPreguntaContent);
            
            // Inicializar manejo de tipo de contenido
            manejarTipoContenido();

            // Inicializar eventos de eliminación para las primeras opciones
            document.querySelectorAll('.eliminar-opcion').forEach(btn => {
                if (!btn.disabled) {
                    setupEliminarOpcion(btn);
                }
            });

            // Cargar quiz existente al inicializar
            cargarQuizExistente();
        }

        // Verificar que tenemos un CURSO_ID válido antes de inicializar
        if (CURSO_ID && !isNaN(CURSO_ID)) {
            inicializarEventListeners();
            console.log('🎉 SISTEMA COMPLETO INICIALIZADO CORRECTAMENTE');
            console.log('✅ MÓDULOS, LECCIONES Y QUIZ CONFIGURADOS');
        } else {
            console.error('❌ No se pudo inicializar el script - CURSO_ID inválido:', CURSO_ID);
            mostrarMensaje('Error: No se pudo cargar el editor correctamente. Recarga la página.', 'error');
        }
    });
</script>

