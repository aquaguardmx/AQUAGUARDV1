---
// 1. IMPORTAR ÚNICAMENTE EL LAYOUT CORRECTO
import CursoLayout from "../../../../../../layouts/CursoLayout.astro";

// 2. OBTENER PARÁMETROS Y VALIDAR
const { cursoId, moduloId } = Astro.params;
if (!cursoId || !moduloId) {
    return new Response("Parámetros no válidos.", { status: 400 });
}
---

<CursoLayout cursoId={cursoId} moduloId={moduloId}>
    <!-- INCLUIR LOS ARCHIVOS DE QUILL EN EL HEAD -->
    <link
        href="https://cdn.quilljs.com/1.3.6/quill.snow.css"
        rel="stylesheet"
    />
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

    <!-- Header Mejorado -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <a
                href={`/admin/cursos/${cursoId}`}
                class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                >
                    <path
                        fill-rule="evenodd"
                        d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                        clip-rule="evenodd"></path>
                </svg>
            </a>
            <span class="text-gray-500 dark:text-gray-400 text-sm"
                >Volver al curso</span
            >
        </div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
            Crear Nueva Lección
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mt-2">
            Completa los detalles para crear una nueva lección en tu módulo
        </p>
    </div>

    <!-- Main Card Mejorada -->
    <div
        class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300 hover:shadow-md"
    >
        <!-- Card Header -->
        <div
            class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-700 dark:to-gray-800"
        >
            <div class="flex items-center">
                <div
                    class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300 mr-3"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                        ></path>
                    </svg>
                </div>
                <div>
                    <h2
                        class="text-xl font-semibold text-gray-800 dark:text-white"
                    >
                        Información de la Lección
                    </h2>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">
                        Los campos marcados con * son obligatorios
                    </p>
                </div>
            </div>
        </div>

        <!-- Form Mejorado -->
        <form
    id="leccion-form"
    method="POST"
    class="p-6 lg:p-8 space-y-8"
    data-curso-id={cursoId}
>
            <input type="text" name="modulo_id" value={moduloId} />

            <!-- Título Mejorado -->
            <div class="fade-in">
                <label
                    for="titulo"
                    class="block text-sm font-medium text-gray-900 dark:text-white mb-2 flex items-center"
                >
                    <span>Título de la Lección</span>
                    <span class="text-red-500 ml-1">*</span>
                </label>
                <div class="relative">
                    <input
                        type="text"
                        id="titulo"
                        name="titulo"
                        required
                        class="w-full px-4 py-3 pl-10 text-gray-900 dark:text-white bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                        placeholder="Ej: ¿Qué es el agua?"
                    />
                    <div
                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-gray-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            ></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Tipo de Contenido -->
            <div class="fade-in">
                <label
                    for="tipo_contenido"
                    class="block text-sm font-medium text-gray-900 dark:text-white mb-2 flex items-center"
                >
                    <span>Tipo de Contenido</span>
                    <span class="text-red-500 ml-1">*</span>
                </label>
                <div class="relative">
                    <select
                        id="tipo_contenido"
                        name="tipo_contenido"
                        required
                        class="w-full px-4 py-3 pl-10 text-gray-900 dark:text-white bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors appearance-none"
                    >
                        <option value="">Selecciona un tipo</option>
                        <option value="video">Solo Video</option>
                        <option value="texto">Solo Texto</option>
                        <option value="video-texto">Video y Texto</option>
                    </select>
                    <div
                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-gray-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                            ></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Contenido de Texto con Quill Editor -->
            <div id="texto-container" class="fade-in hidden">
                <div class="mb-2 flex items-center">
                    <label
                        class="block text-sm font-medium text-gray-900 dark:text-white flex items-center"
                    >
                        <span>Contenido de Texto</span>
                    </label>
                    <span class="ml-2 text-xs text-gray-500 dark:text-gray-400"
                        >(Opcional para tipos de contenido con video)</span
                    >
                </div>
                <div
                    class="border border-gray-300 dark:border-gray-600 rounded-lg overflow-hidden"
                >
                    <div
                        id="editor-container"
                        class="h-64 bg-white dark:bg-gray-700"
                    >
                    </div>
                </div>
                <input
                    type="hidden"
                    id="contenido_texto"
                    name="contenido_texto"
                />
            </div>

            <!-- URL del Video -->
            <div id="video-container" class="fade-in hidden">
                <label
                    for="video_url"
                    class="block text-sm font-medium text-gray-900 dark:text-white mb-2 flex items-center"
                >
                    <span>URL del Video</span>
                    <span id="video-required" class="text-red-500 ml-1 hidden"
                        >*</span
                    >
                </label>
                <div class="relative">
                    <input
                        type="url"
                        id="video_url"
                        name="video_url"
                        class="w-full px-4 py-3 pl-10 text-gray-900 dark:text-white bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                        placeholder="https://www.youtube.com/watch?v=..."
                    />
                    <div
                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-gray-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                            ></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Botones -->
            <div
                class="flex flex-col sm:flex-row justify-between gap-4 pt-6 border-t border-gray-200 dark:border-gray-700"
            >
                <div class="text-sm text-gray-500 dark:text-gray-400">
                    <p>
                        Los campos marcados con <span class="text-red-500"
                            >*</span
                        > son obligatorios
                    </p>
                </div>
                <div class="flex gap-3">
                    <a
                        href={`/admin/cursos/${cursoId}`}
                        class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-200 dark:bg-gray-600 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors"
                    >
                        Cancelar
                    </a>
                    <button
                        type="submit"
                        id="submit-btn"
                        class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-white bg-gradient-to-r from-blue-600 to-indigo-600 rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-sm"
                    >
                        Crear Lección
                    </button>
                </div>
            </div>
        </form>
    </div>

    <script is:inline>
        console.log("=== INICIANDO SCRIPT DE CREACIÓN DE LECCIÓN ===");

        // Estado global
        let quill = null;
        let cursoId = null; // 1. Inicializa como null

        // Inicialización principal
        function init() {
            console.log("🔧 Inicializando aplicación...");

            // Verificar elementos críticos
            const criticalElements = {
                form: document.getElementById("leccion-form"),
                tipoContenido: document.getElementById("tipo_contenido"),
                textoContainer: document.getElementById("texto-container"),
                videoContainer: document.getElementById("video-container"),
                videoUrl: document.getElementById("video_url"),
                contenidoTexto: document.getElementById("contenido_texto"),
                submitBtn: document.getElementById("submit-btn"),
            };

            // 2. OBTENER EL ID DESDE EL ATRIBUTO DATA-*
            cursoId = criticalElements.form.dataset.cursoId;
            if (!cursoId) {
                console.error("❌ FATAL: No se pudo encontrar el data-curso-id en el formulario.");
                return;
            }

            // Verificar que todos los elementos existan
            for (const [key, element] of Object.entries(criticalElements)) {
                if (!element) {
                    console.error(`❌ Elemento crítico faltante: ${key}`);
                    return;
                }
            }

            console.log("✅ Todos los elementos críticos encontrados");

            // Inicializar Quill
            initQuill();

            // Configurar eventos
            setupEvents(criticalElements);

            console.log("🎯 Aplicación inicializada correctamente");
        }

        // Inicializar Quill Editor
        function initQuill() {
            console.log("📝 Inicializando Quill Editor...");

            try {
                const editorContainer =
                    document.getElementById("editor-container");

                if (typeof Quill === "undefined") {
                    console.error("❌ Quill no está disponible");
                    return;
                }

                quill = new Quill(editorContainer, {
                    theme: "snow",
                    modules: {
                        toolbar: [
                            [{ header: [1, 2, 3, false] }],
                            ["bold", "italic", "underline"],
                            [{ list: "ordered" }, { list: "bullet" }],
                            ["link", "blockquote", "code-block"],
                            ["clean"],
                        ],
                    },
                    placeholder: "Escribe el contenido de la lección aquí...",
                });

                // Actualizar campo hidden cuando cambie el contenido
                quill.on("text-change", function () {
                    const contenidoInput =
                        document.getElementById("contenido_texto");
                    if (contenidoInput && quill) {
                        contenidoInput.value = quill.root.innerHTML;
                        console.log("📄 Contenido actualizado");
                    }
                });

                console.log("✅ Quill inicializado correctamente");
            } catch (error) {
                console.error("❌ Error al inicializar Quill:", error);
            }
        }

        // Configurar eventos
        function setupEvents(elements) {
            console.log("🎮 Configurando eventos...");

            // Cambio en tipo de contenido
            elements.tipoContenido.addEventListener("change", function () {
                handleTipoContenidoChange(elements);
            });

            // Submit del formulario
            elements.form.addEventListener("submit", function (e) {
                handleFormSubmit(e, elements);
            });

            console.log("✅ Eventos configurados");
        }

        console.log(cursoId);

        // Manejar cambio en tipo de contenido
        function handleTipoContenidoChange(elements) {
            const tipo = elements.tipoContenido.value;
            console.log(`🔄 Tipo de contenido cambiado a: ${tipo}`);

            // Resetear visibilidad y estado
            elements.textoContainer.classList.add("hidden");
            elements.videoContainer.classList.add("hidden");
            elements.videoUrl.required = false;
            elements.videoUrl.disabled = true; // <-- AÑADIDO: Deshabilita por defecto

            switch (tipo) {
                case "video":
                    elements.videoContainer.classList.remove("hidden");
                    elements.videoUrl.required = true;
                    elements.videoUrl.disabled = false; // <-- AÑADIDO: Habilita el campo
                    break;
                case "texto":
                    elements.textoContainer.classList.remove("hidden");
                    // El campo de video permanece deshabilitado (disabled = true)
                    break;
                case "video-texto":
                    elements.textoContainer.classList.remove("hidden");
                    elements.videoContainer.classList.remove("hidden");
                    elements.videoUrl.required = true;
                    elements.videoUrl.disabled = false; // <-- AÑADIDO: Habilita el campo
                    break;
                default:
                    // No hacer nada, el campo de video permanece deshabilitado
                    break;
            }
        }

        // Manejar envío del formulario
        async function handleFormSubmit(e, elements) {
            e.preventDefault();
            console.log("🚀 Iniciando envío del formulario...");

            // Validar formulario
            if (!validateForm(elements)) {
                return;
            }

            // Actualizar contenido del editor antes de enviar
            if (quill) {
                elements.contenidoTexto.value = quill.root.innerHTML;
            }

            // Mostrar estado de carga
            const originalText = elements.submitBtn.innerHTML;
            elements.submitBtn.innerHTML = "Creando...";
            elements.submitBtn.disabled = true;

            try {
                // Crear FormData
                const formData = new FormData(elements.form);

                // Log de datos para debug
                console.log("📤 Enviando datos:", {
                    titulo: formData.get("titulo"),
                    tipo_contenido: formData.get("tipo_contenido"),
                    modulo_id: formData.get("modulo_id"),
                    contenido_texto: formData.get("contenido_texto")
                        ? "Sí"
                        : "No",
                    video_url: formData.get("video_url"),
                });

                // Enviar a la API
                const response = await fetch(
                    "http://localhost:8000/api/lecciones",
                    {
                        method: "POST",
                        body: formData,
                        headers: {
                            Accept: "application/json",
                        },
                    },
                );

                console.log("📨 Respuesta recibida:", response.status);

                if (response.ok) {
                    const data = await response.json();
                    console.log("✅ Lección creada exitosamente:", data);

                    // Redirigir al curso
                    window.location.href = `/admin/cursos/${cursoId}`;
                } else {
                    const errorData = await response.json();
                    console.error("❌ Error del servidor:", errorData);

                    let errorMessage = "Error al crear la lección";
                    if (errorData.message) {
                        errorMessage = errorData.message;
                    } else if (errorData.errors) {
                        errorMessage = Object.values(errorData.errors)
                            .flat()
                            .join(", ");
                    }

                    alert(`❌ ${errorMessage}`);
                }
            } catch (error) {
                console.error("❌ Error de red:", error);
                alert(
                    "❌ Error de conexión. Verifica que el servidor esté funcionando.",
                );
            } finally {
                // Restaurar botón
                elements.submitBtn.innerHTML = originalText;
                elements.submitBtn.disabled = false;
            }
        }

        // Validar formulario
        function validateForm(elements) {
            const tipo = elements.tipoContenido.value;
            const titulo = document.getElementById("titulo").value.trim();
            const videoUrl = elements.videoUrl.value.trim();
            const contenidoTexto = quill ? quill.getText().trim() : "";

            console.log("🔍 Validando formulario...", {
                tipo,
                titulo,
                videoUrl,
                contenidoTexto,
            });

            // Validar título
            if (!titulo) {
                alert("❌ El título es obligatorio");
                return false;
            }

            // Validar según tipo de contenido
            if (tipo === "texto" && !contenidoTexto) {
                alert(
                    "❌ El contenido de texto es obligatorio para lecciones de tipo texto",
                );
                return false;
            }

            if ((tipo === "video" || tipo === "video-texto") && !videoUrl) {
                alert("❌ La URL del video es obligatoria");
                return false;
            }

            console.log("✅ Validación exitosa");
            return true;
        }

        // Inicializar cuando el DOM esté listo
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }

        // Backup para Astro
        document.addEventListener("astro:page-load", init);
    </script>

    <style>
        .fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hidden {
            display: none !important;
        }

        /* Estilos para Quill */
        .ql-editor {
            font-size: 16px;
            line-height: 1.6;
        }

        .dark .ql-editor {
            color: #f9fafb !important;
        }
    </style>
</CursoLayout>
