        function renderizarPreguntas() {
            preguntasContainer.innerHTML = '';
            if (preguntas.length === 0) {
                sinPreguntas.style.display = 'block';
            } else {
                sinPreguntas.style.display = 'none';
                preguntas.forEach((pregunta, index) => {
                    const preguntaHTML = crearPreguntaHTML(pregunta, index);
                    preguntasContainer.innerHTML += preguntaHTML;
                });
                setupEventosPreguntas();
            }
            actualizarContadorPreguntas();
        }

        function setupEventosPreguntas() {
            document.querySelectorAll('.editar-pregunta').forEach(btn => {
                btn.addEventListener('click', function() {
                    const preguntaId = this.getAttribute('data-pregunta-id');
                    editarPregunta(preguntaId);
                });
            });

            document.querySelectorAll('.eliminar-pregunta').forEach(btn => {
                btn.addEventListener('click', function() {
                    const preguntaId = this.getAttribute('data-pregunta-id');
                    eliminarPregunta(preguntaId);
                });
            });
        }

        function editarPregunta(preguntaId) {
            const pregunta = preguntas.find(p => p.id == preguntaId);
            if (pregunta) {
                // Llenar el formulario con los datos de la pregunta
                document.getElementById('enunciado-pregunta').value = pregunta.enunciado;
                document.getElementById('tipo-pregunta').value = pregunta.tipo;
                document.getElementById('puntos-pregunta').value = pregunta.puntos;
                
                // Limpiar opciones existentes
                opcionesContainer.innerHTML = '';
                opcionCounter = 0;
                
                // Agregar opciones
                pregunta.opciones.forEach((opcion, index) => {
                    agregarOpcion();
                    const ultimaOpcion = opcionesContainer.lastElementChild;
                    const input = ultimaOpcion.querySelector('.texto-opcion');
                    const radio = ultimaOpcion.querySelector('.respuesta-correcta');
                    
                    input.value = opcion.texto;
                    if (opcion.correcta) {
                        radio.checked = true;
                    }
                });
                
                preguntaActualId = preguntaId;
                modalPreguntaTitulo.textContent = 'Editar Pregunta';
                mostrarModalPregunta();
            }
        }

        function eliminarPregunta(preguntaId) {
            if (confirm('¿Estás seguro de que quieres eliminar esta pregunta?')) {
                preguntas = preguntas.filter(p => p.id != preguntaId);
                renderizarPreguntas();
                mostrarMensaje('Pregunta eliminada correctamente', 'success');
            }
        }

        // Función para cargar quiz existente - VERSIÓN CORREGIDA
async function cargarQuizExistente() {
    if (!CURSO_ID || isNaN(CURSO_ID)) return;

    try {
        console.log('📥 Cargando quiz existente para curso:', CURSO_ID);
        const response = await fetch(`${API_URL}/quizzes/curso/${CURSO_ID}`);
        
        if (response.ok) {
            const quizData = await response.json();
            console.log('✅ Quiz cargado:', quizData);
            
            if (quizData && quizData.preguntas && Array.isArray(quizData.preguntas)) {
                // Convertir el formato de la API al formato interno
                preguntas = quizData.preguntas.map((pregunta, index) => ({
                    id: pregunta.id || Date.now() + index,
                    enunciado: pregunta.texto_pregunta,
                    tipo: pregunta.tipo_pregunta,
                    puntos: 10, // Valor por defecto
                    opciones: pregunta.opciones ? pregunta.opciones.map(opcion => ({
                        texto: opcion.texto_opcion,
                        correcta: opcion.es_correcta
                    })) : [],
                    orden: index
                }));
                
                // Actualizar configuración si existe
                if (quizData.puntaje_minimo) {
                    document.getElementById('puntaje-minimo').value = quizData.puntaje_minimo;
                }
                if (quizData.tiempo_limite) {
                    document.getElementById('tiempo-limite').value = quizData.tiempo_limite;
                }
                
                renderizarPreguntas();
                actualizarEstadoQuiz();
            }
        } else if (response.status === 404) {
            console.log('ℹ️ No se encontró quiz existente para este curso');
        } else {
            console.error('❌ Error al cargar quiz:', response.status);
        }
    } catch (error) {
        console.error('❌ Error de conexión al cargar quiz:', error);
    }
}

