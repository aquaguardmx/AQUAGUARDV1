---
// src/pages/curso/[id]/quiz/[quizId].astro
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../../../components/aquaguard-components/FooterE-Learning.astro";

const { id: cursoId, quizId } = Astro.params;

// --- DEBUGGING SERVIDOR ---
console.log("----------------------------------------------");
console.log("🚀 INICIANDO CARGA DE QUIZ");

let quiz = null;
let error = null;

try {
    if (!quizId || quizId === "undefined" || quizId === "null") {
        throw new Error("ID de quiz inválido en la URL.");
    }

    const url = `https://aquaguardv1.onrender.com/api/quizzes/${quizId}`;
    const response = await fetch(url);

    if (!response.ok) {
        throw new Error(
            `Error API (${response.status}): ${response.statusText}`,
        );
    }

    const data = await response.json();

    if (Array.isArray(data)) {
        quiz = data[0];
    } else {
        quiz = data;
    }

    if (!quiz) throw new Error("La API no devolvió datos para este quiz.");
} catch (err: any) {
    console.error("🔥 Error:", err.message);
    error = err.message;
}
---

<script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
></script>

<Layout title={quiz ? `Examen: ${quiz.titulo}` : "Error en Examen"}>
    <Header />

    <div
        class="min-h-screen bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8"
    >
        {
            error && (
                <div class="max-w-3xl mx-auto text-center bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-lg border-l-4 border-red-500">
                    <h3 class="text-xl font-bold text-red-500 mb-2">
                        No se pudo cargar el examen
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">{error}</p>
                    <a
                        href={`/curso/${cursoId}`}
                        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition"
                    >
                        Volver al curso
                    </a>
                </div>
            )
        }

        {
            !quiz && !error && (
                <div class="flex justify-center items-center h-64">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600" />
                </div>
            )
        }

        {
            quiz && (
                <div class="max-w-4xl mx-auto">
                    <div class="mb-8 text-center">
                        <span class="text-blue-600 font-semibold tracking-wide uppercase text-sm">
                            Evaluación Final
                        </span>
                        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mt-2 mb-4">
                            {quiz.titulo}
                        </h1>
                        <p class="text-gray-600 dark:text-gray-400">
                            Curso: {quiz.curso?.titulo || "General"}
                        </p>
                    </div>

                    <div
                        id="quiz-container"
                        class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden border border-gray-100 dark:border-gray-700 relative min-h-[400px]"
                    >
                        {/* 1. PANTALLA DE INICIO */}
                        <div
                            id="start-screen"
                            class="p-8 md:p-12 text-center flex flex-col items-center justify-center h-full space-y-6"
                        >
                            <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                                <span class="text-4xl">📝</span>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-800 dark:text-white">
                                Instrucciones
                            </h2>
                            <ul class="text-left text-gray-600 dark:text-gray-300 space-y-2 max-w-md mx-auto">
                                <li class="flex items-center">
                                    <span class="mr-2 text-green-500">✓</span>{" "}
                                    Total de preguntas:{" "}
                                    {quiz.preguntas ? quiz.preguntas.length : 0}
                                </li>
                                <li class="flex items-center">
                                    <span class="mr-2 text-green-500">✓</span>{" "}
                                    Calificación mínima: 80%
                                </li>
                            </ul>
                            {quiz.preguntas && quiz.preguntas.length > 0 ? (
                                <button
                                    id="btn-start"
                                    class="mt-8 px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold rounded-xl shadow-lg hover:scale-105 transition-transform"
                                >
                                    Comenzar Examen
                                </button>
                            ) : (
                                <p class="text-red-500 mt-4">
                                    No hay preguntas disponibles.
                                </p>
                            )}
                        </div>

                        {/* 2. PANTALLA DE PREGUNTAS */}
                        <div id="question-screen" class="hidden p-8 md:p-12">
                            <div class="w-full bg-gray-200 rounded-full h-2.5 mb-8 dark:bg-gray-700">
                                <div
                                    id="progress-bar"
                                    class="bg-blue-600 h-2.5 rounded-full transition-all duration-300"
                                    style="width: 0%"
                                />
                            </div>
                            <div class="flex justify-between items-center mb-6">
                                <span
                                    id="question-counter"
                                    class="text-sm font-medium text-gray-500 dark:text-gray-400"
                                >
                                    Cargando...
                                </span>
                            </div>
                            <h3
                                id="question-text"
                                class="text-xl md:text-2xl font-bold text-gray-800 dark:text-white mb-8"
                            />
                            <div id="options-container" class="space-y-4" />
                            <div class="mt-8 flex justify-end">
                                <button
                                    id="btn-next"
                                    disabled
                                    class="px-6 py-3 bg-gray-300 text-gray-500 font-bold rounded-lg cursor-not-allowed transition-colors"
                                >
                                    Siguiente
                                </button>
                            </div>
                        </div>

                        {/* 3. PANTALLA DE RESULTADOS */}
                        <div
                            id="result-screen"
                            class="hidden p-8 md:p-12 text-center"
                        >
                            <div
                                id="score-icon"
                                class="w-24 h-24 mx-auto rounded-full flex items-center justify-center text-5xl mb-6 shadow-lg"
                            />
                            <h2
                                id="result-title"
                                class="text-3xl font-bold mb-2 text-gray-900 dark:text-white"
                            />
                            <p
                                id="result-message"
                                class="text-gray-600 dark:text-gray-300 mb-8 text-lg"
                            />

                            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-6 mb-8 max-w-sm mx-auto">
                                <p class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">
                                    Tu calificación
                                </p>
                                <p
                                    id="final-score"
                                    class="text-5xl font-extrabold text-blue-600 dark:text-blue-400"
                                >
                                    0%
                                </p>
                                <p
                                    id="correct-count"
                                    class="text-sm text-gray-500 mt-2"
                                />
                            </div>

                            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                                <button
                                    onclick="window.location.reload()"
                                    class="px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition"
                                >
                                    Intentar de nuevo
                                </button>

                                <a
                                    href={`/curso/${cursoId}`}
                                    class="px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-semibold shadow-md transition"
                                >
                                    Volver al Curso
                                </a>

                                {/* BOTÓN DE CERTIFICADO (Oculto por defecto) */}
                                <button
                                    id="btn-download-cert"
                                    class="hidden px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-bold shadow-lg transition flex items-center gap-2 transform hover:scale-105"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                    Descargar Certificado
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            )
        }
    </div>
    <Footer />
</Layout>

<script define:vars={{ quizData: quiz, cursoId }}>
    if (!quizData || !quizData.preguntas || quizData.preguntas.length === 0) {
        console.warn("⚠️ No hay preguntas disponibles.");
    } else {
        const questions = quizData.preguntas;
        let currentQuestionIndex = 0;
        let score = 0;
        let selectedOptionIndex = null;
        const passingScore = 80;

        const ui = {
            start: document.getElementById("start-screen"),
            question: document.getElementById("question-screen"),
            result: document.getElementById("result-screen"),
            progressBar: document.getElementById("progress-bar"),
            counter: document.getElementById("question-counter"),
            questionText: document.getElementById("question-text"),
            optionsContainer: document.getElementById("options-container"),
            btnNext: document.getElementById("btn-next"),
            btnStart: document.getElementById("btn-start"),
            btnCert: document.getElementById("btn-download-cert"), // Referencia al nuevo botón
        };

        if (ui.btnStart) {
            ui.btnStart.addEventListener("click", () => {
                ui.start.classList.add("hidden");
                ui.question.classList.remove("hidden");
                loadQuestion();
            });
        }

        ui.btnNext.addEventListener("click", () => {
            checkAnswer();
            currentQuestionIndex++;
            if (currentQuestionIndex < questions.length) {
                loadQuestion();
            } else {
                showResults();
            }
        });

        // Evento para generar el PDF
        if (ui.btnCert) {
            ui.btnCert.addEventListener("click", generarCertificado);
        }

        function loadQuestion() {
            const question = questions[currentQuestionIndex];
            selectedOptionIndex = null;
            ui.btnNext.disabled = true;
            ui.btnNext.className =
                "px-6 py-3 bg-gray-300 text-gray-500 font-bold rounded-lg cursor-not-allowed transition-colors";
            ui.btnNext.textContent =
                currentQuestionIndex === questions.length - 1
                    ? "Finalizar Examen"
                    : "Siguiente";
            ui.questionText.textContent = question.texto_pregunta;
            ui.counter.textContent = `Pregunta ${currentQuestionIndex + 1} de ${questions.length}`;
            ui.progressBar.style.width = `${(currentQuestionIndex / questions.length) * 100}%`;
            ui.optionsContainer.innerHTML = "";

            if (question.opciones) {
                question.opciones.forEach((opcion, index) => {
                    const button = document.createElement("button");
                    button.className = `w-full text-left p-4 rounded-xl border-2 transition-all duration-200 flex justify-between items-center group border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20`;
                    button.innerHTML = `<span class="font-medium text-gray-700 dark:text-gray-200">${opcion.texto_opcion}</span><div class="w-6 h-6 rounded-full border-2 border-gray-300 group-hover:border-blue-500 flex items-center justify-center"><div class="w-3 h-3 rounded-full bg-blue-500 opacity-0 transform scale-0 transition-all select-indicator"></div></div>`;
                    button.onclick = () => selectOption(index, button);
                    ui.optionsContainer.appendChild(button);
                });
            }
        }

        function selectOption(index, buttonElement) {
            selectedOptionIndex = index;
            Array.from(ui.optionsContainer.children).forEach((btn) => {
                btn.className = `w-full text-left p-4 rounded-xl border-2 transition-all duration-200 flex justify-between items-center group border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20`;
                const indicator = btn.querySelector(".select-indicator");
                if (indicator) indicator.classList.add("opacity-0", "scale-0");
            });
            buttonElement.className = `w-full text-left p-4 rounded-xl border-2 transition-all duration-200 flex justify-between items-center group border-blue-600 bg-blue-50 dark:border-blue-500 dark:bg-blue-900/30`;
            const activeIndicator =
                buttonElement.querySelector(".select-indicator");
            if (activeIndicator)
                activeIndicator.classList.remove("opacity-0", "scale-0");
            ui.btnNext.disabled = false;
            ui.btnNext.className =
                "px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg cursor-pointer transition-colors";
        }

        function checkAnswer() {
            const question = questions[currentQuestionIndex];
            const selectedOption = question.opciones[selectedOptionIndex];
            if (
                selectedOption &&
                (selectedOption.es_correcta == 1 ||
                    selectedOption.es_correcta === true)
            ) {
                score++;
            }
        }

        function showResults() {
            ui.question.classList.add("hidden");
            ui.result.classList.remove("hidden");
            const percentage = Math.round((score / questions.length) * 100);
            const isPassed = percentage >= passingScore;

            const title = document.getElementById("result-title");
            const message = document.getElementById("result-message");
            const iconContainer = document.getElementById("score-icon");
            document.getElementById("final-score").textContent =
                `${percentage}%`;
            document.getElementById("correct-count").textContent =
                `${score} de ${questions.length} correctas`;

            if (isPassed) {
                title.textContent = "¡Felicidades! 🎉";
                title.className =
                    "text-3xl font-bold mb-2 text-green-600 dark:text-green-400";
                message.textContent =
                    "Has aprobado el examen satisfactoriamente.";
                iconContainer.innerHTML = "🏆";
                iconContainer.className =
                    "w-24 h-24 mx-auto rounded-full flex items-center justify-center text-5xl mb-6 shadow-lg bg-green-100 text-green-600 border-4 border-green-200";

                // MOSTRAR BOTÓN DE CERTIFICADO SI APROBÓ
                if (ui.btnCert) ui.btnCert.classList.remove("hidden");
            } else {
                title.textContent = "Sigue intentando";
                title.className =
                    "text-3xl font-bold mb-2 text-orange-600 dark:text-orange-400";
                message.textContent =
                    "No has alcanzado el puntaje mínimo para aprobar.";
                iconContainer.innerHTML = "📚";
                iconContainer.className =
                    "w-24 h-24 mx-auto rounded-full flex items-center justify-center text-5xl mb-6 shadow-lg bg-orange-100 text-orange-600 border-4 border-orange-200";
            }
        }

        // --- FUNCIÓN PARA GENERAR EL PDF ---
        function generarCertificado() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({
                orientation: "landscape",
                unit: "mm",
                format: "a4",
            });

            // Colores
            const bluePrimary = "#2563EB"; // Azul Tailwind
            const darkText = "#1F2937";

            // Marco del certificado
            doc.setLineWidth(3);
            doc.setDrawColor(37, 99, 235); // Azul
            doc.rect(10, 10, 277, 190); // Margen externo

            doc.setLineWidth(1);
            doc.rect(15, 15, 267, 180); // Margen interno

            // Título
            doc.setFont("helvetica", "bold");
            doc.setTextColor(bluePrimary);
            doc.setFontSize(40);
            doc.text("CERTIFICADO", 148.5, 50, { align: "center" });

            doc.setFontSize(20);
            doc.setTextColor(darkText);
            doc.text("DE FINALIZACIÓN", 148.5, 60, { align: "center" });

            // Cuerpo
            doc.setFont("helvetica", "normal");
            doc.setFontSize(16);
            doc.setTextColor("#4B5563"); // Gris
            doc.text("Este documento certifica que", 148.5, 85, {
                align: "center",
            });

            // Nombre del Estudiante (Puedes hacerlo dinámico si tienes el nombre del usuario)
            doc.setFont("times", "italic");
            doc.setFontSize(30);
            doc.setTextColor(darkText);
            doc.text("Estudiante de AquaLearn", 148.5, 105, {
                align: "center",
            });

            doc.setDrawColor(37, 99, 235);
            doc.line(70, 108, 227, 108); // Línea debajo del nombre

            // Texto intermedio
            doc.setFont("helvetica", "normal");
            doc.setFontSize(16);
            doc.setTextColor("#4B5563");
            doc.text("ha completado satisfactoriamente el curso:", 148.5, 125, {
                align: "center",
            });

            // Nombre del Curso
            const courseTitle = quizData.curso
                ? quizData.curso.titulo
                : quizData.titulo;
            doc.setFont("helvetica", "bold");
            doc.setFontSize(24);
            doc.setTextColor(bluePrimary);
            doc.text(courseTitle, 148.5, 140, { align: "center" });

            // Fecha
            const date = new Date().toLocaleDateString("es-ES", {
                year: "numeric",
                month: "long",
                day: "numeric",
            });
            doc.setFont("helvetica", "normal");
            doc.setFontSize(14);
            doc.setTextColor(darkText);
            doc.text(`Fecha: ${date}`, 148.5, 165, { align: "center" });

            // Firma (Simulada)
            doc.setFontSize(12);
            doc.text("__________________________", 230, 175, {
                align: "center",
            });
            doc.text("Equipo AquaGuard", 230, 182, { align: "center" });

            // Logo simple (Texto)
            doc.setFontSize(18);
            doc.setTextColor(bluePrimary);
            doc.setFont("helvetica", "bold");
            doc.text("AquaLearn", 40, 180, { align: "center" });

            // Guardar
            doc.save(`Certificado-${courseTitle.replace(/\s+/g, "_")}.pdf`);
        }
    }
</script>
