---
// src/components/aquaguard-components/ContenidoLeccion.astro

const { leccion, leccionAnterior, leccionSiguiente, cursoId } = Astro.props;

// Normalizar el tipo de contenido
const tipoContenido = leccion.tipo === "texto" ? "lectura" : leccion.tipo;
---

<div
    class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden"
>
    <div class="p-8">
        {
            tipoContenido === "video" && (
                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-12 h-12 bg-red-100 dark:bg-red-900/20 rounded-xl flex items-center justify-center">
                            <svg
                                class="w-6 h-6 text-red-600 dark:text-red-400"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                                    clip-rule="evenodd"
                                />
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-gray-900 dark:text-white">
                                Video: {leccion.titulo}
                            </h2>
                            <p class="text-gray-600 dark:text-gray-400">
                                Duración: {leccion.duracion_min} minutos
                            </p>
                        </div>
                    </div>

                    <div class="video-container bg-black rounded-2xl shadow-2xl mb-6">
                        <video
                            controls
                            src={leccion.url_contenido}
                            class="rounded-2xl w-full h-full"
                        >
                            Tu navegador no soporta el tag de video.
                        </video>
                    </div>

                    <div class="flex justify-between items-center px-2">
                        <button class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors px-4 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 19l-7-7 7-7"
                                />
                            </svg>
                            Retroceder 10s
                        </button>

                        <div class="flex items-center gap-2">
                            <button class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors px-4 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z"
                                        clip-rule="evenodd"
                                    />
                                </svg>
                                Velocidad
                            </button>

                            <button class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors px-4 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"
                                    />
                                </svg>
                                Pantalla completa
                            </button>
                        </div>

                        <button class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors px-4 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
                            Avanzar 10s
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"
                                />
                            </svg>
                        </button>
                    </div>
                </div>
            )
        }

        {
            tipoContenido === "lectura" && leccion.contenido_texto && (
                <div class="contenido-texto">
                    <div class="bg-gray-50 dark:bg-gray-900/30 rounded-2xl p-8 border border-gray-200 dark:border-gray-700">
                        <div set:html={leccion.contenido_texto} />
                    </div>
                </div>
            )
        }

        {
            tipoContenido === "lectura" && !leccion.contenido_texto && (
                <div class="bg-gray-50 dark:bg-gray-900/30 rounded-2xl p-8 border border-gray-200 dark:border-gray-700">
                    <div class="text-center py-12">
                        <svg
                            class="w-16 h-16 text-gray-400 mx-auto mb-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            />
                        </svg>
                        <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">
                            Contenido de Lectura
                        </h3>
                        <p class="text-gray-600 dark:text-gray-400">
                            Esta lección contiene material de lectura que puedes
                            revisar a tu propio ritmo.
                        </p>
                    </div>
                </div>
            )
        }
    </div>

    <div
        class="border-t border-gray-200 dark:border-gray-700 p-8 bg-gray-50 dark:bg-gray-900/30"
    >
        <div
            class="flex flex-col sm:flex-row justify-between items-center gap-6"
        >
            <div class="flex-1">
                {
                    leccionAnterior ? (
                        <a
                            href={`/curso/${cursoId}/leccion/${leccionAnterior.id_leccion}`}
                            class="group flex items-center gap-4 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors p-4 rounded-xl hover:bg-white dark:hover:bg-gray-800 border border-transparent hover:border-gray-200 dark:hover:border-gray-600"
                        >
                            <svg
                                class="w-6 h-6 transform group-hover:-translate-x-1 transition-transform"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 19l-7-7 7-7"
                                />
                            </svg>
                            <div class="text-left">
                                <div class="text-sm text-gray-500 dark:text-gray-500 mb-1">
                                    Lección anterior
                                </div>
                                <div class="font-semibold text-gray-900 dark:text-white">
                                    {leccionAnterior.titulo}
                                </div>
                            </div>
                        </a>
                    ) : (
                        <div class="p-4 opacity-50">
                            <div class="text-sm text-gray-500 mb-1">
                                Lección anterior
                            </div>
                            <div class="font-semibold text-gray-900 dark:text-white">
                                Inicio del curso
                            </div>
                        </div>
                    )
                }
            </div>

            <div class="flex items-center gap-4">
                <button
                    class="bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-8 rounded-xl transition-all transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-3"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"
                        />
                    </svg>
                    Marcar como Completado
                </button>
            </div>

            <div class="flex-1 flex justify-end">
                {
                    leccionSiguiente ? (
                        <a
                            href={`/curso/${cursoId}/leccion/${leccionSiguiente.id_leccion}`}
                            class="group flex items-center gap-4 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors p-4 rounded-xl hover:bg-white dark:hover:bg-gray-800 border border-transparent hover:border-gray-200 dark:hover:border-gray-600 text-right"
                        >
                            <div>
                                <div class="text-sm text-gray-500 dark:text-gray-500 mb-1">
                                    Siguiente lección
                                </div>
                                <div class="font-semibold text-gray-900 dark:text-white">
                                    {leccionSiguiente.titulo}
                                </div>
                            </div>
                            <svg
                                class="w-6 h-6 transform group-hover:translate-x-1 transition-transform"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"
                                />
                            </svg>
                        </a>
                    ) : (
                        <div class="p-4 opacity-50 text-right">
                            <div class="text-sm text-gray-500 mb-1">
                                Siguiente lección
                            </div>
                            <div class="font-semibold text-gray-900 dark:text-white">
                                Quiz Final
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</div>

<style>
    .video-container {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 aspect ratio */
        height: 0;
        overflow: hidden;
        border-radius: 16px;
    }
    
    .video-container iframe,
    .video-container video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 16px;
    }

    /* Estilos para el contenido de texto */
    .contenido-texto {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        line-height: 1.7;
        letter-spacing: -0.01em;
    }
    
    .contenido-texto h1,
    .contenido-texto h2,
    .contenido-texto h3,
    .contenido-texto h4,
    .contenido-texto h5,
    .contenido-texto h6 {
        margin: 2rem 0 1rem 0;
        font-weight: 700;
        color: #111827;
    }
    
    .contenido-texto h1 {
        font-size: 2rem;
        border-bottom: 3px solid #3b82f6;
        padding-bottom: 0.5rem;
    }
    
    .contenido-texto h2 {
        font-size: 1.75rem;
        border-bottom: 2px solid #e5e7eb;
        padding-bottom: 0.5rem;
    }
    
    .contenido-texto h3 {
        font-size: 1.5rem;
    }
    
    .contenido-texto h4 {
        font-size: 1.25rem;
    }
    
    .contenido-texto h5 {
        font-size: 1.125rem;
    }
    
    .contenido-texto h6 {
        font-size: 1rem;
        color: #6b7280;
    }
    
    .contenido-texto p {
        margin-bottom: 1.25rem;
        line-height: 1.7;
        color: #4b5563;
    }
    
    .contenido-texto ul,
    .contenido-texto ol {
        margin: 1.25rem 0;
        padding-left: 1.5rem;
    }
    
    .contenido-texto li {
        margin-bottom: 0.75rem;
        line-height: 1.6;
        color: #4b5563;
        position: relative;
    }
    
    .contenido-texto ul li::before {
        content: "•";
        color: #3b82f6;
        font-weight: bold;
        display: inline-block;
        width: 1em;
        margin-left: -1em;
    }
    
    .contenido-texto ol {
        list-style-type: decimal;
    }
    
    .contenido-texto ol li::marker {
        color: #3b82f6;
        font-weight: bold;
    }
    
    .contenido-texto strong {
        color: #1e40af;
        font-weight: 600;
    }
    
    .contenido-texto em {
        color: #7c3aed;
        font-style: italic;
    }
    
    .contenido-texto blockquote {
        border-left: 4px solid #3b82f6;
        padding-left: 1.5rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: #6b7280;
        background-color: #f9fafb;
        padding: 1.5rem;
        border-radius: 0.5rem;
    }
    
    .contenido-texto code {
        background-color: #f3f4f6;
        color: #dc2626;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-family: 'Monaco', 'Consolas', monospace;
        font-size: 0.875rem;
    }
    
    .contenido-texto pre {
        background-color: #1f2937;
        color: #f9fafb;
        padding: 1.5rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
    }
    
    .contenido-texto pre code {
        background-color: transparent;
        color: inherit;
        padding: 0;
    }
    
    .contenido-texto a {
        color: #3b82f6;
        text-decoration: underline;
        transition: color 0.2s;
    }
    
    .contenido-texto a:hover {
        color: #1d4ed8;
    }
    
    /* Modo oscuro */
    .dark .contenido-texto {
        color: #d1d5db;
    }
    
    .dark .contenido-texto h1,
    .dark .contenido-texto h2,
    .dark .contenido-texto h3,
    .dark .contenido-texto h4,
    .dark .contenido-texto h5,
    .dark .contenido-texto h6 {
        color: #f9fafb;
    }
    
    .dark .contenido-texto h2 {
        border-bottom-color: #374151;
    }
    
    .dark .contenido-texto p {
        color: #d1d5db;
    }
    
    .dark .contenido-texto li {
        color: #d1d5db;
    }
    
    .dark .contenido-texto ul li::before {
        color: #60a5fa;
    }
    
    .dark .contenido-texto strong {
        color: #93c5fd;
    }
    
    .dark .contenido-texto em {
        color: #c4b5fd;
    }
    
    .dark .contenido-texto blockquote {
        background-color: #374151;
        color: #e5e7eb;
        border-left-color: #60a5fa;
    }
    
    .dark .contenido-texto code {
        background-color: #374151;
        color: #fca5a5;
    }
    
    .dark .contenido-texto pre {
        background-color: #111827;
    }
    
    .dark .contenido-texto a {
        color: #60a5fa;
    }
    
    .dark .contenido-texto a:hover {
        color: #93c5fd;
    }
    
    /* Responsive */
    @media (max-width: 1024px) {
        .contenido-texto h1 {
            font-size: 1.75rem;
        }
        
        .contenido-texto h2 {
            font-size: 1.5rem;
        }
        
        .contenido-texto h3 {
            font-size: 1.375rem;
        }
        
        .contenido-texto h4 {
            font-size: 1.125rem;
        }
    }
</style>