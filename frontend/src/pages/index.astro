---
import "../styles/estilos.css";
import Header from "../components/aquaguard-components/Header.astro";
import Footer from "../components/aquaguard-components/Footer.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>AquaGuard - Monitoreo de Calidad del Agua</title>
		<!--Font Awesome 6-->
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Catamaran:wght@300;400;500;600;700&family=Hind:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="wrapper">
			<Header />

			<section class="hero_section">
				<div class="wrapper_inner">
					<div class="hero_content">
						<h5>BIENVENIDO A AQUAGUARD</h5>
						<h1>
							Explora la calidad del agua en cuerpos superficiales
						</h1>
						<p>
							Descubre el estado de ríos, lagos y presas en
							México. Consulta datos oficiales, aprende sobre
							parametros de calidad y conoce recomendaciones para
							proteger el agua.
						</p>
					</div>
				</div>
			</section>

			<Footer />
		</div>

		<script>
			document.addEventListener("DOMContentLoaded", function () {
				const menuToggle = document.querySelector(
					".mobile_menu_button",
				);
				const mainMenu = document.querySelector(".main_menu");
				if (menuToggle && mainMenu) {
					menuToggle.addEventListener("click", function () {
						mainMenu.classList.toggle("open");
					});
				}

				const header = document.querySelector("header");
				function updateHeaderTransparency() {
					if (!header) return;
					if (window.scrollY <= 10) {
						header.classList.add("transparent");
					} else {
						header.classList.remove("transparent");
					}
				}
				window.addEventListener("scroll", updateHeaderTransparency);
				updateHeaderTransparency(); // Ejecuta al cargar la página
			});
		</script>
	</body>
</html>
