<script is:inline>
  // Funcionalidad del modal para abandonar curso
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('abandonarCursoModal');
    const modalContent = document.getElementById('modalContent');
    const cursoNombre = document.getElementById('cursoNombre');
    const cancelarBtn = document.getElementById('cancelarAbandonar');
    const confirmarBtn = document.getElementById('confirmarAbandonar');
    
    let cursoActualId = null;
    let cursoActualTitulo = null;

    // Abrir modal cuando se hace clic en los tres puntos
    document.querySelectorAll('.curso-options-trigger').forEach(button => {
      button.addEventListener('click', function(e) {
        e.stopPropagation();
        cursoActualId = this.getAttribute('data-curso-id');
        cursoActualTitulo = this.getAttribute('data-curso-titulo');
        
        cursoNombre.textContent = cursoActualTitulo;
        
        // Mostrar modal con animación
        modal.classList.remove('hidden');
        setTimeout(() => {
          modalContent.classList.remove('scale-95', 'opacity-0');
          modalContent.classList.add('scale-100', 'opacity-100');
        }, 50);
      });
    });

    // Cerrar modal al hacer clic en cancelar
    cancelarBtn.addEventListener('click', cerrarModal);

    // Cerrar modal al hacer clic fuera del contenido
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        cerrarModal();
      }
    });

    // Confirmar abandono del curso
    confirmarBtn.addEventListener('click', function() {
      if (cursoActualId) {
        // Aquí iría la lógica para abandonar el curso
        console.log(`Abandonando curso ID: ${cursoActualId} - ${cursoActualTitulo}`);
        
        // Simular abandono del curso (en una aplicación real, aquí harías una petición al servidor)
        alert(`Has abandonado el curso: ${cursoActualTitulo}`);
        
        // Recargar la página para reflejar los cambios
        setTimeout(() => {
          window.location.reload();
        }, 1000);
        
        cerrarModal();
      }
    });

    // Cerrar modal con tecla Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        cerrarModal();
      }
    });

    function cerrarModal() {
      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      
      setTimeout(() => {
        modal.classList.add('hidden');
        cursoActualId = null;
        cursoActualTitulo = null;
      }, 300);
    }
  });
</script>
