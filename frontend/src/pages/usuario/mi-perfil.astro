---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";

// Removí lógica localStorage de frontmatter (es client-only). Usar placeholders por default.
let user = { nombre: '', ap_paterno: '', ap_materno: '', correo_electronico: '', id_rol: 2, id_usuario: null, pais: 'México', idioma_preferido: 'Español' }; // Placeholder para SSR

// Función para obtener el nombre del rol
function getRoleName(idRol: number): string {
  const roles: { [key: number]: string } = {
    1: "Administrador",
    2: "Usuario",
    3: "Docente",
  };
  return roles[idRol] || "Usuario";
}

// Helper functions para manejar datos del usuario de forma segura (usar en SSR)
function getUserNombre() {
  return user.nombre || user.name || "";
}

function getUserApPaterno() {
  return user.ap_paterno || "";
}

function getUserApMaterno() {
  return user.ap_materno || "";
}

function getUserEmail() {
  return user.correo_electronico || user.email || "Correo no disponible";
}

function getUserInitial() {
  const nombre = getUserNombre();
  return nombre ? nombre.charAt(0).toUpperCase() : "U";
}

function getUserFullName() {
  const nombre = getUserNombre();
  const apPaterno = getUserApPaterno();
  const apMaterno = getUserApMaterno();
  return `${nombre} ${apPaterno} ${apMaterno}`.trim() || "Usuario";
}
---

<Layout title="Mi Perfil">
    <!-- Header -->
    <Header />

    <!-- Breadcrumb -->
    <nav class="bg-gradient-to-r from-blue-50 to-indigo-50 py-4 border-b border-blue-100">
        <div class="container mx-auto px-4">
            <div class="flex items-center space-x-2 text-sm">
                <a href="/usuario/index-elearning" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 font-medium">Inicio</a>
                <span class="text-blue-300"><i class="fas fa-chevron-right text-xs"></i></span>
                <a href="/usuario/mis-cursos" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 font-medium">Mi Cuenta</a>
                <span class="text-blue-300"><i class="fas fa-chevron-right text-xs"></i></span>
                <span class="text-blue-800 font-semibold">Mi Perfil</span>
            </div>
        </div>
    </nav>

    <!-- Enhanced Profile Hero Section -->
    <section id="heroSection" class="relative bg-gradient-to-br from-blue-600 via-purple-600 to-indigo-700 text-white py-16 overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10">
            <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,<svg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><circle fill=\"%23FFFFFF\" cx=\"30\" cy=\"30\" r=\"1\"/></g></svg>')"></div>
        </div>
        
        <div class="container mx-auto px-4 relative z-10">
