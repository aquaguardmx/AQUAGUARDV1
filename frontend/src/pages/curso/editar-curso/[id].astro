        // ENVIAR FORMULARIO DE LECCIÓN - VERSIÓN CORREGIDA PARA CONTENIDO MIXTO
        formLeccion.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const titulo = tituloLeccionInput.value.trim();
            const tipoContenido = tipoContenidoSelect.value;
            const contenidoTexto = editorTexto.innerHTML;
            const videoUrl = videoUrlInput.value.trim();

            if (!titulo) {
                mostrarMensaje('Por favor ingresa un título para la lección', 'error');
                return;
            }

            // VALIDACIÓN CORREGIDA PARA CONTENIDO MIXTO
            if (tipoContenido === 'video' && !videoUrl) {
                mostrarMensaje('Para contenido de video, ingresa una URL', 'error');
                return;
            }

            if (tipoContenido === 'texto' && (!contenidoTexto || contenidoTexto === '<p>Escribe el contenido de tu lección aquí...</p>')) {
                mostrarMensaje('Para contenido de texto, ingresa el contenido', 'error');
                return;
            }

            if (tipoContenido === 'mixto') {
                if (!videoUrl) {
                    mostrarMensaje('Para contenido mixto, ingresa una URL de video', 'error');
                    return;
                }
                if (!contenidoTexto || contenidoTexto === '<p>Escribe el contenido de tu lección aquí...</p>') {
                    mostrarMensaje('Para contenido mixto, ingresa el contenido de texto', 'error');
                    return;
                }
            }

            // Validar URL de YouTube si se proporciona
            if (videoUrl && !extractVideoId(videoUrl)) {
                mostrarMensaje('Por favor ingresa una URL válida de YouTube', 'error');
                return;
            }

            const modulo = document.querySelector(`.modulo-item[data-modulo-id="${moduloActualId}"]`);
            const leccionesCount = modulo ? modulo.querySelectorAll('.leccion-item').length : 0;
            const nuevoOrden = leccionesCount + 1;

            try {
                mostrarMensaje('Creando nueva lección...', 'success');
                
                // PREPARAR DATOS CORRECTAMENTE
                const datosLeccion = {
                    modulo_id: moduloActualId,
                    titulo: titulo,
                    tipo_contenido: tipoContenido,
                    orden: nuevoOrden
                };

                // Agregar campos según el tipo de contenido
                if (tipoContenido === 'texto' || tipoContenido === 'mixto') {
                    // Limpiar el contenido HTML antes de enviar
                    const contenidoLimpio = limpiarContenidoHTML(contenidoTexto);
                    datosLeccion.contenido_texto = contenidoLimpio;
                } else {
                    datosLeccion.contenido_texto = null;
                }

                if (tipoContenido === 'video' || tipoContenido === 'mixto') {
                    datosLeccion.video_url = videoUrl;
                } else {
                    datosLeccion.video_url = null;
                }

                console.log('📡 Enviando lección:', datosLeccion);

                const response = await fetch(`${API_URL}/lecciones`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(datosLeccion)
                });

                // Manejo mejorado de errores
                if (!response.ok) {
                    let errorMessage = `Error ${response.status}`;
                    try {
                        const errorData = await response.json();
                        console.error('❌ Error del servidor:', errorData);
                        errorMessage = errorData.message || errorData.error || errorMessage;
                        
                        // Mostrar errores específicos de validación
                        if (errorData.errors) {
                            const errores = Object.values(errorData.errors).flat();
                            errorMessage = errores.join(', ');
                        }
                    } catch (e) {
                        const errorText = await response.text();
                        errorMessage = errorText || errorMessage;
                    }
                    throw new Error(errorMessage);
                }

                const data = await response.json();
                console.log('✅ Lección creada exitosamente:', data);
                
                ocultarModal(modalLeccion, modalLeccionContent);
                mostrarMensaje('Lección creada correctamente. Recargando...', 'success');
                setTimeout(() => window.location.reload(), 1500);
                
            } catch (error) {
                console.error('❌ Error completo al crear lección:', error);
                mostrarMensaje('Error al crear la lección: ' + error.message, 'error');
            }
        });

