    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <script>
      // Inicializar Quill Editor para la descripción
      const descriptionEditor = new Quill("#description-editor", {
        theme: "snow",
        modules: {
          toolbar: [
            [{ header: [1, 2, 3, 4, 5, 6, false] }],
            ["bold", "italic", "underline", "strike"],
            [{ color: [] }, { background: [] }],
            [{ list: "ordered" }, { list: "bullet" }],
            [{ indent: "-1" }, { indent: "+1" }],
            ["link", "image", "video"],
            ["clean"],
          ],
        },
        placeholder: "Escribe aquí la descripción de la lección...",
      });

      // Inicializar Quill Editor para contenido de texto
      const textEditor = new Quill("#text-editor", {
        theme: "snow",
        modules: {
          toolbar: [
            [{ header: [1, 2, 3, 4, 5, 6, false] }],
            ["bold", "italic", "underline", "strike"],
            [{ color: [] }, { background: [] }],
            [{ list: "ordered" }, { list: "bullet" }],
            [{ indent: "-1" }, { indent: "+1" }],
            ["link", "image", "video"],
            ["clean"],
          ],
        },
        placeholder: "Escribe aquí el contenido de texto de la lección...",
      });

      // Establecer contenido inicial para los editores
      descriptionEditor.root.innerHTML = `¡Bienvenido al primer módulo! En esta lección, exploraremos los dos motores principales del ciclo del agua: la evaporación y la condensación.

<p>La <strong>evaporación</strong> es el proceso por el cual el agua líquida de la superficie (como océanos, ríos y lagos) se convierte en vapor de agua (un gas) debido al calor del sol.</p>

<p>La <strong>condensación</strong> es el proceso opuesto. Ocurre cuando el vapor de agua en el aire se enfría y se transforma nuevamente en líquido, formando las nubes.</p>

<h4>Puntos Clave:</h4>
<ul>
  <li>El sol es la fuente de energía principal.</li>
  <li>La evaporación "limpia" el agua, dejando atrás sales y minerales.</li>
  <li>Las nubes son colecciones de millones de diminutas gotas de agua.</li>
</ul>`;

      // Manejar cambio de tipo de contenido
      document
        .getElementById("content_type")
        .addEventListener("change", function () {
          const videoContent = document.getElementById("video-content");
          const textContent = document.getElementById("text-content");

          if (this.value === "video") {
            videoContent.classList.remove("hidden");
            textContent.classList.add("hidden");
          } else {
            videoContent.classList.add("hidden");
            textContent.classList.remove("hidden");
          }
        });

      // Manejar envío del formulario
      document
        .getElementById("lesson-form")
        .addEventListener("submit", function (e) {
          // Guardar contenido de los editores en campos ocultos
          document.getElementById("lesson_description").value =
            descriptionEditor.root.innerHTML;
          document.getElementById("text_content").value =
            textEditor.root.innerHTML;
        });

      // Manejar eliminación de lección
      document
        .getElementById("delete-lesson-btn")
        .addEventListener("click", function () {
          if (
            confirm(
              "¿Estás seguro de que deseas eliminar esta lección? Esta acción no se puede deshacer.",
            )
          ) {
            // Aquí iría la lógica para eliminar la lección
            alert("Lección eliminada (simulación)");
          }
        });

      // Manejar adición de recursos
      let resourceCounter = 2;
      document
        .getElementById("add-resource-btn")
        .addEventListener("click", function () {
          resourceCounter++;
          const resourceContainer =
            document.getElementById("resource-container");
          const newResource = document.createElement("div");
          newResource.className =
            "p-4 border rounded-lg dark:border-gray-700 resource-item";
          newResource.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="resource_title_${resourceCounter}" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Título del Recurso</label>
            <input type="text" id="resource_title_${resourceCounter}" name="resource_title[]" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" placeholder="Título del recurso">
          </div>
          <div>
            <label for="resource_url_${resourceCounter}" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Enlace o Archivo</label>
            <div class="flex gap-2">
              <input type="text" id="resource_url_${resourceCounter}" name="resource_url[]" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" placeholder="URL o nombre de archivo">
              <input class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400" name="resource_file[]" type="file">
            </div>
          </div>
        </div>
        <button type="button" class="mt-2 text-red-600 hover:text-red-800 remove-resource-btn inline-flex items-center text-sm">
          <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
          Eliminar recurso
        </button>
      `;
          resourceContainer.appendChild(newResource);

          // Agregar evento al nuevo botón de eliminar
          newResource
            .querySelector(".remove-resource-btn")
            .addEventListener("click", function () {
              if (
                confirm("¿Estás seguro de que deseas eliminar este recurso?")
              ) {
                newResource.remove();
              }
            });
        });

      // Agregar eventos a los botones de eliminar recursos existentes
      document.querySelectorAll(".remove-resource-btn").forEach((button) => {
        button.addEventListener("click", function () {
          if (confirm("¿Estás seguro de que deseas eliminar este recurso?")) {
            this.closest(".resource-item").remove();
          }
        });
      });
    </script>

    <script>
      /**
       * Esta función crea el HTML para un nuevo elemento de acordeón de módulo.
       * Recibe el objeto 'module' que tu API de Laravel devuelve.
       */
      function createModuleAccordionHTML(module) {
        // 'module' es el objeto JSON que devuelve Laravel
        // (ej: { id: 123, name: "Nuevo Módulo", lessons: [] })

        const moduleId = module.id;
        const moduleName = module.name;

        // El nuevo módulo se añade cerrado por defecto (aria-expanded="false" y class="hidden")
        return `
      <h2 id="accordion-heading-${moduleId}">
        <button
          type="button"
          class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-600 border border-gray-200 focus:ring-4 focus:ring-blue-200 dark:focus:ring-blue-800 dark:border-gray-700 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-gray-800 gap-3"
          data-accordion-target="#accordion-body-${moduleId}"
          aria-expanded="false"
          aria-controls="accordion-body-${moduleId}"
        >
          <span class="flex-1 text-left">${moduleName}</span>
          <a
            href="/admin/modulos/${moduleId}/editar"
            class="text-gray-500 hover:text-blue-600 p-1"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z"></path>
              <path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd"></path>
            </svg>
            <span class="sr-only">Editar ${moduleName}</span>
          </a>
          <svg
            data-accordion-icon
            class="w-3 h-3 shrink-0"
            aria-hidden="true"
            fill="none"
            viewBox="0 0 10 6"
          >
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5"></path>
          </svg>
        </button>
      </h2>
      <div
        id="accordion-body-${moduleId}"
        class="hidden"
        aria-labelledby="accordion-heading-${moduleId}"
      >
        <div class="p-5 border border-b-0 border-gray-200 dark:border-gray-700">
          <p class="mb-4 text-gray-500 dark:text-gray-400">Este módulo aún no tiene lecciones.</p>
          <a
            href="/admin/modulos/${moduleId}/lecciones/nuevo"
            class="inline-flex items-center py-2 px-3 text-xs font-medium text-center text-white bg-green-600 rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-300 dark:bg-green-500 dark:hover:bg-green-600 dark:focus:ring-green-700"
          >
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path>
            </svg>
            Añadir Lección
          </a>
        </div>
      </div>
    `;
      }

      // Ejecutar cuando el DOM esté listo
      document.addEventListener("DOMContentLoaded", () => {
        // 1. Obtener los elementos
        const modalElement = document.getElementById("add-module-modal");
        const form = document.getElementById("add-module-form");
        const container = document.getElementById("accordion-course-content"); // Usamos el ID de tu acordeón
        const feedbackEl = document.getElementById("form-feedback");
        const submitButton = document.getElementById("add-module-submit-btn");

        if (!modalElement || !form || !container || !feedbackEl || !submitButton) {
          console.error(
            "Faltan elementos clave para el modal de añadir módulo (modal, form, container, feedback o submit button).",
          );
          return;
        }

        // 2. Inicializar la instancia del Modal de Flowbite
        //    'Modal' es una variable global gracias al script CDN de Flowbite
        const modal = new Modal(modalElement);

        // 3. Escuchar el evento 'submit' del formulario
        form.addEventListener("submit", async (event) => {
          event.preventDefault(); // ¡Evita la recarga de la página!

          // Deshabilitar botón y mostrar "cargando"
          submitButton.disabled = true;
          submitButton.textContent = "Guardando...";
          feedbackEl.textContent = ""; // Limpiar errores previos

          // 4. Recolectar datos del formulario
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          try {
            // 5. Enviar datos al servidor (Laravel)
            const response = await fetch("/admin/modulos/nuevo", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Accept: "application/json",
                "X-CSRF-TOKEN": data._token, // Envía el token CSRF
              },
              body: JSON.stringify({
                nombre_modulo: data.nombre_modulo,
                course_id: data.course_id,
              }),
            });

            if (response.ok) {
              // 6. Éxito: El servidor devolvió 201 (Created)
              const newModule = await response.json();

              // 7. Crear el HTML para el nuevo módulo
              const newModuleHTML = createModuleAccordionHTML(newModule);

              // 8. Añadir el HTML al contenedor del acordeón
              container.insertAdjacentHTML("beforeend", newModuleHTML);

              // 9. Limpiar, ocultar modal
              form.reset();
              modal.hide();

              // 10. ¡Importante! Reinicializa los acordeones
              //     'initAccordions' es una función global de Flowbite
              initAccordions();
            } else {
              // 11. Error: El servidor devolvió un error (ej. 422 Validación)
              const errorData = await response.json();
              let errorMessage = "Ocurrió un error.";
              if (errorData.errors && errorData.errors.nombre_modulo) {
                // Muestra el primer error de validación para 'nombre_modulo'
                errorMessage = errorData.errors.nombre_modulo[0];
              } else if (errorData.message) {
                errorMessage = errorData.message;
              }
              feedbackEl.textContent = errorMessage;
            }
          } catch (error) {
            // Error de red
            console.error("Error de red:", error);
            feedbackEl.textContent = "Error de conexión. Inténtalo de nuevo.";
          } finally {
            // 12. Volver a habilitar el botón
            submitButton.disabled = false;
            submitButton.innerHTML = `<svg class="me-1 -ms-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path></svg> Añadir Módulo`;
          }
        });
      });
    </script>
  </body>
</html>