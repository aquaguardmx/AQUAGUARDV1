                                class="text-3xl font-bold text-white mb-1"
                            >
                                8
                            </div>
                            <div class="text-blue-200 text-sm font-medium">
                                Logros
                            </div>
                        </div>
                        <div
                            class="text-center transform transition-all duration-300 hover:scale-110"
                        >
                            <div
