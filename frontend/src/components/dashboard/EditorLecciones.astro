---
// Componente: LessonEditor.astro
// Props que recibe el componente
interface Recurso {
  titulo: string;
  url: string;
}

interface Leccion {
  titulo: string;
  tipo_contenido: string;
  url_video?: string;
  recursos: Recurso[];
}

// Definir las props
export interface Props {
  leccionActual: Leccion;
}

// Recibir las props
const { leccionActual } = Astro.props;
---

<div
    class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6"
>
    <!-- Breadcrumb -->
    <nav class="flex mb-6" aria-label="Breadcrumb">
        <ol
            class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400"
        >
            <li>
                <a
                    href="/dashboard"
                    class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                    >Mis Cursos</a>
            </li>
            <li class="flex items-center space-x-2">
                <span>/</span>
                <a
                    href="#"
                    class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                    >El Ciclo del Agua</a
                >
            </li>
            <li class="flex items-center space-x-2">
                <span>/</span>
                <span class="text-gray-900 dark:text-gray-300"
                    >Editando Lección</span
                >
            </li>
        </ol>
    </nav>

    <!-- Formulario de Edición -->
    <form id="lesson-form" class="space-y-6">
        <!-- Título de la Lección -->
        <div>
            <label
                for="lesson_title"
                class="block text-sm font-semibold text-gray-900 dark:text-white mb-2"
            >
                Título de la Lección
            </label>
            <input
                type="text"
                id="lesson_title"
                name="lesson_title"
                value={leccionActual.titulo}
                class="w-full px-4 py-3 text-lg font-bold text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                required
            />
        </div>

        <!-- Tipo de Contenido -->
        <div>
            <label
                for="content_type"
                class="block text-sm font-semibold text-gray-900 dark:text-white mb-2"
            >
                Tipo de Contenido
            </label>
            <select
                id="content_type"
                name="content_type"
                class="w-full px-3 py-2 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
            >
                <option
                    value="video"
                    selected={leccionActual.tipo_contenido === "video"}
                    >Video</option
                >
                <option
                    value="texto"
                    selected={leccionActual.tipo_contenido === "texto"}
                    >Texto</option
                >
            </select>
        </div>

        <!-- Contenido de Video -->
        <div
            id="video-content"
            class={leccionActual.tipo_contenido === "video"
                ? "block"
                : "hidden"}
        >
            <label
                for="video_url"
                class="block text-sm font-semibold text-gray-900 dark:text-white mb-2"
            >
                Enlace del Video
            </label>
            <input
                type="url"
                id="video_url"
                name="video_url"
                value={leccionActual.url_video || ""}
                class="w-full px-3 py-2 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                placeholder="https://vimeo.com/..."
            />
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                Opcionalmente, puedes subir un archivo de video:
            </p>
            <input
                class="mt-2 w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-blue-900 dark:file:text-blue-300"
                id="video_file"
                name="video_file"
                type="file"
                accept="video/*"
            />
        </div>

        <!-- Contenido de Texto -->
        <div
            id="text-content"
            class={leccionActual.tipo_contenido === "texto"
                ? "block"
                : "hidden"}
        >
            <label
                class="block text-sm font-semibold text-gray-900 dark:text-white mb-2"
            >
                Contenido de Texto
            </label>
            <div
                id="text-editor"
                class="min-h-[200px] border border-gray-300 dark:border-gray-600 rounded-lg"
            >
            </div>
            <input type="hidden" id="text_content" name="text_content" />
        </div>

        <!-- Pestañas de Contenido Adicional -->
        <div class="border-b border-gray-200 dark:border-gray-600">
            <nav class="flex space-x-8">
                <button
                    type="button"
                    class="py-4 px-1 border-b-2 border-blue-600 text-sm font-semibold text-blue-600 dark:text-blue-400"
                    data-tab="descripcion"
                >
                    Descripción
                </button>
                <button
                    type="button"
                    class="py-4 px-1 border-b-2 border-transparent text-sm font-semibold text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
                    data-tab="recursos"
                >
                    Recursos
                </button>
            </nav>
        </div>

        <!-- Contenido de las Pestañas -->
        <div id="tab-content">
            <!-- Pestaña Descripción -->
            <div id="descripcion-tab" class="space-y-4">
                <label
                    class="block text-sm font-semibold text-gray-900 dark:text-white"
                >
                    Contenido de la Lección
                </label>
                <div
                    id="description-editor"
                    class="min-h-[300px] border border-gray-300 dark:border-gray-600 rounded-lg"
                >
                </div>
                <input
                    type="hidden"
                    id="lesson_description"
                    name="lesson_description"
                />
            </div>

            <!-- Pestaña Recursos -->
            <div id="recursos-tab" class="hidden space-y-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                    Recursos de la Lección
                </h3>
                <div id="resource-container" class="space-y-4">
                    {
                        leccionActual.recursos.map((recurso, index) => (
                            <div class="p-4 border border-gray-200 dark:border-gray-600 rounded-lg resource-item">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                                            Título del Recurso
                                        </label>
                                        <input
                                            type="text"
                                            name="resource_title[]"
                                            value={recurso.titulo}
                                            class="w-full px-3 py-2 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                                        />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                                            Enlace o Archivo
                                        </label>
                                        <div class="flex gap-2">
                                            <input
                                                type="text"
                                                name="resource_url[]"
                                                value={recurso.url}
                                                class="flex-1 px-3 py-2 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                                            />
                                            <input
                                                class="flex-1 text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100 dark:file:bg-gray-700 dark:file:text-gray-300"
                                                name="resource_file[]"
                                                type="file"
                                            />
                                        </div>
                                    </div>
                                </div>
                                <button
                                    type="button"
                                    class="mt-3 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 inline-flex items-center text-sm font-medium transition-colors remove-resource"
                                >
                                    <svg
                                        class="w-4 h-4 mr-1"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                    Eliminar recurso
                                </button>
                            </div>
                        ))
                    }
                </div>
                <button
                    type="button"
                    id="add-resource-btn"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-colors"
                >
                    <svg
                        class="w-4 h-4 mr-2"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
                            clip-rule="evenodd"></path>
                    </svg>
                    Añadir Recurso
                </button>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div
            class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-200 dark:border-gray-600"
        >
            <button
                type="submit"
                class="flex-1 inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
            >
                <svg
                    class="w-5 h-5 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    ></path>
                </svg>
                Guardar Cambios
            </button>
            <button
                type="button"
                id="delete-lesson-btn"
                class="flex-1 inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors"
            >
                <svg
                    class="w-5 h-5 mr-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                        clip-rule="evenodd"></path>
                </svg>
                Eliminar Lección
            </button>
        </div>
    </form>
</div>

<script>
// Script para la interactividad del componente
document.addEventListener('DOMContentLoaded', function() {
    // Manejo del tipo de contenido
    const contentTypeSelect = document.getElementById('content_type');
    const videoContent = document.getElementById('video-content');
    const textContent = document.getElementById('text-content');

    if (contentTypeSelect && videoContent && textContent) {
        contentTypeSelect.addEventListener('change', function() {
            if ((this as HTMLSelectElement).value === 'video') {
                videoContent.classList.remove('hidden');
                videoContent.classList.add('block');
                textContent.classList.remove('block');
                textContent.classList.add('hidden');
            } else {
                textContent.classList.remove('hidden');
                textContent.classList.add('block');
                videoContent.classList.remove('block');
                videoContent.classList.add('hidden');
            }
        });
    }

    // Manejo de pestañas
    const tabButtons = document.querySelectorAll('[data-tab]');
    const tabContents = document.querySelectorAll('#tab-content > div');

    tabButtons.forEach(button => {
        button.addEventListener('click', (event) => {
            const target = event.currentTarget as HTMLElement;
            const targetTab = target.getAttribute('data-tab');
            
            // Actualizar botones activos
            tabButtons.forEach(btn => {
                btn.classList.remove('border-blue-600', 'text-blue-600', 'dark:text-blue-400');
                btn.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
            });
            target.classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');
            target.classList.add('border-blue-600', 'text-blue-600', 'dark:text-blue-400');

            // Mostrar/ocultar contenido
            tabContents.forEach(content => {
                content.classList.add('hidden');
            });
            const tabElement = document.getElementById(`${targetTab}-tab`);
            if (tabElement) {
                tabElement.classList.remove('hidden');
            }
        });
    });

    // Manejo de recursos
    const addResourceBtn = document.getElementById('add-resource-btn');
    const resourceContainer = document.getElementById('resource-container');

    if (addResourceBtn && resourceContainer) {
        addResourceBtn.addEventListener('click', function() {
            const newResource = document.createElement('div');
            newResource.className = 'p-4 border border-gray-200 dark:border-gray-600 rounded-lg resource-item';
            newResource.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                            Título del Recurso
                        </label>
                        <input
                            type="text"
                            name="resource_title[]"
                            class="w-full px-3 py-2 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                            placeholder="Nombre del recurso"
                        />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-900 dark:text-white mb-2">
                            Enlace o Archivo
                        </label>
                        <div class="flex gap-2">
                            <input
                                type="text"
                                name="resource_url[]"
                                class="flex-1 px-3 py-2 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                                placeholder="https://..."
                            />
                            <input
                                class="flex-1 text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100 dark:file:bg-gray-700 dark:file:text-gray-300"
                                name="resource_file[]"
                                type="file"
                            />
                        </div>
                    </div>
                </div>
                <button
                    type="button"
                    class="mt-3 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 inline-flex items-center text-sm font-medium transition-colors remove-resource"
                >
                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                    </svg>
                    Eliminar recurso
                </button>
            `;
            resourceContainer.appendChild(newResource);
        });
    }

    // Eliminar recursos
    document.addEventListener('click', function(e) {
        const targetElement = e.target as HTMLElement;
        if (targetElement.classList && (targetElement.classList.contains('remove-resource') || targetElement.closest('.remove-resource'))) {
            const button = targetElement.classList.contains('remove-resource') ? targetElement : targetElement.closest('.remove-resource');
            if (button) {
                const resourceItem = (button as HTMLElement).closest('.resource-item');
                if (resourceItem) {
                    resourceItem.remove();
                }
            }
        }
    });

    // Manejo del formulario
    const lessonForm = document.getElementById('lesson-form');
    if (lessonForm) {
        lessonForm.addEventListener('submit', function(e) {
            e.preventDefault();
            // Aquí iría la lógica para guardar los cambios
            console.log('Formulario enviado');
        });
    }

    // Manejo del botón eliminar lección
    const deleteLessonBtn = document.getElementById('delete-lesson-btn');
    if (deleteLessonBtn) {
        deleteLessonBtn.addEventListener('click', function() {
            if (confirm('¿Estás seguro de que quieres eliminar esta lección?')) {
                // Aquí iría la lógica para eliminar la lección
                console.log('Lección eliminada');
            }
        });
    }
});
</script>