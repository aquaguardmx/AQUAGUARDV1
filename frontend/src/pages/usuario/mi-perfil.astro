                                >
                                    <span class="flex items-center">
                                        <i
                                            class="fas fa-shield-alt mr-3 text-lg"
                                        ></i>
                                        Seguridad
                                    </span>
                                </button>
                            </nav>
                        </div>

                        <!-- Enhanced Profile Form -->
                        <div class="p-9">
                            <div class="flex items-center justify-between mb-9">
                                <h2 class="text-3xl font-bold text-gray-900">
                                    Información Personal
                                </h2>
                                <div
                                    class="w-14 h-14 bg-gradient-to-r from-green-400 to-emerald-500 rounded-2xl flex items-center justify-center shadow-xl shadow-green-500/30 transition-all duration-300 hover:scale-110"
                                >
                                    <i class="fas fa-check text-white text-xl"
