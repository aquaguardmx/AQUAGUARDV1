---
// src/components/aquaguard-components/NavegacionEntreLecciones.astro

// 1. DEFINICIÓN DE TIPOS
export interface Leccion {
  id_leccion: number | string;
  modulo_id: number;
  titulo: string;
  tipo_contenido: string;
  contenido_texto?: string;
  video_url?: string | null;
  orden: number;
  duracion_min?: number;
  completado?: boolean;
  bloqueado?: boolean;
}

export interface Modulo {
  id_modulo: number | string;
  curso_id: number;
  titulo: string;
  orden: number;
  lecciones: Leccion[];
  completado?: boolean;
}

export interface Curso {
  modulos: Modulo[];
}

// 2. Obtener el ID del curso de la URL
const url = Astro.url;
const pathParts = url.pathname.split('/').filter(part => part !== '');

// Buscar el índice del cursoId de forma más robusta
let cursoId: string | null = null;

// Diferentes patrones de URL posibles
if (url.pathname.includes('/admin/cursos/')) {
  // Para URLs como /admin/cursos/9/lecciones
  const cursosIndex = pathParts.indexOf('cursos');
  if (cursosIndex !== -1 && pathParts[cursosIndex + 1]) {
    cursoId = pathParts[cursosIndex + 1];
  }
} else if (url.pathname.includes('/curso/')) {
  // Para URLs como /curso/9/leccion
  const cursoIndex = pathParts.indexOf('curso');
  if (cursoIndex !== -1 && pathParts[cursoIndex + 1]) {
    cursoId = pathParts[cursoIndex + 1];
  }
}

// Si no encontramos con los patrones anteriores, usar índice por defecto
if (!cursoId && pathParts.length > 1) {
  cursoId = pathParts[1]; // Fallback
}

// 3. Función para cargar los módulos desde la API
async function cargarModulos(cursoId: string | number): Promise<Modulo[]> {
  const apiUrl = `http://localhost:8000/api/cursos/${cursoId}/modulos-y-lecciones`;

  try {
    const response = await fetch(apiUrl);
    
    if (!response.ok) {
      throw new Error(`Error al cargar módulos: ${response.status} ${response.statusText}`);
    }
    
    const data = await response.json();
    
    // Verificar la estructura de los datos
    if (Array.isArray(data)) {
      return data;
    } else {
      return [];
    }

  } catch (error) {
    console.error('❌ Error cargando módulos:', error);
    // Mostrar más detalles del error
    if (error instanceof Error) {
      console.error('🔍 Detalles del error:', error.message);
    }
    return [];
  }
}

// 4. Cargar los módulos
let modulos: Modulo[] = [];
let errorCarga: string | null = null;

if (cursoId) {
  try {
    modulos = await cargarModulos(cursoId);
  } catch (error) {
    errorCarga = error instanceof Error ? error.message : 'Error desconocido';
    modulos = [];
  }
} else {
  errorCarga = 'No se pudo detectar el ID del curso';
}

// 5. Obtener lección actual de la URL
let leccionActualId: string | number | null = null;

// Buscar lección actual en la URL
if (url.pathname.includes('/leccion/')) {
  const leccionIndex = pathParts.indexOf('leccion');
  if (leccionIndex !== -1 && pathParts[leccionIndex + 1]) {
    leccionActualId = pathParts[leccionIndex + 1];
  }
}

// 6. LÓGICA DE UX (Servidor) - Adaptada a la estructura de la API
const moduloAbierto = new Map<string | number, boolean>();
let moduloActualEncontrado = false;

// Crear estructura de curso para el componente
const curso: Curso = {
  modulos: modulos.map(modulo => ({
    ...modulo,
    // Mapear propiedades para compatibilidad
    lecciones: modulo.lecciones.map(leccion => ({
      ...leccion,
      completado: leccion.completado || false
    })),
    completado: modulo.completado || false
  }))
};

for (const modulo of curso.modulos) {
  const estaActivo = modulo.lecciones.some(
    (l) => l.id_leccion.toString() === leccionActualId?.toString(),
  );
  moduloAbierto.set(modulo.id_modulo, estaActivo);
  if (estaActivo) moduloActualEncontrado = true;
}

// Si ninguna lección está activa, abre el primer módulo por defecto
if (!moduloActualEncontrado && curso.modulos.length > 0) {
  moduloAbierto.set(curso.modulos[0].id_modulo, true);
}
---

<aside class="p-6 bg-white dark:bg-gray-900 rounded-lg shadow-lg w-full max-w-md">
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
            </svg>
        </div>
        <span class="whitespace-nowrap">Contenido del Curso</span>
    </h3>

    {errorCarga ? (
        <div class="p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
            <p class="text-red-700 dark:text-red-300 text-sm">
                Error al cargar el contenido: {errorCarga}
            </p>
        </div>
    ) : curso.modulos.length === 0 ? (
        <div class="p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
            <p class="text-yellow-700 dark:text-yellow-300 text-sm">
                No hay módulos disponibles para este curso.
            </p>
        </div>
    ) : (
        <div class="space-y-4">
            {curso.modulos.map((modulo, moduloIndex) => {
                const estaAbierto = moduloAbierto.get(modulo.id_modulo) || false;

                return (
                    <div 
                        class="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden bg-white dark:bg-gray-800 transition-all hover:shadow-lg"
                        data-modulo-id={modulo.id_modulo}
                    >
                        {/* Header del Módulo - MEJORADO */}
                        <div class={`
                            p-4 flex items-start justify-between cursor-pointer transition-colors modulo-header group
                            ${modulo.completado ? 'bg-green-50 dark:bg-green-900/20 border-l-4 border-l-green-500' : 'bg-gray-50 dark:bg-gray-700 border-l-4 border-l-blue-500'}
                        `}>
                            <div class="flex items-start gap-3 flex-1 min-w-0">
                                <div class={`
                                    w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold transition-colors flex-shrink-0 mt-0.5
                                    ${modulo.completado 
                                        ? 'bg-green-500 text-white' 
                                        : 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300 group-hover:bg-blue-200 dark:group-hover:bg-blue-800'
                                    }
                                `}>
                                    {moduloIndex + 1}
                                </div>
                                <div class="flex-1 min-w-0">
                                    {/* TÍTULO DEL MÓDULO COMPLETO - SIN TRUNCATE */}
                                    <h4 class="font-semibold text-gray-900 dark:text-white text-base leading-snug break-words">
                                        {modulo.titulo}
                                    </h4>
                                    <div class="flex items-center flex-wrap gap-2 mt-2">
                                        <span class="text-sm text-gray-600 dark:text-gray-400">
                                            {modulo.lecciones.length} lección{modulo.lecciones.length !== 1 ? 'es' : ''}
                                        </span>
                                        {modulo.completado && (
                                            <span class="inline-flex items-center gap-1 text-green-600 dark:text-green-400 text-sm bg-green-100 dark:bg-green-900/30 px-2 py-1 rounded-full">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                </svg>
                                                Completado
                                            </span>
                                        )}
                                    </div>
                                </div>
                            </div>
                            
                            {/* Contenedor para iconos (check y flecha) */}
                            <div class="flex items-center gap-2 flex-shrink-0 ml-3">
                                {modulo.completado && (
                                    <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                )}
                                {/* Icono de flecha */}
                                <svg class={`
                                    w-5 h-5 text-gray-500 dark:text-gray-400 transition-transform modulo-toggle-icon flex-shrink-0
                                    ${estaAbierto ? 'rotate-180' : ''}
                                `} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </div>
                        
                        {/* Contenedor de Lecciones - MEJORADO */}
                        <div class={`
                            lecciones-container transition-all duration-300 bg-white dark:bg-gray-800
                            ${!estaAbierto ? 'hidden' : ''}
                        `}>
                            {modulo.lecciones.map((leccion, leccionIndex) => (
                                <a
                                    href={`/curso/${cursoId}/leccion/${leccion.id_leccion}`}
                                    class={`
                                        flex items-start gap-4 p-4 transition-all group border-b border-gray-100 dark:border-gray-700 last:border-b-0
                                        hover:bg-gray-50 dark:hover:bg-gray-750
                                        ${leccion.id_leccion.toString() === leccionActualId?.toString()
                                            ? 'bg-blue-50 dark:bg-blue-900/30 border-r-4 border-blue-500'
                                            : ''
                                        }
                                        ${leccion.completado && leccion.id_leccion.toString() !== leccionActualId?.toString() ? 'bg-green-50 dark:bg-green-900/20' : ''}
                                    `}
                                >
                                    <div class={`
                                        w-8 h-8 rounded-full flex items-center justify-center text-sm font-medium flex-shrink-0 transition-colors mt-0.5
                                        ${leccion.id_leccion.toString() === leccionActualId?.toString()
                                            ? 'bg-blue-500 text-white'
                                            : leccion.completado
                                              ? 'bg-green-500 text-white'
                                              : 'bg-gray-200 dark:bg-gray-600 text-gray-600 dark:text-gray-400 group-hover:bg-gray-300 dark:group-hover:bg-gray-500'
                                        }
                                    `}>
                                        {leccionIndex + 1}
                                    </div>
                                    
                                    {/* CONTENIDO DE LA LECCIÓN - MEJORADO */}
                                    <div class="flex-1 min-w-0">
                                        {/* TÍTULO DE LECCIÓN COMPLETO - SIN TRUNCATE */}
                                        <div class="flex items-start gap-2 mb-2">
                                            <span class="font-medium text-gray-900 dark:text-white text-sm leading-snug break-words flex-1">
                                                {leccion.titulo}
                                            </span>
                                            {leccion.tipo_contenido === 'quiz' && (
                                                <span class="bg-orange-100 text-orange-800 text-xs px-2 py-1 rounded-full font-medium flex-shrink-0 mt-0.5">
                                                    Quiz
                                                </span>
                                            )}
                                        </div>
                                        <div class="flex items-center gap-3 flex-wrap">
                                            <span class="capitalize bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-xs text-gray-700 dark:text-gray-300">
                                                {leccion.tipo_contenido}
                                            </span>
                                            {leccion.completado && (
                                                <span class="flex items-center gap-1 text-green-600 dark:text-green-400 text-xs">
                                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                    </svg>
                                                    Completada
                                                </span>
                                            )}
                                        </div>
                                    </div>
                                    
                                    {/* Indicadores del lado derecho */}
                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        {leccion.completado && leccion.id_leccion.toString() !== leccionActualId?.toString() && (
                                            <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                            </svg>
                                        )}
                                        
                                        {/* Indicador de lección actual */}
                                        {leccion.id_leccion.toString() === leccionActualId?.toString() && (
                                            <span class="bg-blue-500 text-white text-xs px-2 py-1 rounded-full font-medium whitespace-nowrap">
                                                Actual
                                            </span>
                                        )}
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                );
            })}
        </div>
    )}
</aside>

<script is:inline>
    function setupAccordion() {
        const sidebar = document.querySelector("aside");
        if (!sidebar) return;

        const moduloHeaders = sidebar.querySelectorAll(".modulo-header");

        function closeOtherModulos(currentModuloId) {
            moduloHeaders.forEach(header => {
                const moduloElement = header.closest("[data-modulo-id]");
                if (!moduloElement) return;

                const moduloId = moduloElement.dataset.moduloId;
                
                if (moduloId !== currentModuloId) {
                    const otherLeccionesContainer = moduloElement.querySelector(".lecciones-container");
                    const otherToggleIcon = header.querySelector(".modulo-toggle-icon");
                    
                    if (otherLeccionesContainer) {
                        otherLeccionesContainer.classList.add("hidden");
                        otherLeccionesContainer.style.opacity = "";
                        otherLeccionesContainer.style.transform = "";
                        otherLeccionesContainer.style.transition = "";
                    }
                    if (otherToggleIcon) {
                        otherToggleIcon.classList.remove("rotate-180");
                    }
                }
            });
        }
        
        moduloHeaders.forEach((header) => {
            header.addEventListener("click", () => {
                const moduloElement = header.closest("[data-modulo-id]");
                if (!moduloElement) {
                    console.error("No se pudo encontrar el elemento [data-modulo-id] padre.");
                    return;
                }

                const moduloId = moduloElement.dataset.moduloId;
                const leccionesContainer = moduloElement.querySelector(".lecciones-container");
                const toggleIcon = header.querySelector(".modulo-toggle-icon");

                if (leccionesContainer) {
                    const isOpening = leccionesContainer.classList.contains("hidden");

                    // Lógica de acordeón: Si estamos abriendo, cerramos los demás
                    if (isOpening && moduloId) {
                        closeOtherModulos(moduloId);
                    }
                    
                    // Toggle del módulo actual
                    leccionesContainer.classList.toggle("hidden");

                    // Animación suave al abrir
                    if (!leccionesContainer.classList.contains("hidden")) {
                        leccionesContainer.style.opacity = "0";
                        leccionesContainer.style.transform = "translateY(-10px)";
                        
                        requestAnimationFrame(() => {
                            leccionesContainer.style.transition = "all 0.3s ease";
                            leccionesContainer.style.opacity = "1";
                            leccionesContainer.style.transform = "translateY(0)";
                        });
                    } else {
                        // Limpiar estilos al cerrar
                        leccionesContainer.style.opacity = "";
                        leccionesContainer.style.transform = "";
                        leccionesContainer.style.transition = "";
                    }
                }

                if (toggleIcon) {
                    toggleIcon.classList.toggle("rotate-180");
                }
            });
        });
    }

    // Manejar diferentes estados de carga del DOM
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupAccordion);
    } else {
        // DOM ya está listo
        setupAccordion();
    }
</script>

<style is:global>
    /* Estilos mejorados para visualización completa de textos */
    .lecciones-container {
        max-height: 600px;
        overflow-y: auto;
    }
    
    .lecciones-container::-webkit-scrollbar {
        width: 6px;
    }
    
    .lecciones-container::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }
    
    .lecciones-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    
    .lecciones-container::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
    
    /* Mejoras de transición */
    .lecciones-container {
        transition: max-height 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
    }
    
    /* Efectos hover mejorados */
    .modulo-header:hover {
        background-color: #f8fafc !important;
        transform: translateY(-1px);
    }
    
    .dark .modulo-header:hover {
        background-color: #374151 !important;
    }
    
    /* Mejoras de tipografía */
    .break-words {
        word-break: break-word;
        overflow-wrap: break-word;
    }
    
    /* Espaciado mejorado para textos largos */
    .leading-snug {
        line-height: 1.375;
    }
    
    /* Sombra suave al hover */
    .hover\\:shadow-lg:hover {
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    
    /* Color personalizado para hover en modo oscuro */
    .dark .hover\\:bg-gray-750:hover {
        background-color: #374151;
    }
</style>