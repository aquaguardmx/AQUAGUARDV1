---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";
// src/pages/detalle-curso.astro
---

<Layout title="Inicio">
    <!-- Header -->
    <Header />

    <!-- Breadcrumb -->
    <nav class="bg-blue-50 py-4">
        <div class="container mx-auto px-4">
            <div class="flex items-center space-x-2 text-sm">
                <a href="#" class="text-blue-600 hover:text-blue-800">Inicio</a>
                <span class="text-gray-400"><i class="fas fa-chevron-right"></i></span>
                <a href="#" class="text-blue-600 hover:text-blue-800">Cursos</a>
                <span class="text-gray-400"><i class="fas fa-chevron-right"></i></span>
                <a href="#" class="text-blue-600 hover:text-blue-800">Desarrollo Web</a>
                <span class="text-gray-400"><i class="fas fa-chevron-right"></i></span>
                <span class="text-gray-600">Curso Completo</span>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-purple-700 text-white py-16">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <!-- Información del curso -->
                <div class="text-white">
                    <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md border border-white/30 rounded-full px-4 py-2 mb-6">
                        <span class="text-blue-100 text-sm font-medium">Desarrollo Web</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
                        Curso Completo de Desarrollo Web Full Stack
                    </h1>
                    
                    <p class="text-xl text-blue-100 mb-8 leading-relaxed">
                        Aprende a crear aplicaciones web modernas desde cero. Domina HTML, CSS, JavaScript, React, Node.js y más.
                    </p>

                    <div class="flex flex-wrap gap-4 items-center mb-8">
                        <div class="flex items-center space-x-2">
                            <div class="flex items-center">
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star text-yellow-400"></i>
                                <i class="fas fa-star-half-alt text-yellow-400"></i>
                            </div>
                            <span class="text-blue-100">4.8 (2,450 reseñas)</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <i class="fas fa-users text-blue-200"></i>
                            <span class="text-blue-100">15,000+ estudiantes</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <i class="fas fa-clock text-blue-200"></i>
                            <span class="text-blue-100">48 horas totales</span>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-4">
                        <button class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition transform hover:-translate-y-1">
                            <i class="fas fa-shopping-cart mr-2"></i>
                            Inscribirse - $89.99
                        </button>
                        <button class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition">
                            <i class="far fa-heart mr-2"></i>
                            Agregar a favoritos
                        </button>
                    </div>
                </div>

                <!-- Video preview -->
                <div class="relative">
                    <div class="bg-black rounded-2xl overflow-hidden shadow-2xl">
                        <div class="aspect-video bg-gray-800 flex items-center justify-center">
                            <div class="text-center">
                                <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4 cursor-pointer hover:bg-white/30 transition">
                                    <i class="fas fa-play text-white text-2xl"></i>
                                </div>
                                <p class="text-white font-medium">Ver video preview</p>
                            </div>
                        </div>
                    </div>
                    <div class="absolute -bottom-4 -left-4 bg-white text-gray-800 px-4 py-2 rounded-lg shadow-lg">
                        <span class="font-semibold">¡Oferta especial!</span>
                        <span class="text-green-600 ml-2">70% de descuento</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Course Content -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <!-- Main Content -->
                <div class="lg:col-span-2">
                    <!-- Tabs -->
                    <div class="border-b border-gray-200 mb-8">
                        <nav class="flex space-x-8">
                            <button class="border-b-2 border-blue-600 text-blue-600 py-4 font-semibold">
                                Descripción
                            </button>
                            <button class="text-gray-500 hover:text-gray-700 py-4 font-semibold">
                                Contenido
                            </button>
                            <button class="text-gray-500 hover:text-gray-700 py-4 font-semibold">
                                Reseñas
                            </button>
                            <button class="text-gray-500 hover:text-gray-700 py-4 font-semibold">
                                Instructor
                            </button>
                        </nav>
                    </div>

                    <!-- Description -->
                    <div class="prose max-w-none">
                        <h2 class="text-3xl font-bold text-gray-900 mb-6">Lo que aprenderás</h2>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-check text-green-500 mt-1"></i>
                                <span>Crear aplicaciones web modernas con HTML5, CSS3 y JavaScript</span>
                            </div>
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-check text-green-500 mt-1"></i>
                                <span>Desarrollar interfaces interactivas con React y Tailwind CSS</span>
                            </div>
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-check text-green-500 mt-1"></i>
                                <span>Construir APIs RESTful con Node.js y Express</span>
                            </div>
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-check text-green-500 mt-1"></i>
                                <span>Trabajar con bases de datos MongoDB y PostgreSQL</span>
                            </div>
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-check text-green-500 mt-1"></i>
                                <span>Implementar autenticación y autorización JWT</span>
                            </div>
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-check text-green-500 mt-1"></i>
                                <span>Desplegar aplicaciones en la nube con Docker y AWS</span>
                            </div>
                        </div>

                        <h3 class="text-2xl font-bold text-gray-900 mb-4">Descripción del curso</h3>
                        <p class="text-gray-700 mb-6 leading-relaxed">
                            Este curso completo de desarrollo web full stack te llevará desde los fundamentos hasta 
                            conceptos avanzados. Aprenderás las tecnologías más demandadas en el mercado laboral 
                            actual y construirás proyectos reales que podrás incluir en tu portafolio.
                        </p>

                        <h3 class="text-2xl font-bold text-gray-900 mb-4">¿Para quién es este curso?</h3>
                        <ul class="list-disc list-inside text-gray-700 mb-6 space-y-2">
                            <li>Principiantes que quieren iniciar en el desarrollo web</li>
                            <li>Desarrolladores que buscan actualizar sus habilidades</li>
                            <li>Estudiantes de informática y carreras afines</li>
                            <li>Emprendedores que quieren construir sus propias aplicaciones</li>
                        </ul>

                        <h3 class="text-2xl font-bold text-gray-900 mb-4">Requisitos</h3>
                        <ul class="list-disc list-inside text-gray-700 mb-6 space-y-2">
                            <li>Conocimientos básicos de computación</li>
                            <li>Computadora con conexión a internet</li>
                            <li>Muchas ganas de aprender y practicar</li>
                        </ul>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="space-y-6">
                    <!-- Course Features -->
                    <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200">
                        <h3 class="text-xl font-bold text-gray-900 mb-4">Este curso incluye:</h3>
                        <div class="space-y-3">
                            <div class="flex items-center space-x-3">
                                <i class="fas fa-play-circle text-blue-600"></i>
                                <span>48 horas de video bajo demanda</span>
                            </div>
                            <div class="flex items-center space-x-3">
                                <i class="fas fa-file-alt text-blue-600"></i>
                                <span>125 recursos descargables</span>
                            </div>
                            <div class="flex items-center space-x-3">
                                <i class="fas fa-infinity text-blue-600"></i>
                                <span>Acceso de por vida</span>
                            </div>
                            <div class="flex items-center space-x-3">
                                <i class="fas fa-mobile-alt text-blue-600"></i>
                                <span>Acceso en dispositivos móviles y TV</span>
                            </div>
                            <div class="flex items-center space-x-3">
                                <i class="fas fa-certificate text-blue-600"></i>
                                <span>Certificado de finalización</span>
                            </div>
                        </div>
                    </div>

                    <!-- Instructor -->
                    <div class="bg-white rounded-2xl p-6 border border-gray-200">
                        <h3 class="text-xl font-bold text-gray-900 mb-4">Instructor</h3>
                        <div class="flex items-center space-x-4 mb-4">
                            <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop&crop=face" 
                                 alt="Instructor" class="w-16 h-16 rounded-full">
                            <div>
                                <h4 class="font-semibold text-gray-900">María González</h4>
                                <p class="text-gray-600 text-sm">Senior Full Stack Developer</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-4 text-sm text-gray-600 mb-4">
                            <div class="flex items-center space-x-1">
                                <i class="fas fa-star text-yellow-400"></i>
                                <span>4.8 rating</span>
                            </div>
                            <div class="flex items-center space-x-1">
                                <i class="fas fa-users"></i>
                                <span>45,000 estudiantes</span>
                            </div>
                            <div class="flex items-center space-x-1">
                                <i class="fas fa-play-circle"></i>
                                <span>8 cursos</span>
                            </div>
                        </div>
                        <p class="text-gray-700 text-sm mb-4">
                            Desarrolladora full stack con 8+ años de experiencia. Especializada en JavaScript, React y Node.js.
                        </p>
                        <button class="w-full bg-gray-100 text-gray-700 py-2 rounded-lg hover:bg-gray-200 transition font-semibold">
                            Ver perfil completo
                        </button>
                    </div>

                    <!-- Share -->
                    <div class="bg-white rounded-2xl p-6 border border-gray-200">
                        <h3 class="text-xl font-bold text-gray-900 mb-4">Compartir curso</h3>
                        <div class="flex space-x-3">
                            <button class="flex-1 bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">
                                <i class="fab fa-facebook-f"></i>
                            </button>
                            <button class="flex-1 bg-blue-400 text-white py-2 rounded-lg hover:bg-blue-500 transition">
                                <i class="fab fa-twitter"></i>
                            </button>
                            <button class="flex-1 bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 transition">
                                <i class="fab fa-pinterest"></i>
                            </button>
                            <button class="flex-1 bg-gray-800 text-white py-2 rounded-lg hover:bg-gray-900 transition">
                                <i class="fas fa-link"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <Footer />
    </Layout>