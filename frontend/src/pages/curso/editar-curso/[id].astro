        // Funciones para mostrar/ocultar modales MEJORADAS
        function mostrarModal(modal, content) {
            document.body.style.overflow = 'hidden';
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 50);
        }

        function ocultarModal(modal, content) {
            document.body.style.overflow = '';
            modal.classList.remove('opacity-100');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // Cerrar modal al hacer clic fuera
        function setupCerrarModalExterno(modal, content) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    ocultarModal(modal, content);
                }
            });
        }

        // Función para mostrar mensajes
        function mostrarMensaje(mensaje, tipo = 'success') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert-message m-4 ${tipo === 'success' ? 'bg-green-50 border-green-500 text-green-700' : 'bg-red-50 border-red-500 text-red-700'} border-l-4 p-4 rounded-2xl flex items-start shadow-2xl`;
            
            alertDiv.innerHTML = `
                <svg class="w-6 h-6 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="${tipo === 'success' ? 'M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z' : 'M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z'}" clip-rule="evenodd"/>
                </svg>
                <div>
                    <p class="font-bold">${tipo === 'success' ? 'Éxito' : 'Error'}</p>
                    <p>${mensaje}</p>
                </div>
            `;

            document.querySelectorAll('.alert-message').forEach(el => el.remove());
            const main = document.querySelector('main');
            if (main) {
                main.insertBefore(alertDiv, main.firstChild);
                setTimeout(() => {
                    if (alertDiv.parentNode) alertDiv.remove();
                }, 5000);
            }
        }

        // Configurar editor de texto MEJORADO
        function setupEditor() {
            // Botones del editor
            document.querySelectorAll('.editor-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const command = this.getAttribute('data-command');
                    const value = this.getAttribute('data-value');
                    
                    if (command === 'formatBlock' && value) {
                        document.execCommand(command, false, value);
                    } else {
                        document.execCommand(command, false, null);
                    }
                    
                    editorTexto.focus();
                });
            });

            // Manejar enlaces
            document.querySelector('[data-command="createLink"]').addEventListener('click', function() {
                const url = prompt('Ingresa la URL:');
                if (url) {
                    // Validar URL antes de insertar
                    if (url.startsWith('http://') || url.startsWith('https://')) {
                        document.execCommand('createLink', false, url);
                    } else {
                        alert('Por favor ingresa una URL válida (debe comenzar con http:// o https://)');
                    }
                }
            });

            // Establecer contenido por defecto más claro
            if (editorTexto.innerHTML === '') {
                editorTexto.innerHTML = '<p>Escribe el contenido de tu lección aquí...</p>';
            }

            // Prevenir problemas de contenido editable en móviles
            editorTexto.addEventListener('touchstart', function(e) {
                e.stopPropagation();
            }, { passive: true });
        }

        // Manejar cambio de tipo de contenido
        function manejarTipoContenido() {
            const tipo = tipoContenidoSelect.value;
            console.log('🔄 Cambiando tipo de contenido a:', tipo);
            
            // Mostrar/ocultar secciones según el tipo
            if (tipo === 'texto') {
                contenidoTextoSection.classList.remove('hidden');
                contenidoVideoSection.classList.add('hidden');
                videoPreview.classList.add('hidden');
            } else if (tipo === 'video') {
                contenidoTextoSection.classList.add('hidden');
                contenidoVideoSection.classList.remove('hidden');
                videoPreview.classList.remove('hidden');
                
                // Forzar actualización de la vista previa si hay URL
                if (videoUrlInput.value.trim()) {
                    videoUrlInput.dispatchEvent(new Event('input'));
                }
            } else if (tipo === 'mixto') {
                contenidoTextoSection.classList.remove('hidden');
                contenidoVideoSection.classList.remove('hidden');
                videoPreview.classList.remove('hidden');
                
                // Forzar actualización de la vista previa si hay URL
                if (videoUrlInput.value.trim()) {
                    videoUrlInput.dispatchEvent(new Event('input'));
                }
            }
        }

        // Vista previa de video MEJORADA con soporte real para YouTube
        function setupVideoPreview() {
            let previewTimeout;
            
            videoUrlInput.addEventListener('input', function() {
                clearTimeout(previewTimeout);
                const url = this.value.trim();
                
                previewTimeout = setTimeout(() => {
                    if (url) {
                        const videoId = extractVideoId(url);
                        if (videoId) {
                            // Mostrar reproductor de YouTube embebido
                            videoPreview.innerHTML = `
                                <div class="bg-black rounded-xl overflow-hidden aspect-video">
                                    <iframe 
                                        src="https://www.youtube.com/embed/${videoId}?rel=0&showinfo=0" 
                                        class="w-full h-full"
                                        frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen
                                        title="Vista previa del video"
                                    ></iframe>
                                </div>
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 text-center">
                                    Vista previa de YouTube - El video se reproducirá aquí
                                </p>
                            `;
                        } else {
                            // URL no reconocida, mostrar mensaje
                            videoPreview.innerHTML = `
                                <div class="bg-gray-900 rounded-xl p-4 aspect-video flex flex-col items-center justify-center text-center">
                                    <svg class="w-12 h-12 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.47-.927-6.04-2.444M3 12a9 9 0 1118 0 9 9 0 01-18 0z" />
                                    </svg>
                                    <p class="text-gray-400 text-sm">
                                        No se pudo cargar la vista previa<br>
                                        <span class="text-xs text-gray-500 break-all mt-1">${truncateUrl(url)}</span>
                                    </p>
                                </div>
                            `;
                        }
                    } else {
                        // URL vacía
                        videoPreview.innerHTML = `
                            <div class="bg-gray-100 dark:bg-gray-700 rounded-xl p-4 aspect-video flex items-center justify-center">
                                <p class="text-gray-500 dark:text-gray-400 text-center text-sm">
                                    Ingresa una URL de YouTube para ver la vista previa
                                </p>
                            </div>
                        `;
                    }
                }, 800); // Aumentamos el timeout para dar tiempo a escribir
            });
        }

        // Validación de URL de YouTube
        function setupUrlValidation() {
            videoUrlInput.addEventListener('blur', function() {
                const url = this.value.trim();
                if (url && !extractVideoId(url)) {
                    this.classList.add('border-red-500');
                    this.classList.remove('border-gray-300/50');
                    
                    // Mostrar mensaje de error debajo del input
                    let errorMsg = this.parentNode.querySelector('.url-error');
                    if (!errorMsg) {
                        errorMsg = document.createElement('p');
                        errorMsg.className = 'url-error text-red-500 text-xs mt-1';
                        this.parentNode.appendChild(errorMsg);
                    }
                    errorMsg.textContent = 'URL de YouTube no válida. Usa formato: youtube.com/watch?v=ID o youtu.be/ID';
                } else {
                    this.classList.remove('border-red-500');
                    this.classList.add('border-gray-300/50');
                    
                    const errorMsg = this.parentNode.querySelector('.url-error');
                    if (errorMsg) {
                        errorMsg.remove();
                    }
                }
            });
            
            // Limpiar validación cuando el usuario empiece a escribir
            videoUrlInput.addEventListener('input', function() {
                this.classList.remove('border-red-500');
                this.classList.add('border-gray-300/50');
                
                const errorMsg = this.parentNode.querySelector('.url-error');
                if (errorMsg) {
                    errorMsg.remove();
                }
            });
        }

