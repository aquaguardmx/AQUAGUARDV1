---
import "../../styles/estilos.css";
import Header from "../../components/aquaguard-components/Header.astro";
import Footer from "../../components/aquaguard-components/Footer.astro";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>AquaGuard - Mapa de Calidad del Agua</title>
    <!--Estilos de Bootstrap-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!--Carga los estilos base de Leaflet.js-->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!--Font Awesome 6-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Catamaran:wght@300;400;500;600;700&family=Hind:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>
<body>    
    <div class="wrapper">
        <Header />
            <div class="wrapper_inner">
                <div class="hero_content">
                    <h1>.</h1>
                    <div class="logo-container" style="text-align:center; margin-bottom:20px;">
                        <a href="/">
                        <img src="/img/logo.png" alt="AquaGuard Logo" style="height:64px; display:block; margin:0 auto;"> 
                        </a>
                    </div>   
                    <div class="section_title">    
                        <h2>
                            Mapa Interactivo de Calidad del Agua
                        </h2>
                        <p style="font-size:1.15rem; color:#333; max-width:700px; margin:0 auto;">
                            Explora la calidad del agua en ríos, lagos y presas de México. 
                        </p>
                        <p style="font-size:1.15rem; color:#333; max-width:700px; margin:0 auto;">
                            Usa el buscador para encontrar un sitio o cuerpo de agua, o utiliza tu ubicación para ver los cuerpos cercanos. Haz clic en los marcadores para ver información detallada y recomendaciones.
                        </p>
                    </div>
                </div>
            </div>

            <div class="map-container">
                <div class="search-container">
                    <input type="text" id="searchInput" class="search-box" placeholder="Buscar por ubicación o nombre de río">
                    <button type="button" id="searchButton" class="btn-primary-custom"><i class="fas fa-search"></i> Buscar</button>
                    <button type="button" id="locationButton" class="btn-primary-custom"><i class="fas fa-location-arrow"></i> Mi Ubicación</button>
                </div>

                <div id="mapa"></div>

                <!-- Panel de información detallada de cuerpo de agua-->
                <div class="info-panel" id="infoPanel" style="display:none;">
                    <span class="close-panel" id="closePanel">&times;</span>
                    <h3 class="info-title" id="waterBodyTitle"></h3>
                    <div id="waterBodyInfo"></div>
                    
                    <div class="treatment-steps" id="treatmentSteps">
                        <h4><i class="fas fa-filter"></i> Recomendaciones de Tratamiento</h4>
                        <div id="stepsContainer"></div>
                    </div>
                    
                    <div class="mt-4">
                        <h4><i class="fas fa-info-circle"></i> Información Adicional</h4>
                        <div class="parameter-row">
                            <span class="parameter-name">Estado:</span>
                            <span class="parameter-value" id="aptaStatus"></span>
                        </div>
                        <div id="additionalInfo"></div>
                    </div>
                </div>
            </div>

        <Footer />
    </div>

    <!--API del mapa-->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script client:load>
        // Variables globales
        let cuerposAguaOriginal = [];
        let capasAgua;
        let map;
        let ubicacionMarker = null;
        let currentLocation = null;

        function initMap() {
            if (map) return;
            
            map = L.map('mapa').setView([23.6345, -102.5528], 6);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);
            
            // Leyenda
            const legend = L.control({position: 'bottomright'});
            legend.onAdd = function() {
                const div = L.DomUtil.create('div', 'legend');
                div.innerHTML = `
                    <h4>Calidad del Agua</h4>
                    <div><i style="background:#28a745"></i> Buena (Verde)</div>
                    <div><i style="background:#ffc107"></i> Moderada (Amarillo)</div>
                    <div><i style="background:#dc3545"></i> Mala (Rojo)</div>
                    <div><i style="background:#007bff"></i> Sin datos</div>
                `;
                return div;
            };
            legend.addTo(map);
        }

        function cargarCuerposAgua() {
            initMap();
            
            fetch('http://localhost:8000/api/mapa')
                .then(res => {
                    if (!res.ok) {
                        throw new Error(`HTTP error! status: ${res.status}`);
                    }
                    return res.json();
                })
                .then(data => {
                    console.log('Datos recibidos:', data);
                    
                    const estaciones = data.estaciones || [];
                    cuerposAguaOriginal = estaciones;
                    
                    // Limpia capas anteriores
                    if (capasAgua) {
                        map.removeLayer(capasAgua);
                    }
                    
                    // Crea marcadores para cada estación
                    capasAgua = L.layerGroup();
                    
                    estaciones.forEach(estacion => {
                        if (estacion.latitud && estacion.longitud) {
                            let lat = parseFloat(estacion.latitud);
                            let lng = parseFloat(estacion.longitud);
                            
                            if (isNaN(lat) || isNaN(lng)) {
                                console.warn('Coordenadas inválidas:', estacion.latitud, estacion.longitud);
                                return;
                            }
                            
                            // Determina color según semáforo
                            const semaforoActual = estacion.semaforo && estacion.semaforo.length > 0 
                                ? estacion.semaforo[0]
                                : null;
                            
                            let color = '#007bff'; // Azul por defecto (sin datos)
                            let calidad = 'Sin datos';
                            
                            if (semaforoActual) {
                                switch(semaforoActual.color.toUpperCase()) {
                                    case 'VERDE':
                                        color = '#28a745';
                                        calidad = 'Buena';
                                        break;
                                    case 'AMARILLO':
                                        color = '#ffc107';
                                        calidad = 'Moderada';
                                        break;
                                    case 'ROJO':
                                        color = '#dc3545';
                                        calidad = 'Mala';
                                        break;
                                    default:
                                        color = '#007bff';
                                        calidad = 'Sin datos';
                                }
                            }
                            
                            // Popup con información básica
                            const ubicacion = estacion.municipio 
                                ? `${estacion.municipio.nombre}, ${estacion.municipio.estado.nombre}`
                                : 'Ubicación no especificada';
                            
                            let popup = `
                                <div style="min-width: 250px">
                                    <b>${estacion.nombre || 'Sin nombre'}</b><br>
                                    <b></b>
                                    <small><strong>Ubicación:</strong> ${ubicacion}</small><br>
                                    <small><strong>Tipo:</strong> ${estacion.tipo?.nombre || 'N/A'} - ${estacion.subtipo?.nombre || 'N/A'}</small><br>
                                    <small><strong>Calidad:</strong> <span style="color:${color}; font-weight:bold">${calidad}</span></small><br>
                                    <button class='btn btn-sm btn-primary ver-detalles-btn mt-2 w-100'
                                            data-estacion-id='${estacion.id_estacion}'>
                                        <i class="fas fa-info-circle"></i> Ver detalles completos
                                    </button>
                                </div>
                            `;
                            
                            const marker = L.circleMarker([lat, lng], {
                                radius: 8,
                                fillColor: color,
                                color: '#ffffff',
                                weight: 2,
                                fillOpacity: 0.8
                            }).bindPopup(popup);
                            
                            // SOLO MOSTRAR POPUP AL HACER CLIC, NO EL MODAL
                            marker.on('click', function(e) {
                                // Solo abre el popup, no el modal
                                marker.openPopup();
                            });
                            
                            capasAgua.addLayer(marker);
                        } else {
                            console.warn('Estación sin coordenadas:', estacion.nombre);
                        }
                    });
                    
                    capasAgua.addTo(map);
                    console.log(`Cargadas ${estaciones.length} estaciones en el mapa`);
                })
                .catch(error => {
                    console.error("Error al cargar los datos:", error);
                    alert("Error al cargar los datos. Por favor intente más tarde.");
                });
        }

        function mostrarDetalles(estacion) {
            console.log('Mostrando detalles para:', estacion);
            
            const semaforoActual = estacion.semaforo && estacion.semaforo.length > 0 
                ? estacion.semaforo[0]
                : null;
            
            const ubicacion = estacion.municipio 
                ? `${estacion.municipio.nombre}, ${estacion.municipio.estado.nombre}`
                : 'Ubicación no especificada';
            
            document.getElementById('waterBodyTitle').textContent = estacion.nombre || 'Estación sin nombre';
            
            // Información básica
            let infoHTML = `
                <div class="parameter-row">
                    <span class="parameter-name">Clave Sitio:</span>
                    <span class="parameter-value">${estacion.clave_sitio}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Ubicación:</span>
                    <span class="parameter-value">${ubicacion}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Coordenadas:</span>
                    <span class="parameter-value">${estacion.latitud}, ${estacion.longitud}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Tipo de Cuerpo:</span>
                    <span class="parameter-value">${estacion.tipo?.nombre || 'N/A'} - ${estacion.subtipo?.nombre || 'N/A'}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Estado:</span>
                    <span class="parameter-value ${estacion.activo ? 'quality-good' : 'quality-bad'}">
                        ${estacion.activo ? 'Activo' : 'Inactivo'}
                    </span>
                </div>
            `;
            
            // Información de calidad del agua
            if (semaforoActual) {
                infoHTML += `
                    <div class="parameter-row">
                        <span class="parameter-name">Calidad del Agua:</span>
                        <span class="parameter-value ${getQualityClass(semaforoActual.color)}">
                            ${semaforoActual.color} - ${getQualityText(semaforoActual.color)}
                        </span>
                    </div>
                    <div class="parameter-row">
                        <span class="parameter-name">Contaminantes Detectados:</span>
                        <span class="parameter-value">${semaforoActual.contaminantes || 'No especificados'}</span>
                    </div>
                `;
            }
            
            document.getElementById('waterBodyInfo').innerHTML = infoHTML;
            
            // Recomendaciones de tratamiento
            document.getElementById('stepsContainer').innerHTML = generarRecomendacionesTratamiento(estacion);
            
            // Estado de aptitud
            const aptaStatus = determinarAptitud(estacion);
            document.getElementById('aptaStatus').textContent = aptaStatus.text;
            document.getElementById('aptaStatus').className = `parameter-value ${aptaStatus.class}`;
            
            // Información adicional
            document.getElementById('additionalInfo').innerHTML = generarInformacionAdicional(estacion);
            
            // Mostrar el panel
            document.getElementById('infoPanel').style.display = 'block';
            document.getElementById('infoPanel').scrollIntoView({ behavior: 'smooth' });
        }

        // Funciones auxiliares
        function getQualityClass(color) {
            switch(color.toUpperCase()) {
                case 'VERDE': return 'quality-good';
                case 'AMARILLO': return 'quality-moderate';
                case 'ROJO': return 'quality-bad';
                default: return '';
            }
        }

        function getQualityText(color) {
            switch(color.toUpperCase()) {
                case 'VERDE': return 'Buena calidad';
                case 'AMARILLO': return 'Calidad moderada';
                case 'ROJO': return 'Mala calidad';
                default: return 'Sin datos';
            }
        }

        function determinarAptitud(estacion) {
            const semaforoActual = estacion.semaforo && estacion.semaforo.length > 0 
                ? estacion.semaforo[0]
                : null;
            
            if (!semaforoActual) {
                return { text: 'Sin datos de calidad', class: 'quality-bad' };
            }
            
            switch(semaforoActual.color.toUpperCase()) {
                case 'VERDE':
                    return { text: 'Apta con tratamiento básico', class: 'quality-good' };
                case 'AMARILLO':
                    return { text: 'Apta con tratamiento moderado', class: 'quality-moderate' };
                case 'ROJO':
                    return { text: 'No apta sin tratamiento avanzado', class: 'quality-bad' };
                default:
                    return { text: 'Sin datos suficientes', class: 'quality-bad' };
            }
        }

        function generarRecomendacionesTratamiento(estacion) {
            const semaforoActual = estacion.semaforo && estacion.semaforo.length > 0 
                ? estacion.semaforo[0]
                : null;
            
            if (!semaforoActual) {
                return `
                    <div class="step-card">
                        <div class="step-title">Información Insuficiente</div>
                        <div class="step-desc">
                            <p>No hay datos recientes de calidad del agua para esta estación.</p>
                            <p>Se recomienda realizar mediciones actualizadas para generar recomendaciones específicas.</p>
                        </div>
                    </div>
                `;
            }
            
            let stepsHTML = '';
            const contaminantes = semaforoActual.contaminantes ? semaforoActual.contaminantes.split(',') : [];
            
            // Recomendaciones basadas en el color del semáforo
            switch(semaforoActual.color.toUpperCase()) {
                case 'VERDE':
                    stepsHTML = `
                        <div class="step-card">
                            <div class="step-title">Calidad Buena - Tratamiento Básico</div>
                            <div class="step-desc">
                                <ul>
                                    <li>Filtración con carbón activado</li>
                                    <li>Desinfección con cloro o luz UV</li>
                                    <li>Sedimentación simple</li>
                                    ${contaminantes.length > 0 ? `<li>Manejo específico para: ${contaminantes.join(', ')}</li>` : ''}
                                </ul>
                                <span class="badge bg-success">Recomendado: Consumo humano con tratamiento</span>
                            </div>
                        </div>
                    `;
                    break;
                    
                case 'AMARILLO':
                    stepsHTML = `
                        <div class="step-card">
                            <div class="step-title">Calidad Moderada - Tratamiento Intermedio</div>
                            <div class="step-desc">
                                <ul>
                                    <li>Coagulación y floculación</li>
                                    <li>Filtración múltiple (arena, carbón)</li>
                                    <li>Desinfección con ozono o UV intensivo</li>
                                    <li>Tratamiento biológico secundario</li>
                                    ${contaminantes.length > 0 ? `<li>Tratamiento específico para: ${contaminantes.join(', ')}</li>` : ''}
                                </ul>
                                <span class="badge bg-warning">Recomendado: Riego y uso industrial</span>
                            </div>
                        </div>
                    `;
                    break;
                    
                case 'ROJO':
                    stepsHTML = `
                        <div class="step-card">
                            <div class="step-title">Calidad Mala - Tratamiento Avanzado</div>
                            <div class="step-desc">
                                <ul>
                                    <li>Tratamiento terciario avanzado</li>
                                    <li>Ósmosis inversa</li>
                                    <li>Oxidación avanzada (AOPs)</li>
                                    <li>Filtración por membranas</li>
                                    <li>Desinfección múltiple</li>
                                    ${contaminantes.length > 0 ? `<li>Tratamiento intensivo para: ${contaminantes.join(', ')}</li>` : ''}
                                </ul>
                                <span class="badge bg-danger">No apta para consumo sin tratamiento avanzado</span>
                            </div>
                        </div>
                    `;
                    break;
                    
                default:
                    stepsHTML = '<p>No se pueden generar recomendaciones específicas.</p>';
            }
            
            return stepsHTML;
        }

        function generarInformacionAdicional(estacion) {
            const mediciones = estacion.mediciones || [];
            
            let medicionesHTML = '';
            if (mediciones.length > 0) {
                medicionesHTML = `
                    <div class="info-card">
                        <div class="info-card-header">
                            <i class="fas fa-flask"></i> <span>Últimas Mediciones</span>
                        </div>
                        <div class="info-card-body">
                            ${mediciones.slice(0, 5).map(med => `
                                <div class="medicion-item">
                                    <strong>${med.parametro.nombre}</strong>: ${med.valor} ${med.parametro.unidad}<br>
                                    <small><strong>Descripción:</strong> ${med.parametro.descripcion || 'Sin descripción disponible'}</small><br>
                                    <small><strong>Clasificación:</strong> ${med.clasificacion}</small>
                                </div>
                            `).join('')}
                            ${mediciones.length > 5 ? `<p><small>+ ${mediciones.length - 5} mediciones más</small></p>` : ''}
                        </div>
                    </div>
                `;
            }
            
            return `
                <div class="mt-3">
                    <div class="info-cards-group">
                        <div class="info-card">
                            <div class="info-card-header">
                                <i class="fas fa-info-circle"></i> <span>Información General</span>
                            </div>
                            <div class="info-card-body">
                                <p><strong>Tipo:</strong> ${estacion.tipo?.nombre || 'N/A'}</p>
                                <p><strong>Subtipo:</strong> ${estacion.subtipo?.nombre || 'N/A'}</p>
                                <p><strong>Estado monitoreo:</strong> ${estacion.activo ? '🟢 Activo' : '🔴 Inactivo'}</p>
                            </div>
                        </div>
                        
                        ${medicionesHTML}
                        
                        <div class="info-card">
                            <div class="info-card-header">
                                <i class="fas fa-water"></i> <span>Ubicación</span>
                            </div>
                            <div class="info-card-body">
                                <p><strong>Municipio:</strong> ${estacion.municipio?.nombre || 'No especificado'}</p>
                                <p><strong>Estado:</strong> ${estacion.municipio?.estado?.nombre || 'No especificado'}</p>
                                <p><strong>Cuenca:</strong> ${estacion.cuenca?.nombre || 'No especificada'}</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function cerrarPanel() {
            document.getElementById('infoPanel').style.display = 'none';
        }

        function obtenerUbi() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        currentLocation = [position.coords.latitude, position.coords.longitude];
                        map.setView(currentLocation, 13);
                        
                        if (ubicacionMarker) {
                            map.removeLayer(ubicacionMarker);
                        }
                        
                        ubicacionMarker = L.marker(currentLocation, {
                            icon: L.divIcon({
                                className: 'user-location-marker',
                                html: '<i class="fas fa-user" style="color: #0077b6; font-size: 24px;"></i>',
                                iconSize: [24, 24]
                            })
                        }).addTo(map)
                        .bindPopup('Tu ubicación actual').openPopup();
                    },
                    function(error) {
                        console.error("Error al obtener ubicación:", error);
                        alert("No se pudo obtener tu ubicación.");
                    }
                );
            } else {
                alert("La geolocalización no está soportada en tu navegador.");
            }
        }

        // Función de búsqueda
        function buscarCuerposAgua(query) {
            if (!cuerposAguaOriginal || !Array.isArray(cuerposAguaOriginal)) {
                console.warn('No hay datos para buscar');
                return;
            }
            
            query = query.trim().toLowerCase();
            if (!query) {
                // Si no hay query, mostrar todos
                if (capasAgua) {
                    map.removeLayer(capasAgua);
                    capasAgua.addTo(map);
                }
                return;
            }
            
            const resultados = cuerposAguaOriginal.filter(estacion => {
                const nombre = estacion.nombre ? estacion.nombre.toLowerCase() : '';
                const clave = estacion.clave_sitio ? estacion.clave_sitio.toLowerCase() : '';
                const municipio = estacion.municipio ? estacion.municipio.nombre.toLowerCase() : '';
                const estado = estacion.municipio?.estado ? estacion.municipio.estado.nombre.toLowerCase() : '';
                
                return nombre.includes(query) || 
                       clave.includes(query) || 
                       municipio.includes(query) || 
                       estado.includes(query);
            });
            
            console.log(`Búsqueda: "${query}" - Encontrados: ${resultados.length} resultados`);
            
            // Actualizar el mapa con los resultados
            if (capasAgua) {
                map.removeLayer(capasAgua);
            }
            
            capasAgua = L.layerGroup();
            resultados.forEach(estacion => {
                if (estacion.latitud && estacion.longitud) {
                    let lat = parseFloat(estacion.latitud);
                    let lng = parseFloat(estacion.longitud);
                    
                    if (isNaN(lat) || isNaN(lng)) return;
                    
                    // Determina color según semáforo
                    const semaforoActual = estacion.semaforo && estacion.semaforo.length > 0 
                        ? estacion.semaforo[0]
                        : null;
                    
                    let color = '#007bff';
                    if (semaforoActual) {
                        switch(semaforoActual.color.toUpperCase()) {
                            case 'VERDE': color = '#28a745'; break;
                            case 'AMARILLO': color = '#ffc107'; break;
                            case 'ROJO': color = '#dc3545'; break;
                        }
                    }
                    
                    const marker = L.circleMarker([lat, lng], {
                        radius: 10,
                        fillColor: color,
                        color: '#ffffff',
                        weight: 2,
                        fillOpacity: 0.8
                    }).bindPopup(`
                        <div style="min-width: 250px">
                            <b>${estacion.nombre}</b><br>
                            <small>${estacion.clave_sitio}</small><br>
                            <button class='btn btn-sm btn-primary ver-detalles-btn mt-2 w-100'
                                    data-estacion-id='${estacion.id_estacion}'>
                                Ver detalles completos
                            </button>
                        </div>
                    `);
                    
                    // SOLO MOSTRAR POPUP AL HACER CLIC, NO EL MODAL
                    marker.on('click', function(e) {
                        marker.openPopup();
                    });
                    
                    capasAgua.addLayer(marker);
                }
            });
            
            capasAgua.addTo(map);
            
            // Centrar en los resultados si hay
            if (resultados.length > 0 && resultados[0].latitud && resultados[0].longitud) {
                const lat = parseFloat(resultados[0].latitud);
                const lng = parseFloat(resultados[0].longitud);
                if (!isNaN(lat) && !isNaN(lng)) {
                    map.setView([lat, lng], 10);
                }
            }
        }

        // Función para manejar clics en botones de detalles
        function manejarClicDetalles(estacionId) {
            const estacion = cuerposAguaOriginal.find(e => e.id_estacion == estacionId);
            if (estacion) {
                mostrarDetalles(estacion);
                // Cerrar el popup cuando se abre el modal
                map.closePopup();
            }
        }

        // Inicialización de event listeners
        function inicializarEventListeners() {
            // Botón de búsqueda
            document.getElementById('searchButton').addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const query = document.getElementById('searchInput').value.trim();
                buscarCuerposAgua(query);
            });

            // Botón de ubicación
            document.getElementById('locationButton').addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                obtenerUbi();
            });

            // Botón cerrar panel
            document.getElementById('closePanel').addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                cerrarPanel();
            });

            // Botones de detalles en los popups - DELEGACIÓN DE EVENTOS
            document.addEventListener('click', function(e) {
                if (e.target.classList.contains('ver-detalles-btn') || 
                    e.target.closest('.ver-detalles-btn')) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const btn = e.target.classList.contains('ver-detalles-btn') ? 
                               e.target : e.target.closest('.ver-detalles-btn');
                    
                    const estacionId = btn.getAttribute('data-estacion-id');
                    if (estacionId) {
                        manejarClicDetalles(estacionId);
                    }
                }
            });

            // Permitir búsqueda con Enter
            document.getElementById('searchInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const query = this.value.trim();
                    buscarCuerposAgua(query);
                }
            });
        }

        // Inicializar cuando el DOM esté listo
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM cargado, iniciando mapa...');
            inicializarEventListeners();
            cargarCuerposAgua();
        });

        // También intentar cargar si el DOM ya está listo
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            console.log('DOM ya listo, iniciando mapa...');
            inicializarEventListeners();
            cargarCuerposAgua();
        }
    </script>

</body>
</html>