                                </div>

                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700 mb-3">Contraseña</label>
                                    <input 
                                        type="password" 
                                        id="contrasena" 
                                        name="contrasena"
                                        placeholder="Dejar en blanco para mantener la contraseña actual"
