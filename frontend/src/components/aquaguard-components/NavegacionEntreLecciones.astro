---
// src/components/aquaguard-components/NavegacionEntreLecciones.astro

const API_URL = import.meta.env.PUBLIC_API_URL;

// 1. DEFINICIÓN DE TIPOS
export interface Leccion {
    id_leccion: number | string;
    modulo_id: number;
    titulo: string;
    tipo_contenido: string;
    contenido_texto?: string;
    video_url?: string | null;
    orden: number;
    duracion_min?: number;
    completado?: boolean;
    bloqueado?: boolean;
}

export interface Modulo {
    id_modulo: number | string;
    curso_id: number;
    titulo: string;
    orden: number;
    lecciones: Leccion[];
    completado?: boolean;
}

export interface Curso {
    modulos: Modulo[];
}

// 2. Obtener el ID del curso de la URL
const url = Astro.url;
const pathParts = url.pathname.split("/").filter((part) => part !== "");

// Buscar el índice del cursoId de forma más robusta
let cursoId: string | null = null;

// Diferentes patrones de URL posibles
if (url.pathname.includes("/admin/cursos/")) {
    // Para URLs como /admin/cursos/9/lecciones
    const cursosIndex = pathParts.indexOf("cursos");
    if (cursosIndex !== -1 && pathParts[cursosIndex + 1]) {
        cursoId = pathParts[cursosIndex + 1];
    }
} else if (url.pathname.includes("/curso/")) {
    // Para URLs como /curso/9/leccion
    const cursoIndex = pathParts.indexOf("curso");
    if (cursoIndex !== -1 && pathParts[cursoIndex + 1]) {
        cursoId = pathParts[cursoIndex + 1];
    }
}

// Si no encontramos con los patrones anteriores, usar índice por defecto
if (!cursoId && pathParts.length > 1) {
    cursoId = pathParts[1]; // Fallback
}

// 3. Función para cargar los módulos desde la API
async function cargarModulos(cursoId: string | number): Promise<Modulo[]> {
    const apiUrl = `${API_URL}/api/cursos/${cursoId}/modulos-y-lecciones`;

    try {
        const response = await fetch(apiUrl);

        if (!response.ok) {
            throw new Error(
                `Error al cargar módulos: ${response.status} ${response.statusText}`,
            );
        }

        const data = await response.json();

        // Verificar la estructura de los datos
        if (Array.isArray(data)) {
            return data;
        } else {
            return [];
        }
    } catch (error) {
        console.error("❌ Error cargando módulos:", error);
        // Mostrar más detalles del error
        if (error instanceof Error) {
            console.error("🔍 Detalles del error:", error.message);
        }
        return [];
    }
}

// 4. Función para cargar el progreso del usuario
async function cargarProgresoUsuario(
    cursoId: string | number,
    usuarioId: number = 1,
): Promise<number[]> {
    try {
        const response = await fetch(
            `https://aquaguardv1.onrender.com/api/progreso-lecciones/usuario/${usuarioId}/curso/${cursoId}`,
        );

        if (!response.ok) {
            console.warn("No se pudo cargar el progreso del usuario");
            return [];
        }

        const data = await response.json();
        // Extraer solo los IDs de lecciones completadas
        return data.map((progreso: any) => progreso.leccion_id);
    } catch (error) {
        console.warn("Error cargando progreso del usuario:", error);
        return [];
    }
}

// 5. Función para aplicar lógica de bloqueo
function aplicarLogicaBloqueo(
    modulos: Modulo[],
    leccionesCompletadasIds: number[],
): Modulo[] {
    return modulos.map((modulo, moduloIndex) => {
        const leccionesConBloqueo = modulo.lecciones.map(
            (leccion, leccionIndex) => {
                // Verificar si la lección está completada
                const estaCompletada = leccionesCompletadasIds.includes(
                    Number(leccion.id_leccion),
                );

                // Determinar si está bloqueada
                let estaBloqueada = false;

                // Si es la primera lección del primer módulo, nunca está bloqueada
                if (moduloIndex === 0 && leccionIndex === 0) {
                    estaBloqueada = false;
                }
                // Si no es la primera lección, verificar si la lección anterior está completada
                else if (leccionIndex > 0) {
                    const leccionAnterior = modulo.lecciones[leccionIndex - 1];
                    const leccionAnteriorCompletada =
                        leccionesCompletadasIds.includes(
                            Number(leccionAnterior.id_leccion),
                        );
                    estaBloqueada = !leccionAnteriorCompletada;
                }
                // Si es la primera lección de un módulo posterior, verificar si el módulo anterior está completado
                else if (moduloIndex > 0 && leccionIndex === 0) {
                    const moduloAnterior = modulos[moduloIndex - 1];
                    const moduloAnteriorCompletado =
                        moduloAnterior.lecciones.every((l) =>
                            leccionesCompletadasIds.includes(
                                Number(l.id_leccion),
                            ),
                        );
                    estaBloqueada = !moduloAnteriorCompletado;
                }

                return {
                    ...leccion,
                    completado: estaCompletada,
                    bloqueado: estaBloqueada,
                };
            },
        );

        // Verificar si el módulo está completado
        const moduloCompletado = leccionesConBloqueo.every(
            (leccion) => leccion.completado,
        );

        return {
            ...modulo,
            lecciones: leccionesConBloqueo,
            completado: moduloCompletado,
        };
    });
}

// 6. Cargar los módulos y progreso
let modulos: Modulo[] = [];
let errorCarga: string | null = null;

if (cursoId) {
    try {
        // Cargar módulos y progreso en paralelo
        const [modulosData, progresoUsuario] = await Promise.all([
            cargarModulos(cursoId),
            cargarProgresoUsuario(cursoId, 1), // usuarioId hardcodeado por ahora
        ]);

        // Aplicar lógica de bloqueo
        modulos = aplicarLogicaBloqueo(modulosData, progresoUsuario);

        console.log("📊 Progreso del usuario:", progresoUsuario);
        console.log("🔒 Módulos con bloqueo aplicado:", modulos);
    } catch (error) {
        errorCarga =
            error instanceof Error ? error.message : "Error desconocido";
        modulos = [];
    }
} else {
    errorCarga = "No se pudo detectar el ID del curso";
}

// 7. Obtener lección actual de la URL
let leccionActualId: string | number | null = null;

// Buscar lección actual en la URL
if (url.pathname.includes("/leccion/")) {
    const leccionIndex = pathParts.indexOf("leccion");
    if (leccionIndex !== -1 && pathParts[leccionIndex + 1]) {
        leccionActualId = pathParts[leccionIndex + 1];
    }
}

// 8. LÓGICA DE UX (Servidor) - Adaptada a la estructura de la API
const moduloAbierto = new Map<string | number, boolean>();
let moduloActualEncontrado = false;

// Crear estructura de curso para el componente
const curso: Curso = {
    modulos: modulos.map((modulo) => ({
        ...modulo,
        // Mapear propiedades para compatibilidad
        lecciones: modulo.lecciones.map((leccion) => ({
            ...leccion,
            completado: leccion.completado || false,
            bloqueado: leccion.bloqueado || false,
        })),
        completado: modulo.completado || false,
    })),
};

for (const modulo of curso.modulos) {
    const estaActivo = modulo.lecciones.some(
        (l) => l.id_leccion.toString() === leccionActualId?.toString(),
    );
    moduloAbierto.set(modulo.id_modulo, estaActivo);
    if (estaActivo) moduloActualEncontrado = true;
}

// Si ninguna lección está activa, abre el primer módulo por defecto
if (!moduloActualEncontrado && curso.modulos.length > 0) {
    moduloAbierto.set(curso.modulos[0].id_modulo, true);
}
---

<aside
    class="p-6 bg-white dark:bg-gray-900 rounded-lg shadow-lg w-full max-w-md"
>
    <h3
        class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-3"
    >
        <div
            class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center flex-shrink-0"
