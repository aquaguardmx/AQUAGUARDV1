                                </div>
                                <div class="w-full bg-blue-400/30 rounded-full h-3">
                                    <div id="progress-cursos" class="bg-gradient-to-r from-green-400 to-emerald-500 h-3 rounded-full shadow-lg shadow-green-500/25" style="width: 42%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm font-medium mb-2">
                                    <span class="text-blue-100">Horas de Estudio</span>
                                    <span id="stat-horas-total" class="text-white">87h</span>
                                </div>
                                <div class="w-full bg-blue-400/30 rounded-full h-3">
                                    <div id="progress-horas" class="bg-gradient-to-r from-blue-400 to-cyan-500 h-3 rounded-full shadow-lg shadow-blue-500/25" style="width: 65%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm font-medium mb-2">
                                    <span class="text-blue-100">Logros Desbloqueados</span>
                                    <span id="stat-logros-total" class="text-white">8/15</span>
                                </div>
                                <div class="w-full bg-blue-400/30 rounded-full h-3">
                                    <div id="progress-logros" class="bg-gradient-to-r from-purple-400 to-fuchsia-500 h-3 rounded-full shadow-lg shadow-purple-500/25" style="width: 53%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6 pt-6 border-t border-blue-400/30">
                            <div class="text-center">
