---
// src/pages/detalle-curso/[id].astro
import Layout from '../../layouts/Layout.astro';

// --- Interfaces (Autor, Categoria, Curso) ---
interface Autor {
  id_usuario: number;
  nombre: string;
}
interface Categoria {
  id: number;
  nombre: string;
  slug: string;
}
interface Curso {
  id_curso: number;
  titulo: string;
  descripcion: string;
  portada_url: string | null;
  tiempo_estimado_min: number;
  autor: Autor;
  categoria: Categoria;
  publicado: boolean;
}

const { id } = Astro.params;

// --- Lógica de Fetch ---
let curso: Curso | null = null;
let fetchError = false;

try {
  const response = await fetch(`http://localhost:8000/api/cursos/${id}`);
  
  if (response.ok) {
    const data = await response.json();
    console.log('Datos recibidos del API:', data);
    curso = data; 
  } else {
    fetchError = true;
    console.error('Error en la respuesta:', response.status);
  }
} catch (error: any) {
  fetchError = true;
  console.error('Error de conexión:', error.message);
}
