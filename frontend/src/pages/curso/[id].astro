---
// src/pages/curso/[id].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";
import ContenidoPrincipal from "../../components/aquaguard-components/ContenidoPrincipal.astro";
import ModulosSidebar from "../../components/aquaguard-components/ModuloSidebar.astro";

const { id } = Astro.params;
const usuarioId = 1; // Por ahora hardcodeado, luego puedes obtenerlo de la sesión

// Hacer fetch a la API del curso
let curso = null;
let progresoUsuario = null;
let error = null;

try {
  // Fetch paralelo para el curso y el progreso
  const [cursoResponse, progresoResponse] = await Promise.all([
    fetch(`https://aquaguardv1.onrender.com/api/cursos/${id}`),
    fetch(`https://aquaguardv1.onrender.com/api/progreso-lecciones/usuario/${usuarioId}/curso/${id}`)
  ]);
  
  if (!cursoResponse.ok) {
    throw new Error(`Error ${cursoResponse.status}: ${cursoResponse.statusText}`);
  }
  
  const cursoData = await cursoResponse.json();
  
  // Obtener progreso del usuario si la respuesta es exitosa
  if (progresoResponse.ok) {
    progresoUsuario = await progresoResponse.json();
  } else {
    console.warn('No se pudo obtener el progreso del usuario:', progresoResponse.status);
    progresoUsuario = [];
  }
  
  // Transformar los datos de la API al formato que esperan tus componentes
  curso = transformarDatosCurso(cursoData, progresoUsuario);
  
} catch (err: any) {
  console.error('Error fetching curso:', err);
  error = err.message;
}

// Función para encontrar la siguiente lección no completada
function encontrarSiguienteLeccion(modulos: any[]) {
  for (const modulo of modulos) {
    for (const leccion of modulo.lecciones) {
      if (!leccion.completado && !leccion.bloqueado) {
        return {
          id_leccion: leccion.id_leccion,
          id_modulo: modulo.id_modulo,
          titulo: leccion.titulo
        };
      }
    }
  }
  return null;
}

// Función para encontrar la primera lección del curso
function encontrarPrimeraLeccion(modulos: any[]) {
  if (modulos.length > 0 && modulos[0].lecciones.length > 0) {
    const primeraLeccion = modulos[0].lecciones[0];
    return {
      id_leccion: primeraLeccion.id_leccion,
      id_modulo: modulos[0].id_modulo,
      titulo: primeraLeccion.titulo
    };
  }
  return null;
}

// Función para transformar los datos de la API al formato esperado
function transformarDatosCurso(cursoAPI: any, progresoUsuario: any[]) {
  // Obtener IDs de lecciones completadas
  const leccionesCompletadasIds = progresoUsuario.map((progreso: any) => progreso.leccion_id);
  
  // DEBUG: Mostrar información del progreso
  console.log('Lecciones completadas IDs:', leccionesCompletadasIds);
  console.log('Total de lecciones completadas:', leccionesCompletadasIds.length);
  
  // Transformar módulos y lecciones al formato esperado
  const modulosTransformados = cursoAPI.modulos.map((modulo: any) => {
    const leccionesTransformadas = modulo.lecciones.map((leccion: any) => {
      const leccionCompletada = leccionesCompletadasIds.includes(leccion.id_leccion);
      
      // DEBUG: Mostrar estado de cada lección
      console.log(`Lección ${leccion.id_leccion}: ${leccion.titulo} - Completada: ${leccionCompletada}`);
      
      return {
        id_leccion: leccion.id_leccion,
        titulo: leccion.titulo,
        descripcion: extraerDescripcion(leccion.contenido_texto),
        duracion_min: 15, // Valor por defecto, podrías calcularlo
        tipo: mapearTipoContenido(leccion.tipo_contenido),
        url_contenido: leccion.video_url || '#',
        completado: leccionCompletada,
        bloqueado: false, // Lógica de bloqueo basada en progreso
        // Mantener datos originales de la API para el contenido
        contenido_original: {
          tipo_contenido: leccion.tipo_contenido,
          contenido_texto: leccion.contenido_texto,
          video_url: leccion.video_url
        }
      };
    });
    
    // Un módulo está completado si todas sus lecciones están completadas
    const moduloCompletado = leccionesTransformadas.every((leccion: any) => leccion.completado);
    
    return {
      id_modulo: modulo.id_modulo,
      titulo: modulo.titulo,
      descripcion: `Módulo ${modulo.orden} del curso ${cursoAPI.titulo}`,
      orden: modulo.orden,
      completado: moduloCompletado,
      lecciones: leccionesTransformadas
    };
  });

  // Calcular progreso total basado en lecciones completadas
  const totalLecciones = modulosTransformados.reduce((total: number, modulo: any) => 
    total + modulo.lecciones.length, 0);
  const leccionesCompletadas = modulosTransformados.reduce((total: number, modulo: any) => 
    total + modulo.lecciones.filter((l: any) => l.completado).length, 0);
  const progreso_total = totalLecciones > 0 ? Math.round((leccionesCompletadas / totalLecciones) * 100) : 0;

  // Encontrar siguiente lección y primera lección
  const siguienteLeccion = encontrarSiguienteLeccion(modulosTransformados);
  const primeraLeccion = encontrarPrimeraLeccion(modulosTransformados);

  // DEBUG: Mostrar estadísticas finales
  console.log('Estadísticas finales:', {
    totalLecciones,
    leccionesCompletadas,
    progreso_total,
    tieneProgreso: leccionesCompletadas > 0
  });

  return {
    id_curso: cursoAPI.id_curso,
    titulo: cursoAPI.titulo,
    descripcion: cursoAPI.descripcion,
    portada_url: `https://aquaguardv1.onrender.com/storage/${cursoAPI.portada_url}`,
    instructor: `${cursoAPI.autor.nombre} ${cursoAPI.autor.ap_paterno}`,
    categoria: cursoAPI.categoria.nombre,
    progreso_total: progreso_total,
    modulos: modulosTransformados,
    // Datos calculados para fácil acceso
    estadisticas: {
      totalLecciones: totalLecciones,
      leccionesCompletadas: leccionesCompletadas,
      totalModulos: modulosTransformados.length,
      modulosCompletados: modulosTransformados.filter((m: any) => m.completado).length,
      leccionesRestantes: totalLecciones - leccionesCompletadas,
      tieneProgreso: leccionesCompletadas > 0 // CORREGIDO: usar leccionesCompletadas en lugar de progresoUsuario.length
    },
    // Información de navegación
    navegacion: {
      siguienteLeccion: siguienteLeccion,
      primeraLeccion: primeraLeccion
    },
    // Mantener datos adicionales de la API
    datos_originales: {
      tiempo_estimado_min: cursoAPI.tiempo_estimado_min,
      objetivos_aprendizaje: cursoAPI.objetivos_aprendizaje,
      autor: cursoAPI.autor,
      categoria: cursoAPI.categoria
    }
  };
}

// Función para extraer una descripción breve del contenido
function extraerDescripcion(contenidoTexto: string) {
  if (!contenidoTexto) return 'Contenido de la lección';
  
  // Limpiar HTML tags y tomar los primeros 100 caracteres
  const textoLimpio = contenidoTexto.replace(/<[^>]*>/g, '');
  return textoLimpio.length > 100 ? textoLimpio.substring(0, 100) + '...' : textoLimpio;
}

// Función para mapear tipos de contenido
function mapearTipoContenido(tipoAPI: string) {
  const mapeo: Record<string, string> = {
    'texto': 'lectura',
    'mixto': 'video',
    'video': 'video',
    'quiz': 'quiz'
  };
  return mapeo[tipoAPI] || 'lectura';
}

// Manejar caso de error
if (error) {
  // Puedes redirigir a una página 404 o mostrar un mensaje de error
  console.error('Error cargando el curso:', error);
}

// Solo calcular esto si el curso se cargó correctamente
const todosLosModulosCompletados = curso ? curso.modulos.slice(0, -1).every((modulo: any) => modulo.completado) : false;
const quiz = curso ? curso.modulos.find((mod: any) => mod.lecciones.some((lec: any) => lec.tipo === 'quiz'))?.lecciones.find((lec: any) => lec.tipo === 'quiz') : null;

// DEBUG: Verificar el estado final del curso
if (curso) {
  console.log('=== ESTADO FINAL DEL CURSO ===');
  console.log('Progreso total:', curso.progreso_total + '%');
  console.log('Lecciones completadas:', curso.estadisticas.leccionesCompletadas);
  console.log('Tiene progreso:', curso.estadisticas.tieneProgreso);
  console.log('Siguiente lección:', curso.navegacion.siguienteLeccion);
  console.log('Primera lección:', curso.navegacion.primeraLeccion);
}
---

<Layout title={curso?.titulo || 'Curso no encontrado'}>
  <Header />

  {error ? (
    <!-- Mostrar error si la API falla -->
    <div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
      <div class="text-center">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Error al cargar el curso</h1>
        <p class="text-gray-600 dark:text-gray-400 mb-6">{error}</p>
        <a href="/cursos" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition-colors">
          Volver a los cursos
        </a>
      </div>
    </div>
  ) : !curso ? (
    <!-- Mostrar loading -->
    <div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
      <div class="text-center">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
        <p class="text-gray-600 dark:text-gray-400">Cargando curso...</p>
      </div>
    </div>
  ) : (
    <!-- Contenido principal cuando el curso se carga correctamente -->
    <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
      <!-- Hero Section del Curso -->
      <section
        class="bg-gradient-to-br from-blue-900 via-blue-800 to-teal-700 text-white"
      >
        <div class="container mx-auto px-6 py-12">
          <div class="flex flex-col lg:flex-row items-start gap-8">
            <!-- Imagen y info principal -->
            <div class="flex-1">
              <nav class="flex items-center gap-2 text-blue-200 mb-6">
                <a href="/" class="hover:text-white transition-colors">Inicio</a>
                <span>›</span>
                <a href="/cursos" class="hover:text-white transition-colors"
                  >Cursos</a
                >
                <span>›</span>
                <span class="text-white font-semibold">{curso.titulo}</span>
              </nav>

              <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">
                {curso.titulo}
              </h1>
              <p class="text-xl text-blue-100 mb-6 leading-relaxed">
                {curso.descripcion}
              </p>

              <div class="flex flex-wrap gap-6 items-center">
                <div class="flex items-center gap-3">
                  <div
                    class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center font-bold text-white shadow-lg"
                  >
                    {curso.instructor.split(' ').map((n: string) => n[0]).join('')}
                  </div>
                  <div>
                    <p class="font-semibold text-lg">{curso.instructor}</p>
                    <p class="text-blue-200 text-sm">Instructor especializado</p>
                  </div>
                </div>
                <div
                  class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      fill-rule="evenodd"
                      d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>{curso.categoria}</span>
                </div>
              </div>
            </div>

            <!-- Progress Card -->
            <div
              class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 lg:w-80 border border-white/20"
            >
              <div class="text-center mb-6">
                <div class="relative inline-block">
                  <svg class="w-24 h-24 transform -rotate-90">
                    <circle
                      cx="48"
                      cy="48"
                      r="40"
                      stroke="rgba(255,255,255,0.3)"
                      stroke-width="8"
                      fill="none"></circle>
                    <circle
                      cx="48"
                      cy="48"
                      r="40"
                      stroke="white"
                      stroke-width="8"
                      fill="none"
                      stroke-dasharray="251.2"
                      stroke-dashoffset={251.2 * (1 - curso.progreso_total / 100)}
                    ></circle>
                  </svg>
                  <span
                    class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white font-bold text-xl"
                  >
                    {curso.progreso_total}%
                  </span>
                </div>
              </div>

              <div class="space-y-4">
                <div class="flex justify-between text-sm">
                  <span class="text-blue-200">Progreso Total</span>
                  <span class="font-semibold">{curso.progreso_total}%</span>
                </div>

                <div class="flex justify-between text-sm">
                  <span class="text-blue-200">Módulos Completados</span>
                  <span class="font-semibold">
                    {curso.estadisticas.modulosCompletados}/{
                      curso.estadisticas.totalModulos
                    }
                  </span>
                </div>

                <div class="flex justify-between text-sm">
                  <span class="text-blue-200">Lecciones Completadas</span>
                  <span class="font-semibold">
                    {curso.estadisticas.leccionesCompletadas}/{
                      curso.estadisticas.totalLecciones
                    }
                  </span>
                </div>

                <div class="flex justify-between text-sm">
                  <span class="text-blue-200">Lecciones Restantes</span>
                  <span class="font-semibold">
                    {curso.estadisticas.leccionesRestantes}
                  </span>
                </div>
              </div>

              <!-- DEBUG: Mostrar información del estado del botón -->
              <div class="mt-4 p-2 bg-white/5 rounded-lg text-xs">
                <div>Lecciones completadas: {curso.estadisticas.leccionesCompletadas}</div>
                <div>Tiene progreso: {curso.estadisticas.tieneProgreso ? 'Sí' : 'No'}</div>
                <div>Próxima lección: {curso.navegacion.siguienteLeccion?.id_leccion || 'Ninguna'}</div>
              </div>

              {curso.estadisticas.leccionesRestantes === 0 ? (
                <!-- Curso completado -->
                <button
                  class="w-full mt-6 bg-green-500 text-white hover:bg-green-600 font-semibold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg"
                >
                  ¡Curso Completado!
                </button>
              ) : curso.estadisticas.tieneProgreso ? (
                <!-- Continuar curso (ya hay progreso) -->
                <a
                  href={`/curso/${curso.id_curso}/leccion/${curso.navegacion.siguienteLeccion?.id_leccion || curso.navegacion.primeraLeccion?.id_leccion}`}
                  class="w-full mt-6 bg-blue-600 text-white hover:bg-blue-700 font-semibold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg flex items-center justify-center"
                >
                  Continuar Curso
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              ) : (
                <!-- Comenzar curso (sin progreso) -->
                <a
                  href={`/curso/${curso.id_curso}/leccion/${curso.navegacion.primeraLeccion?.id_leccion}`}
                  class="w-full mt-6 bg-white text-blue-600 hover:bg-blue-50 font-semibold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg flex items-center justify-center"
                >
                  Comenzar Curso
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>
      </section>

      <!-- Contenido Principal -->
      <main class="container mx-auto px-6 py-8">
        <div class="flex flex-col lg:flex-row gap-8">
          <!-- Sidebar de Navegación -->
          <div class="lg:w-1/3">
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg sticky top-8 border border-gray-200 dark:border-gray-700"
            >
              <ModulosSidebar modulos={curso.modulos} cursoId={curso.id_curso} />
            </div>
          </div>

          <!-- Área de Contenido -->
          <div class="lg:w-2/3">
            <ContenidoPrincipal curso={curso} />
          </div>
        </div>
      </main>
    </div>
  )}

  <Footer />
</Layout>

<style>
  .sticky {
    position: sticky;
  }

  /* Animaciones suaves */
  .transition-all {
    transition: all 0.3s ease;
  }

  /* Mejoras de accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .transition-all,
    .transform {
      transition: none;
      transform: none;
    }
  }

  /* Efectos hover mejorados */
  .hover\\:scale-105:hover {
    transform: scale(1.05);
  }

  /* Scroll suave */
  html {
    scroll-behavior: smooth;
  }
</style>