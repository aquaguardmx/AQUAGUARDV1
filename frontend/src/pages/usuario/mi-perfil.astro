---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";

const API_URL = import.meta.env.PUBLIC_API_URL;

// Removí lógica localStorage de frontmatter (es client-only). Usar placeholders por default.
let user = {
    nombre: "",
    ap_paterno: "",
    ap_materno: "",
    correo_electronico: "",
    id_rol: 2,
    id_usuario: null,
    pais: "México",
    idioma_preferido: "Español",
}; // Placeholder para SSR

// Función para obtener el nombre del rol
function getRoleName(idRol: number): string {
    const roles: { [key: number]: string } = {
        1: "Administrador",
        2: "Usuario",
        3: "Docente",
    };
    return roles[idRol] || "Usuario";
}

// Helper functions para manejar datos del usuario de forma segura (usar en SSR)
function getUserNombre() {
    return user.nombre || user.nombre || "";
}

function getUserApPaterno() {
    return user.ap_paterno || "";
}

function getUserApMaterno() {
    return user.ap_materno || "";
}

function getUserEmail() {
    return (
        user.correo_electronico ||
        user.correo_electronico ||
        "Correo no disponible"
    );
}

function getUserInitial() {
    const nombre = getUserNombre();
    return nombre ? nombre.charAt(0).toUpperCase() : "U";
}

function getUserFullName() {
    const nombre = getUserNombre();
    const apPaterno = getUserApPaterno();
    const apMaterno = getUserApMaterno();
    return `${nombre} ${apPaterno} ${apMaterno}`.trim() || "Usuario";
}
---

<Layout title="Mi Perfil">
    <!-- Header -->
    <Header />

    <!-- Enhanced Breadcrumb -->
    <nav
        class="bg-gradient-to-r from-blue-50 via-indigo-50 to-purple-50 py-5 border-b border-blue-100 shadow-sm"
    >
        <div class="container mx-auto px-4">
            <div class="flex items-center space-x-3 text-sm">
                <a
                    href="/usuario/index-elearning"
                    class="text-blue-600 hover:text-blue-800 transition-all duration-300 font-medium flex items-center group"
                >
                    <i
                        class="fas fa-home mr-2 text-blue-500 group-hover:scale-110 transition-transform"
                    ></i>
                    Inicio
                </a>
                <span class="text-blue-300"
                    ><i class="fas fa-chevron-right text-xs"></i></span
                >
                <a
                    href="/usuario/mis-cursos"
                    class="text-blue-600 hover:text-blue-800 transition-all duration-300 font-medium flex items-center group"
                >
                    <i
                        class="fas fa-user mr-2 text-blue-500 group-hover:scale-110 transition-transform"
                    ></i>
                    Mi Cuenta
                </a>
                <span class="text-blue-300"
