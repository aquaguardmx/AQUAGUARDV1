                    <h4 class="font-bold text-gray-800 dark:text-gray-200 mb-4 flex items-center gap-2 text-lg">
                        <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Configuración del Quiz
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2 flex items-center gap-1">
                                <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Puntaje mínimo para aprobar (%)
                            </label>
                            <div class="relative">
                                <input 
                                    type="number" 
                                    id="puntaje-minimo"
                                    class="w-full px-4 py-3 bg-white dark:bg-gray-700 border-2 border-gray-300/70 dark:border-gray-600/70 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-purple-500/40 focus:border-purple-500 transition-all duration-300 shadow-sm"
                                    placeholder="70"
                                    min="0"
                                    max="100"
                                />
                                <span class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400">%</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2 flex items-center gap-1">
                                <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Tiempo límite (minutos)
                            </label>
                            <div class="relative">
                                <input 
                                    type="number" 
                                    id="tiempo-limite"
                                    class="w-full px-4 py-3 bg-white dark:bg-gray-700 border-2 border-gray-300/70 dark:border-gray-600/70 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-purple-500/40 focus:border-purple-500 transition-all duration-300 shadow-sm"
                                    placeholder="30"
                                    min="5"
                                />
                                <span class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400">min</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lista de preguntas existentes con mejor diseño -->
                <div class="mb-6">
                    <div class="flex items-center justify-between mb-5">
                        <h4 class="font-bold text-gray-800 dark:text-gray-200 text-lg flex items-center gap-2">
                            <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Preguntas del Quiz
                        </h4>
                        <span id="contador-preguntas" class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-3 py-1.5 rounded-full text-sm font-semibold shadow-sm flex items-center gap-1">
                            <span id="numero-preguntas">0</span> preguntas
                        </span>
                    </div>
                    
                    <div id="preguntas-container" class="space-y-4">
                        <!-- Las preguntas se agregarán aquí dinámicamente -->
                        <div id="sin-preguntas" class="text-center py-10 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-700/50 dark:to-gray-800/50 rounded-2xl border-2 border-dashed border-gray-300 dark:border-gray-600">
                            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="text-gray-500 dark:text-gray-400 font-medium">No hay preguntas agregadas</p>
                            <p class="text-sm text-gray-400 dark:text-gray-500 mt-2">Agrega la primera pregunta usando el botón de abajo</p>
                        </div>
                    </div>
                </div>

                <!-- Botón para agregar nueva pregunta con mejor diseño -->
                <button id="agregar-pregunta" class="w-full py-4 bg-gradient-to-r from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 border-2 border-dashed border-purple-300 dark:border-purple-600 rounded-xl text-purple-600 dark:text-purple-400 hover:border-purple-500 hover:text-purple-700 dark:hover:text-purple-300 hover:shadow-md transition-all duration-300 flex items-center justify-center gap-3 font-semibold mb-6 group">
                    <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    Agregar Nueva Pregunta
                </button>

                <!-- Botones de acción mejorados -->
                <div class="flex flex-col sm:flex-row gap-3 pt-5 border-t border-gray-200 dark:border-gray-600 flex-shrink-0">
                    <button type="button" id="cancelar-quiz" class="flex-1 bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 text-white font-semibold py-3.5 px-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 shadow-md hover:shadow-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        Cancelar
                    </button>
                    <button type="button" id="guardar-quiz" class="flex-1 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-semibold py-3.5 px-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 shadow-md hover:shadow-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        Guardar Quiz
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
    <!-- Modal para agregar/editar pregunta - NUEVO MODAL -->
    <div id="modal-pregunta" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden transition-opacity duration-300 overflow-y-auto">
        <div class="flex items-start justify-center min-h-screen p-2 sm:p-4 py-8">
            <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-2xl w-full max-w-2xl mx-auto my-8 transform transition-all duration-300 scale-95 opacity-0 max-h-[90vh] flex flex-col" id="modal-pregunta-content">
                <!-- Header fijo -->
                <div class="bg-gradient-to-r from-blue-600 to-teal-500 p-4 sm:p-6 rounded-t-3xl text-white flex-shrink-0">
                    <h3 class="text-lg sm:text-xl font-bold" id="modal-pregunta-titulo">Agregar Nueva Pregunta</h3>
                </div>
                
                <!-- Contenido desplazable -->
                <div class="p-4 sm:p-6 overflow-y-auto flex-1">
                    <form id="form-pregunta" class="space-y-4 sm:space-y-6">
                        <!-- Enunciado de la pregunta -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                                Enunciado de la Pregunta *
                            </label>
                            <textarea 
                                id="enunciado-pregunta"
                                class="w-full px-3 sm:px-4 py-2 sm:py-3 bg-white dark:bg-gray-700 border-2 border-gray-300/50 dark:border-gray-600/50 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all duration-300 text-sm sm:text-base resize-none"
                                placeholder="Ej: ¿Cuál es el principal objetivo de la educación ambiental?"
                                rows="3"
                                required
                            ></textarea>
                        </div>

                        <!-- Tipo de pregunta -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                                Tipo de Pregunta *
                            </label>
                            <select 
                                id="tipo-pregunta"
                                class="w-full px-3 sm:px-4 py-2 sm:py-3 bg-white dark:bg-gray-700 border-2 border-gray-300/50 dark:border-gray-600/50 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all duration-300 text-sm sm:text-base"
                            >
                                <option value="opcion_multiple">Opción Múltiple</option>
                                <option value="verdadero_falso">Verdadero/Falso</option>
                                <option value="seleccion_multiple">Selección Múltiple</option>
                            </select>
                        </div>

                        <!-- Opciones de respuesta -->
                        <div id="opciones-container" class="space-y-3">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                                Opciones de Respuesta *
                            </label>
                            
                            <!-- Opción 1 -->
                            <div class="opcion-item flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                                <div class="flex items-center gap-3 flex-1">
                                    <input type="radio" name="respuesta-correcta" class="respuesta-correcta w-4 h-4 text-blue-600" />
                                    <input 
                                        type="text" 
                                        class="texto-opcion w-full px-3 py-2 bg-white dark:bg-gray-600 border border-gray-300/50 dark:border-gray-500/50 rounded-lg text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-1 focus:ring-blue-500/30 focus:border-blue-500 text-sm"
                                        placeholder="Opción 1"
                                        required
                                    />
                                </div>
                                <button type="button" class="eliminar-opcion p-1.5 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-all duration-300 opacity-50 cursor-not-allowed" disabled>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>

                            <!-- Opción 2 -->
                            <div class="opcion-item flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                                <div class="flex items-center gap-3 flex-1">
                                    <input type="radio" name="respuesta-correcta" class="respuesta-correcta w-4 h-4 text-blue-600" />
                                    <input 
                                        type="text" 
                                        class="texto-opcion w-full px-3 py-2 bg-white dark:bg-gray-600 border border-gray-300/50 dark:border-gray-500/50 rounded-lg text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-1 focus:ring-blue-500/30 focus:border-blue-500 text-sm"
                                        placeholder="Opción 2"
                                        required
                                    />
                                </div>
                                <button type="button" class="eliminar-opcion p-1.5 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-all duration-300">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Botón para agregar más opciones -->
                        <button type="button" id="agregar-opcion" class="w-full py-2 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg text-gray-600 dark:text-gray-400 hover:border-blue-500 hover:text-blue-500 transition-all duration-300 flex items-center justify-center gap-2 text-sm font-medium">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                            </svg>
                            Agregar otra opción
                        </button>

                        <!-- Puntos -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                                Puntos *
                            </label>
                            <input 
                                type="number" 
                                id="puntos-pregunta"
                                class="w-full px-3 sm:px-4 py-2 sm:py-3 bg-white dark:bg-gray-700 border-2 border-gray-300/50 dark:border-gray-600/50 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all duration-300 text-sm sm:text-base"
                                placeholder="10"
                                min="1"
                                max="100"
                                value="10"
                                required
                            />
                        </div>

                        <!-- Botones -->
                        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-200 dark:border-gray-600 flex-shrink-0">
                            <button type="button" id="cancelar-pregunta" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2.5 sm:py-3 px-4 rounded-xl transition-all duration-300 text-sm sm:text-base">
                                Cancelar
                            </button>
                            <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white font-semibold py-2.5 sm:py-3 px-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 text-sm sm:text-base">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Guardar Pregunta
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <Footer />
</Layout>