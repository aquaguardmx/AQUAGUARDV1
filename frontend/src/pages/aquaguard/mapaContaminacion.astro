---
import "../../styles/estilos.css";
import Header from "../../components/aquaguard-components/Header.astro";
import Footer from "../../components/aquaguard-components/Footer.astro";

// Variables para el frontmatter - usar let en lugar de const
let cuerposAguaOriginal = [];
let capasAgua;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>AquaGuard - Mapa de Calidad del Agua</title>
    <!--Estilos de Bootstrap-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!--Carga los estilos base de Leaflet.js-->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!--Font Awesome 6-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Catamaran:wght@300;400;500;600;700&family=Hind:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>
<body>    
    <div class="wrapper">
        <Header />
            <div class="wrapper_inner">
                <div class="hero_content">
                    <h1>.</h1>
                    <div class="logo-container" style="text-align:center; margin-bottom:20px;">
                        <a href="/">
                        <img src="/img/logo.png" alt="AquaGuard Logo" style="height:64px; display:block; margin:0 auto;">
                    </div>   
                    <div class="section_title">    
                        <h2>
                            Mapa Interactivo de Calidad del Agua
                        </h2>
                        <p style="font-size:1.15rem; color:#333; max-width:700px; margin:0 auto;">
                            Explora la calidad del agua en ríos, lagos y presas de México. 
                        </p>
                        <p style="font-size:1.15rem; color:#333; max-width:700px; margin:0 auto;">
                            Usa el buscador para encontrar un sitio o cuerpo de agua, o utiliza tu ubicación para ver los cuerpos cercanos. Haz clic en los marcadores para ver información detallada y recomendaciones.
                        </p>
                    </div>
                </div>
            </div>

            <div class="map-container">
                <div class="search-container">
                    <input type="text" id="searchInput" class="search-box" placeholder="Buscar por ubicación o nombre de río">
                    <button id="searchButton" class="btn-primary-custom"><i class="fas fa-search"></i> Buscar</button>
                    <button onclick="obtenerUbi()" class="btn-primary-custom"><i class="fas fa-location-arrow"></i> Mi Ubicación</button>
                </div>

                <div id="mapa"></div>

                <!-- Panel de información detallada de cuerpo de agua-->
                <div class="info-panel" id="infoPanel" style="display:none;">
                    <span class="close-panel" onclick="cerrarPanel()">&times;</span>
                    <h3 class="info-title" id="waterBodyTitle"></h3>
                    <div id="waterBodyInfo"></div>
                    
                    <div class="treatment-steps" id="treatmentSteps">
                        <h4><i class="fas fa-filter"></i> Recomendaciones de Tratamiento</h4>
                        <div id="stepsContainer"></div>
                    </div>
                    
                    <div class="mt-4">
                        <h4><i class="fas fa-info-circle"></i> Información Adicional</h4>
                        <div class="parameter-row">
                            <span class="parameter-name">Estado:</span>
                            <span class="parameter-value" id="aptaStatus"></span>
                        </div>
                        <div id="additionalInfo"></div>
                    </div>
                </div>
            </div>

        <Footer />
    </div>

    <!--API del mapa-->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script client:load>
        // Declarar variables dentro del script, no usar define:vars
        let cuerposAguaOriginal = [];
        let capasAgua;
        let map;
        let ubicacionMarker = null;
        let currentLocation = null;

        function initMap() {
            if (map) return; // Evita re-inicialización
            
            map = L.map('mapa').setView([23.6345, -102.5528], 6);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);
            
            // Leyenda
            const legend = L.control({position: 'bottomright'});
            legend.onAdd = function() {
                const div = L.DomUtil.create('div', 'legend');
                div.innerHTML = `
                    <h4>Calidad del Agua</h4>
                    <div><i style="background:#28a745"></i> Buena</div>
                    <div><i style="background:#ffc107"></i> Moderada</div>
                    <div><i style="background:#dc3545"></i> Mala</div>
                `;
                return div;
            };
            legend.addTo(map);
        }

        function cargarCuerposAgua() {
            initMap();
            
            fetch('http://localhost:8000/api/mapa')
                .then(res => {
                    if (!res.ok) {
                        throw new Error(`HTTP error! status: ${res.status}`);
                    }
                    return res.json();
                })
                .then(data => {
                    console.log('Datos recibidos:', data); // Para debug
                    
                    // Ajuste para la nueva estructura de datos
                    const estaciones = data.estaciones || data;
                    cuerposAguaOriginal = estaciones; // Ahora funciona porque está en el script
                    
                    // Limpia capas anteriores
                    if (capasAgua) {
                        map.removeLayer(capasAgua);
                    }
                    
                    // Crea marcadores para cada estación
                    capasAgua = L.layerGroup();
                    
                    estaciones.forEach(estacion => {
                        if (estacion.latitud && estacion.longitud) {
                            let lat = parseFloat(estacion.latitud);
                            let lng = parseFloat(estacion.longitud);
                            
                            if (isNaN(lat) || isNaN(lng)) {
                                console.warn('Coordenadas inválidas:', estacion.latitud, estacion.longitud);
                                return;
                            }
                            
                            // Determina color (ajusta según tu lógica de semáforo)
                            let color = '#007bff';
                            let calidad = 'No disponible';
                            
                            // Lógica básica de color según tipo (puedes personalizar esto)
                            if (estacion.id_tipo === 1) {
                                color = '#28a745';
                                calidad = 'Buena';
                            } else if (estacion.id_tipo === 2) {
                                color = '#ffc107';
                                calidad = 'Moderada';
                            } else {
                                color = '#dc3545';
                                calidad = 'Mala';
                            }
                            
                            // Popup con información básica
                            let popup = `
                                <div style="min-width: 200px">
                                    <b>${estacion.nombre || 'Sin nombre'}</b><br>
                                    <small><strong>Clave:</strong> ${estacion.clave_sitio}</small><br>
                                    <small><strong>Calidad:</strong> <span style="color:${color}">${calidad}</span></small><br>
                                    <small><strong>Estado:</strong> ${estacion.activo ? 'Activo' : 'Inactivo'}</small><br>
                                    <button class='btn btn-sm btn-primary ver-detalles-btn mt-2'
                                            data-props='${encodeURIComponent(JSON.stringify(estacion))}'>
                                        Ver detalles completos
                                    </button>
                                </div>
                            `;
                            
                            const marker = L.circleMarker([lat, lng], {
                                radius: 8,
                                fillColor: color,
                                color: color,
                                weight: 1,
                                fillOpacity: 0.8
                            }).bindPopup(popup);
                            
                            // Evento para mostrar detalles al hacer clic
                            marker.on('click', function() {
                                mostrarDetalles(estacion);
                            });
                            
                            capasAgua.addLayer(marker);
                        } else {
                            console.warn('Estación sin coordenadas:', estacion.nombre);
                        }
                    });
                    
                    capasAgua.addTo(map);
                    console.log(`Cargadas ${estaciones.length} estaciones en el mapa`);
                })
                .catch(error => {
                    console.error("Error al cargar los datos:", error);
                    alert("Error al cargar los datos. Por favor intente más tarde.");
                });
        }

        // Función para mostrar detalles
        function mostrarDetalles(estacion) {
            document.getElementById('waterBodyTitle').textContent = estacion.nombre || 'Estación sin nombre';
            
            let infoHTML = `
                <div class="parameter-row">
                    <span class="parameter-name">Clave Sitio:</span>
                    <span class="parameter-value">${estacion.clave_sitio}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Coordenadas:</span>
                    <span class="parameter-value">${estacion.latitud}, ${estacion.longitud}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Estado:</span>
                    <span class="parameter-value ${estacion.activo ? 'quality-good' : 'quality-bad'}">
                        ${estacion.activo ? 'Activo' : 'Inactivo'}
                    </span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Tipo ID:</span>
                    <span class="parameter-value">${estacion.id_tipo}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Subtipo ID:</span>
                    <span class="parameter-value">${estacion.id_subtipo}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Municipio ID:</span>
                    <span class="parameter-value">${estacion.id_municipio || 'No especificado'}</span>
                </div>
                <div class="parameter-row">
                    <span class="parameter-name">Cuenca ID:</span>
                    <span class="parameter-value">${estacion.id_cuenca || 'No especificado'}</span>
                </div>
            `;
            
            document.getElementById('waterBodyInfo').innerHTML = infoHTML;
            
            // Recomendaciones básicas
            document.getElementById('stepsContainer').innerHTML = `
                <div class="step-card">
                    <div class="step-title">Información de la Estación</div>
                    <div class="step-desc">
                        <p><strong>ID Estación:</strong> ${estacion.id_estacion}</p>
                        <p><strong>Usuario ID:</strong> ${estacion.id_usuario}</p>
                        <p><strong>Fecha creación:</strong> ${new Date(estacion.created_at).toLocaleDateString()}</p>
                        <p><strong>Última actualización:</strong> ${new Date(estacion.updated_at).toLocaleDateString()}</p>
                        <p class="mt-2"><em>Esta estación requiere datos específicos de calidad del agua para generar recomendaciones detalladas de tratamiento.</em></p>
                    </div>
                </div>
            `;
            
            document.getElementById('aptaStatus').textContent = estacion.activo ? 'Activo - En monitoreo' : 'Inactivo - Sin datos recientes';
            document.getElementById('aptaStatus').className = `parameter-value ${estacion.activo ? 'quality-good' : 'quality-bad'}`;
            
            document.getElementById('additionalInfo').innerHTML = `
                <div class="mt-3">
                    <div class="info-cards-group">
                        <div class="info-card">
                            <div class="info-card-header">
                                <i class="fas fa-database"></i> <span>Datos Técnicos</span>
                            </div>
                            <div class="info-card-body">
                                <p><strong>ID en sistema:</strong> ${estacion.id_estacion}</p>
                                <p><strong>Responsable:</strong> Usuario ${estacion.id_usuario}</p>
                                <p><strong>Tipo de cuerpo:</strong> ${obtenerTipoCuerpoAgua(estacion.id_tipo)}</p>
                                <p><strong>Subtipo:</strong> ${obtenerSubtipoCuerpoAgua(estacion.id_subtipo)}</p>
                            </div>
                        </div>
                        
                        <div class="info-card">
                            <div class="info-card-header">
                                <i class="fas fa-calendar-alt"></i> <span>Historial</span>
                            </div>
                            <div class="info-card-body">
                                <p><strong>Registrado desde:</strong> ${new Date(estacion.created_at).toLocaleDateString()}</p>
                                <p><strong>Última actualización:</strong> ${new Date(estacion.updated_at).toLocaleDateString()}</p>
                                <p><strong>Estado del monitoreo:</strong> ${estacion.activo ? '🟢 Activo' : '🔴 Inactivo'}</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            document.getElementById('infoPanel').style.display = 'block';
            document.getElementById('infoPanel').scrollIntoView({ behavior: 'smooth' });
        }

        // Funciones auxiliares para mostrar tipos en texto
        function obtenerTipoCuerpoAgua(idTipo) {
            const tipos = {
                1: 'Río/Arroyo',
                2: 'Lago/Laguna', 
                3: 'Presa/Embalse',
                4: 'Manantial',
                5: 'Canal'
            };
            return tipos[idTipo] || `Tipo ${idTipo}`;
        }

        function obtenerSubtipoCuerpoAgua(idSubtipo) {
            const subtipos = {
                1: 'Superficial',
                2: 'Subterráneo',
                3: 'Costero',
                4: 'Artificial'
            };
            return subtipos[idSubtipo] || `Subtipo ${idSubtipo}`;
        }

        function cerrarPanel() {
            document.getElementById('infoPanel').style.display = 'none';
        }

        function obtenerUbi() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        currentLocation = [position.coords.latitude, position.coords.longitude];
                        map.setView(currentLocation, 13);
                        
                        if (ubicacionMarker) {
                            map.removeLayer(ubicacionMarker);
                        }
                        
                        ubicacionMarker = L.marker(currentLocation, {
                            icon: L.divIcon({
                                className: 'user-location-marker',
                                html: '<i class="fas fa-user" style="color: #0077b6; font-size: 24px;"></i>',
                                iconSize: [24, 24]
                            })
                        }).addTo(map)
                        .bindPopup('Tu ubicación actual').openPopup();
                    },
                    function(error) {
                        console.error("Error al obtener ubicación:", error);
                        alert("No se pudo obtener tu ubicación.");
                    }
                );
            } else {
                alert("La geolocalización no está soportada en tu navegador.");
            }
        }

        // Event listeners
        document.getElementById('searchButton').addEventListener('click', function() {
            const query = document.getElementById('searchInput').value.trim();
            buscarCuerposAgua(query);
        });

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('ver-detalles-btn')) {
                e.preventDefault();
                e.stopPropagation();
                
                try {
                    const props = JSON.parse(decodeURIComponent(e.target.getAttribute('data-props')));
                    mostrarDetalles(props);
                } catch (error) {
                    console.error('Error al parsear datos:', error);
                }
            }
        });

        // Función de búsqueda
        function buscarCuerposAgua(query) {
            if (!cuerposAguaOriginal || !Array.isArray(cuerposAguaOriginal)) {
                console.warn('No hay datos para buscar');
                return;
            }
            
            query = query.trim().toLowerCase();
            if (!query) {
                // Si no hay query, mostrar todos
                if (capasAgua) {
                    map.removeLayer(capasAgua);
                    capasAgua.addTo(map);
                }
                return;
            }
            
            const resultados = cuerposAguaOriginal.filter(estacion => {
                const nombre = estacion.nombre ? estacion.nombre.toLowerCase() : '';
                const clave = estacion.clave_sitio ? estacion.clave_sitio.toLowerCase() : '';
                
                return nombre.includes(query) || clave.includes(query);
            });
            
            console.log(`Búsqueda: "${query}" - Encontrados: ${resultados.length} resultados`);
            
            // Actualizar el mapa con los resultados
            if (capasAgua) {
                map.removeLayer(capasAgua);
            }
            
            capasAgua = L.layerGroup();
            resultados.forEach(estacion => {
                if (estacion.latitud && estacion.longitud) {
                    let lat = parseFloat(estacion.latitud);
                    let lng = parseFloat(estacion.longitud);
                    
                    if (isNaN(lat) || isNaN(lng)) return;
                    
                    let color = '#007bff';
                    if (estacion.id_tipo === 1) color = '#28a745';
                    else if (estacion.id_tipo === 2) color = '#ffc107';
                    
                    const marker = L.circleMarker([lat, lng], {
                        radius: 10,
                        fillColor: color,
                        color: color,
                        weight: 2,
                        fillOpacity: 0.8
                    }).bindPopup(`
                        <b>${estacion.nombre}</b><br>
                        <small>${estacion.clave_sitio}</small><br>
                        <button class='btn btn-sm btn-primary ver-detalles-btn'
                                data-props='${encodeURIComponent(JSON.stringify(estacion))}'>
                            Ver detalles
                        </button>
                    `);
                    
                    capasAgua.addLayer(marker);
                }
            });
            
            capasAgua.addTo(map);
            
            // Centrar en los resultados si hay
            if (resultados.length > 0 && resultados[0].latitud && resultados[0].longitud) {
                const lat = parseFloat(resultados[0].latitud);
                const lng = parseFloat(resultados[0].longitud);
                if (!isNaN(lat) && !isNaN(lng)) {
                    map.setView([lat, lng], 10);
                }
            }
        }

        // Inicializar cuando el DOM esté listo
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM cargado, iniciando mapa...');
            cargarCuerposAgua();
        });

        // También intentar cargar si el DOM ya está listo
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            console.log('DOM ya listo, iniciando mapa...');
            cargarCuerposAgua();
        }
    </script>

    <style>
        /* Estilos adicionales para el mapa */
        #mapa {
            height: 600px;
            width: 100%;
            border-radius: 10px;
            margin-top: 20px;
        }
        
        .map-container {
            position: relative;
            padding: 20px;
        }
        
        .search-container {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        
        .search-box {
            flex: 1;
            min-width: 250px;
            padding: 10px 15px;
            border: 1px solid #ddd;
            border-radius: 25px;
            font-size: 16px;
        }
        
        .btn-primary-custom {
            background: linear-gradient(90deg, #0077b6, #00b4d8);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 119, 182, 0.3);
        }
        
        .info-panel {
            background: white;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            border-left: 4px solid #0077b6;
        }
        
        .close-panel {
            float: right;
            font-size: 24px;
            cursor: pointer;
            color: #666;
        }
        
        .parameter-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }
        
        .parameter-name {
            font-weight: bold;
            color: #333;
        }
        
        .parameter-value {
            color: #666;
        }
        
        .quality-good { color: #28a745; }
        .quality-moderate { color: #ffc107; }
        .quality-bad { color: #dc3545; }
        
        .step-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            border-left: 4px solid #00b4d8;
        }
        
        .step-title {
            font-weight: bold;
            color: #0077b6;
            margin-bottom: 10px;
        }
        
        .legend {
            background: white;
            padding: 10px;
            border-radius: 5px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        }
        
        .legend h4 {
            margin: 0 0 10px 0;
            font-size: 14px;
        }
        
        .legend div {
            margin-bottom: 5px;
        }
        
        .legend i {
            width: 18px;
            height: 18px;
            float: left;
            margin-right: 8px;
            opacity: 0.8;
            border-radius: 50%;
        }
        
        .info-cards-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .info-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            border-left: 4px solid #00b4d8;
        }
        
        .info-card-header {
            font-weight: bold;
            color: #0077b6;
            margin-bottom: 10px;
        }
        
        @media (max-width: 768px) {
            .search-container {
                flex-direction: column;
            }
            
            .search-box {
                min-width: auto;
            }
            
            .info-cards-group {
                grid-template-columns: 1fr;
            }
        }
    </style>
</body>
</html>