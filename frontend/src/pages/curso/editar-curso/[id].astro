    // Configuración de la API

    const API_URL = "https://aquaguardv1.onrender.com/api";
    
    // Función mejorada para obtener el CURSO_ID
    function obtenerCursoId() {
        // Para URLs como /curso/editar-curso/21
        const path = window.location.pathname;
        const match = path.match(/\/(\d+)$/);
        if (match && match[1]) {
            return parseInt(match[1]);
        }
        
        // Intentar obtener de la URL actual
        const segments = path.split('/').filter(segment => segment);
        const idSegment = segments[segments.length - 1];
        const idNumero = parseInt(idSegment);
        
        if (!isNaN(idNumero)) {
            return idNumero;
        }
        
        console.error('❌ No se pudo obtener el ID del curso de la URL');
        return null;
    }

    const CURSO_ID = obtenerCursoId();

    // Función para limpiar el contenido HTML antes de enviar
    function limpiarContenidoHTML(html) {
        if (!html) return null;
        
        // Reemplazar etiquetas problemáticas pero mantener formato básico
        const contenidoLimpio = html
            .replace(/<p><br><\/p>/g, '') // Remover párrafos vacíos
            .replace(/<p><\/p>/g, '') // Remover párrafos vacíos
            .trim();
        
        return contenidoLimpio === '<p>Escribe el contenido de tu lección aquí...</p>' ? 
               null : contenidoLimpio;
    }

    // Función para extraer el ID del video de YouTube
    function extractVideoId(url) {
        if (!url) return null;
        
        // Patrones para diferentes formatos de URL de YouTube
        const patterns = [
            /(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&?#]+)/, // youtube.com/watch?v=ID o youtu.be/ID
            /(?:youtube\.com\/embed\/)([^&?#]+)/, // youtube.com/embed/ID
            /(?:youtube\.com\/v\/)([^&?#]+)/, // youtube.com/v/ID
        ];
        
        for (const pattern of patterns) {
            const match = url.match(pattern);
            if (match && match[1]) {
                return match[1];
            }
        }
        
        return null;
    }

    // Función para truncar URLs largas
    function truncateUrl(url, maxLength = 50) {
        if (url.length <= maxLength) return url;
        return url.substring(0, maxLength) + '...';
    }

