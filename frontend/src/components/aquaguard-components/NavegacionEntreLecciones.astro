        )
    }
</aside>

<script is:inline>
    function setupAccordion() {
        const sidebar = document.querySelector("aside");
        if (!sidebar) return;

        const moduloHeaders = sidebar.querySelectorAll(".modulo-header");

        function closeOtherModulos(currentModuloId) {
            moduloHeaders.forEach((header) => {
                const moduloElement = header.closest("[data-modulo-id]");
                if (!moduloElement) return;

                const moduloId = moduloElement.dataset.moduloId;

                if (moduloId !== currentModuloId) {
                    const otherLeccionesContainer = moduloElement.querySelector(
                        ".lecciones-container",
                    );
                    const otherToggleIcon = header.querySelector(
                        ".modulo-toggle-icon",
                    );

                    if (otherLeccionesContainer) {
                        otherLeccionesContainer.classList.add("hidden");
                        otherLeccionesContainer.style.opacity = "";
                        otherLeccionesContainer.style.transform = "";
                        otherLeccionesContainer.style.transition = "";
                    }
                    if (otherToggleIcon) {
                        otherToggleIcon.classList.remove("rotate-180");
                    }
                }
            });
        }

        moduloHeaders.forEach((header) => {
            header.addEventListener("click", () => {
                const moduloElement = header.closest("[data-modulo-id]");
                if (!moduloElement) {
                    console.error(
                        "No se pudo encontrar el elemento [data-modulo-id] padre.",
                    );
                    return;
                }

                const moduloId = moduloElement.dataset.moduloId;
                const leccionesContainer = moduloElement.querySelector(
                    ".lecciones-container",
                );
                const toggleIcon = header.querySelector(".modulo-toggle-icon");

                if (leccionesContainer) {
                    const isOpening =
                        leccionesContainer.classList.contains("hidden");

                    // Lógica de acordeón: Si estamos abriendo, cerramos los demás
                    if (isOpening && moduloId) {
                        closeOtherModulos(moduloId);
                    }

                    // Toggle del módulo actual
                    leccionesContainer.classList.toggle("hidden");

                    // Animación suave al abrir
                    if (!leccionesContainer.classList.contains("hidden")) {
                        leccionesContainer.style.opacity = "0";
                        leccionesContainer.style.transform =
                            "translateY(-10px)";

                        requestAnimationFrame(() => {
                            leccionesContainer.style.transition =
                                "all 0.3s ease";
                            leccionesContainer.style.opacity = "1";
                            leccionesContainer.style.transform =
                                "translateY(0)";
                        });
                    } else {
                        // Limpiar estilos al cerrar
                        leccionesContainer.style.opacity = "";
                        leccionesContainer.style.transform = "";
                        leccionesContainer.style.transition = "";
                    }
                }

                if (toggleIcon) {
                    toggleIcon.classList.toggle("rotate-180");
                }
            });
        });
    }

    // Prevenir clics en lecciones bloqueadas
    function setupBlockedLessons() {
        const sidebar = document.querySelector("aside");
        if (!sidebar) return;

        sidebar.addEventListener("click", (e) => {
            const target = e.target.closest("a[data-leccion-id]");
            if (target && target.dataset.isBlocked === "true") {
                e.preventDefault();
                console.log(
                    "Esta lección está bloqueada. Completa las lecciones anteriores para desbloquearla.",
                );

                // Opcional: Mostrar un toast o mensaje al usuario
                // showBlockedMessage();
            }
        });
    }

    // Función opcional para mostrar mensaje de bloqueo
    function showBlockedMessage() {
        // Puedes implementar un toast o modal aquí
        const existingToast = document.getElementById("blocked-lesson-toast");
        if (existingToast) {
            existingToast.remove();
        }

        const toast = document.createElement("div");
        toast.id = "blocked-lesson-toast";
        toast.className =
            "fixed bottom-4 right-4 bg-red-500 text-white px-4 py-2 rounded-lg shadow-lg z-50";
        toast.textContent =
            "Completa las lecciones anteriores para desbloquear esta lección";

        document.body.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Manejar diferentes estados de carga del DOM
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
            setupAccordion();
            setupBlockedLessons();
        });
    } else {
        // DOM ya está listo
        setupAccordion();
        setupBlockedLessons();
    }
</script>

