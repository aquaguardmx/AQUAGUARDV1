                                            {modulo.completado && (
                                                <span class="inline-flex items-center gap-1 text-green-600 dark:text-green-400 text-sm bg-green-100 dark:bg-green-900/30 px-2 py-1 rounded-full">
                                                    <svg
                                                        class="w-3 h-3"
                                                        fill="currentColor"
                                                        viewBox="0 0 20 20"
                                                    >
                                                        <path
                                                            fill-rule="evenodd"
                                                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                            clip-rule="evenodd"
