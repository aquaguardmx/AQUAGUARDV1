---
// Componente: CourseSidebar.astro

const { id } = Astro.params;

// Interfaces para las props
export interface Leccion {
  id: number;
  titulo: string;
  activa?: boolean;
  completada?: boolean;
  url: string;
}

export interface Modulo {
  id: number;
  titulo: string;
  lecciones: Leccion[];
  expandido?: boolean;
}

export interface Props {
  modulos: Modulo[];
  cursoId?: string;
  currentLeccionId?: number;
  modoCreacion?: boolean;
  moduloActual?: Modulo | null; // Nuevo prop
}

// Props por defecto
const { modulos = [], cursoId = "1" } = Astro.props;

// Normalizar los datos
const modulosNormalizados = Array.isArray(modulos) 
  ? modulos.map((modulo, index) => ({
      id: modulo.id || index + 1,
      titulo: modulo.titulo || 'Sin título',
      lecciones: Array.isArray(modulo.lecciones) ? modulo.lecciones : [],
      expandido: modulo.expandido || false
    }))
  : [];

// Convertir a JSON para el script
const modulosJSON = JSON.stringify(modulosNormalizados);
---

<style>
    /* ... (estilos existentes) ... */
    
    /* Añade esta clase CSS */
    .rotate-180 {
        transform: rotate(180deg);
    }
    
    .module-arrow {
        transition: transform 0.3s ease;
    }
</style>

<aside class="w-full lg:w-80 xl:w-96 flex-shrink-0">
    <div
        class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 lg:p-6 sticky top-20 lg:top-24 max-h-[calc(100vh-6rem)] overflow-hidden flex flex-col"
    >
        <!-- Header del Sidebar -->
        <div class="flex items-center justify-between mb-4 lg:mb-6">
            <h2 class="text-lg lg:text-xl font-bold text-gray-900 dark:text-white truncate">
                Contenido del Curso
            </h2>
            <button
                type="button"
                class="inline-flex items-center p-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors flex-shrink-0"
                id="add-module-btn"
                title="Añadir nuevo módulo"
            >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path
                        fill-rule="evenodd"
                        d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
                        clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Añadir Módulo</span>
            </button>
        </div>

        <!-- Lista de Módulos - Scrollable -->
        <div class="flex-1 overflow-y-auto space-y-3" id="modules-list">
            {modulosNormalizados.length === 0 ? (
                <div class="text-center py-6 lg:py-8" id="empty-state">
                    <svg class="w-10 h-10 lg:w-12 lg:h-12 text-gray-400 mx-auto mb-3 lg:mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                    <p class="text-sm lg:text-base text-gray-500 dark:text-gray-400 mb-2">No hay módulos creados</p>
                    <p class="text-xs lg:text-sm text-gray-400 dark:text-gray-500">Comienza añadiendo tu primer módulo</p>
                </div>
            ) : (
                modulosNormalizados.map((modulo) => (
                    <div
                        class="border border-gray-200 dark:border-gray-600 rounded-lg overflow-hidden module-container"
                        data-module-container={modulo.id}
                    >
                        <!-- Header del Módulo -->
                        <button
                            class="flex items-center justify-between w-full p-3 lg:p-4 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors module-toggle group"
                            data-module-id={modulo.id}
                            type="button"
                        >
                            <span class="font-semibold text-gray-900 dark:text-white text-left text-sm lg:text-base line-clamp-2 flex-1 mr-2">
                                {modulo.titulo}
                            </span>
                            <div class="flex items-center space-x-2 flex-shrink-0">
                                <span class="text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-600 px-2 py-1 rounded">
                                    {modulo.lecciones.length}
                                </span>
                                <svg
                                    class="w-4 h-4 text-gray-500 transition-transform module-arrow flex-shrink-0 group-hover:text-gray-700 dark:group-hover:text-gray-300"
                                    data-arrow-id={modulo.id}
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="m19 9-7 7-7-7"
                                    ></path>
                                </svg>
                            </div>
                        </button>

                        <!-- Contenido del Módulo -->
                        <div
                            class="bg-gray-50 dark:bg-gray-700/50 module-content max-h-0 overflow-hidden transition-all duration-300"
                            id={`module-${modulo.id}-content`}
                            data-module-content={modulo.id}
                        >
                            <div class="p-3 lg:p-4 space-y-2 lg:space-y-3">
                                <!-- Lista de Lecciones -->
                                {modulo.lecciones.length > 0 ? (
                                    <div class="space-y-2 max-h-60 lg:max-h-80 overflow-y-auto thin-scrollbar">
                                        {modulo.lecciones.map((leccion) => (
                                            <a
                                                href={leccion.url}
                                                class={`flex items-center p-2 lg:p-3 rounded-lg transition-colors group/leccion ${
                                                    leccion.activa 
                                                        ? 'bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800' 
                                                        : 'text-gray-700 dark:text-gray-300 hover:bg-white dark:hover:bg-gray-600 border border-transparent'
                                                }`}
                                                data-leccion-id={leccion.id}
                                            >
                                                <!-- Icono de estado -->
                                                <div
                                                    class={`w-6 h-6 lg:w-8 lg:h-8 rounded-full flex items-center justify-center flex-shrink-0 ${
                                                        leccion.activa 
                                                            ? 'bg-blue-600' 
                                                            : leccion.completada 
                                                                ? 'bg-green-500' 
                                                                : 'bg-gray-200 dark:bg-gray-600'
                                                    }`}
                                                >
                                                    {leccion.activa ? (
                                                        <svg
                                                            class="w-3 h-3 lg:w-4 lg:h-4 text-white"
                                                            fill="currentColor"
                                                            viewBox="0 0 20 20"
                                                        >
                                                            <path
                                                                fill-rule="evenodd"
                                                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z"
                                                                clip-rule="evenodd"></path>
                                                        </svg>
                                                    ) : leccion.completada ? (
                                                        <svg
                                                            class="w-3 h-3 lg:w-4 lg:h-4 text-white"
                                                            fill="currentColor"
                                                            viewBox="0 0 20 20"
                                                        >
                                                            <path
                                                                fill-rule="evenodd"
                                                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                                clip-rule="evenodd"
                                                            ></path>
                                                        </svg>
                                                    ) : (
                                                        <svg
                                                            class="w-3 h-3 lg:w-4 lg:h-4 text-gray-600 dark:text-gray-400"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                                                            ></path>
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                                            ></path>
                                                        </svg>
                                                    )}
                                                </div>
                                                
                                                <!-- Título de la lección -->
                                                <span class={`ml-2 lg:ml-3 text-sm lg:text-base font-medium line-clamp-2 flex-1 ${
                                                    leccion.activa 
                                                        ? 'text-blue-700 dark:text-blue-300' 
                                                        : 'text-gray-700 dark:text-gray-300'
                                                }`}>
                                                    {leccion.titulo}
                                                </span>
                                            </a>
                                        ))}
                                    </div>
                                ) : (
                                    <div class="text-center py-3 lg:py-4">
                                        <svg class="w-6 h-6 lg:w-8 lg:h-8 text-gray-400 mx-auto mb-1 lg:mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                        </svg>
                                        <p class="text-xs lg:text-sm text-gray-500 dark:text-gray-400">No hay lecciones en este módulo</p>
                                    </div>
                                )}
                                
                                <a
                                    href={`/admin/cursos/${id}/modulos/${modulo.id}/nueva`}
                                    class="flex items-center space-x-2 p-2 lg:p-3 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 rounded-lg transition-colors text-sm lg:text-base"
                                >
                                    <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span class="font-medium truncate">Añadir Lección</span>
                                </a>
                            </div>
                        </div>
                    </div>
                ))
            )}
        </div>
    </div>
</aside>

<!-- Modal para Añadir Módulo -->
<div
    id="module-modal"
    class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4"
>
    <div class="bg-white dark:bg-gray-800 rounded-xl max-w-md w-full p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                Añadir Nuevo Módulo
            </h3>
            <button
                id="close-module-modal"
                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
            >
                <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <form id="add-module-form" class="space-y-4">
            <div>
                <label
                    for="module-name"
                    class="block text-sm font-medium text-gray-900 dark:text-white mb-2"
                >
                    Nombre del Módulo
                </label>
                <input
                    type="text"
                    id="module-name"
                    required
                    class="w-full px-3 py-2 text-gray-900 dark:text-white bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                    placeholder="Ej: Introducción a..."
                />
            </div>
            <div class="flex gap-3">
                <button
                    type="submit"
                    id="submit-module-btn"
                    class="flex-1 inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    <svg
                        class="w-4 h-4 mr-2"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
                            clip-rule="evenodd"></path>
                    </svg>
                    <span id="submit-text">Añadir Módulo</span>
                    <span id="loading-spinner" class="hidden">
                        <svg class="animate-spin h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Creando...
                    </span>
                </button>
                <button
                    type="button"
                    id="cancel-module-btn"
                    class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-200 dark:bg-gray-600 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-500 transition-colors"
                >
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    /* Scrollbar personalizado para mejor experiencia móvil */
    .thin-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    
    .thin-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .thin-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 2px;
    }
    
    .thin-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
    
    /* Dark mode scrollbar */
    @media (prefers-color-scheme: dark) {
        .thin-scrollbar::-webkit-scrollbar-thumb {
            background: #4b5563;
        }
        
        .thin-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #6b7280;
        }
    }
    
    /* Utilidad para truncar texto a múltiples líneas */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    /* Mejoras de rendimiento para animaciones */
    .module-content {
        will-change: max-height;
    }
</style>

<script is:inline define:vars={{ modulosJSON, id }}>
// Script para la interactividad del sidebar
document.addEventListener('DOMContentLoaded', function() {
    console.log('Sidebar script cargado - versión corregida');
    
    // Parsear los módulos desde JSON
    const modulosNormalizados = JSON.parse(modulosJSON || '[]');
    
    // Función mejorada para manejar el acordeón
    function initAccordion() {
        console.log('Inicializando acordeón...');
        
        const moduleToggles = document.querySelectorAll('.module-toggle');
        
        moduleToggles.forEach((button) => {
            const moduleId = button.getAttribute('data-module-id');
            const moduleContent = document.querySelector(`[data-module-content="${moduleId}"]`);
            const arrow = button.querySelector('.module-arrow');

            if (moduleContent && arrow) {
                console.log(`Configurando módulo ${moduleId}`);
                
                // Remover event listeners previos para evitar duplicados
                button.replaceWith(button.cloneNode(true));
                const newButton = document.querySelector(`[data-module-id="${moduleId}"]`);
                const newArrow = newButton.querySelector('.module-arrow');
                const newContent = document.querySelector(`[data-module-content="${moduleId}"]`);
                
                // Inicializar estado
                const moduleData = modulosNormalizados.find(m => m.id == moduleId);
                if (moduleData?.expandido) {
                    newContent.style.maxHeight = newContent.scrollHeight + 'px';
                    newArrow.classList.add('rotate-180');
                } else {
                    newContent.style.maxHeight = '0px';
                    newArrow.classList.remove('rotate-180');
                }

                // Agregar event listener
                newButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    console.log(`Click en módulo ${moduleId}`);
                    const isExpanded = newContent.style.maxHeight && newContent.style.maxHeight !== '0px';
                    
                    if (isExpanded) {
                        // Cerrar
                        newContent.style.maxHeight = '0px';
                        newArrow.classList.remove('rotate-180');
                    } else {
                        // Abrir
                        newContent.style.maxHeight = newContent.scrollHeight + 'px';
                        newArrow.classList.add('rotate-180');
                    }
                });
            }
        });
    }

    // Inicializar acordeón inmediatamente
    initAccordion();
    
    // Re-inicializar después de un pequeño delay por si el DOM no está completamente listo
    setTimeout(initAccordion, 100);

    // Manejo del modal (mantener igual)
    const addModuleBtn = document.getElementById('add-module-btn');
    const moduleModal = document.getElementById('module-modal');
    const closeModuleModal = document.getElementById('close-module-modal');
    const cancelModuleBtn = document.getElementById('cancel-module-btn');
    const addModuleForm = document.getElementById('add-module-form');
    const submitModuleBtn = document.getElementById('submit-module-btn');
    const submitText = document.getElementById('submit-text');
    const loadingSpinner = document.getElementById('loading-spinner');

    // Abrir modal
    if (addModuleBtn && moduleModal) {
        addModuleBtn.addEventListener('click', function() {
            moduleModal.classList.remove('hidden');
            moduleModal.classList.add('flex');
            document.getElementById('module-name')?.focus();
        });
    }

    // Cerrar modal
    function closeModal() {
        if (moduleModal) {
            moduleModal.classList.remove('flex');
            moduleModal.classList.add('hidden');
            if (addModuleForm) addModuleForm.reset();
            if (submitModuleBtn) submitModuleBtn.disabled = false;
            if (submitText) submitText.classList.remove('hidden');
            if (loadingSpinner) loadingSpinner.classList.add('hidden');
        }
    }

    if (closeModuleModal) closeModuleModal.addEventListener('click', closeModal);
    if (cancelModuleBtn) cancelModuleBtn.addEventListener('click', closeModal);

    if (moduleModal) {
        moduleModal.addEventListener('click', function(e) {
            if (e.target === moduleModal) closeModal();
        });
    }

    // Función para crear el HTML de un módulo
    // Función para crear el HTML de un módulo
    function createModuleHTML(moduleData) {
        return `
            <div class="border border-gray-200 dark:border-gray-600 rounded-lg overflow-hidden module-container" data-module-container="${moduleData.id}">
                <button class="flex items-center justify-between w-full p-3 lg:p-4 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors module-toggle group" data-module-id="${moduleData.id}" type="button">
                    <span class="font-semibold text-gray-900 dark:text-white text-left text-sm lg:text-base line-clamp-2 flex-1 mr-2">${moduleData.titulo}</span>
                    <div class="flex items-center space-x-2 flex-shrink-0">
                        <span class="text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-600 px-2 py-1 rounded">0</span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform module-arrow flex-shrink-0 group-hover:text-gray-700 dark:group-hover:text-gray-300" data-arrow-id="${moduleData.id}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"></path>
                        </svg>
                    </div>
                </button>
                <div class="bg-gray-50 dark:bg-gray-700/50 module-content max-h-0 overflow-hidden transition-all duration-300" id="module-${moduleData.id}-content" data-module-content="${moduleData.id}">
                    <div class="p-3 lg:p-4 space-y-2 lg:space-y-3">
                        <div class="text-center py-3 lg:py-4">
                            <svg class="w-6 h-6 lg:w-8 lg:h-8 text-gray-400 mx-auto mb-1 lg:mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                            </svg>
                            <p class="text-xs lg:text-sm text-gray-500 dark:text-gray-400">No hay lecciones en este módulo</p>
                        </div>

                                                <a 
                            href="/admin/cursos/${id}/modulos/${moduleData.id}/nueva" 
                            class="flex items-center space-x-2 p-2 lg:p-3 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 rounded-lg transition-colors text-sm lg:text-base"
                        >
                DENTRO        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-medium truncate">Añadir Lección</span>
                        </a>
                    </div>
                </div>
            </div>
        `;
    }

    // Función para añadir módulo al DOM
    function addModuleToDOM(moduleData) {
        const modulesList = document.getElementById('modules-list');
        const emptyState = document.getElementById('empty-state');
        
        if (emptyState) emptyState.remove();
        
        const moduleHTML = createModuleHTML(moduleData);
        modulesList.insertAdjacentHTML('beforeend', moduleHTML);
        
        // Re-inicializar el acordeón para incluir el nuevo módulo
        setTimeout(initAccordion, 50);
    }

    // Manejo del formulario de módulo
    if (addModuleForm) {
        addModuleForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const moduleInput = document.getElementById('module-name');
            const moduleName = moduleInput?.value.trim();
            
            if (moduleName && submitModuleBtn) {
                submitModuleBtn.disabled = true;
                if (submitText) submitText.classList.add('hidden');
                if (loadingSpinner) loadingSpinner.classList.remove('hidden');

                try {
                    const response = await fetch('http://localhost:8000/api/modulos/', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ curso_id: parseInt(id), titulo: moduleName })
                    });

                    if (!response.ok) throw new Error(`Error ${response.status}`);
                    
                    const data = await response.json();
                    const newModule = {
                        id: data.id || Date.now(),
                        titulo: moduleName,
                        lecciones: [],
                        expandido: false
                    };
                    
                    addModuleToDOM(newModule);
                    closeModal();
                    showSuccessToast(`Módulo "${moduleName}" añadido correctamente`);
                    
                } catch (error) {
                    console.error('Error al añadir el módulo:', error);
                    alert(error.message || 'Hubo un error al añadir el módulo. Inténtalo de nuevo.');
                    submitModuleBtn.disabled = false;
                    if (submitText) submitText.classList.remove('hidden');
                    if (loadingSpinner) loadingSpinner.classList.add('hidden');
                }
            }
        });
    }

    // Función para mostrar toast de éxito
    function showSuccessToast(message) {
        const toast = document.createElement('div');
        toast.className = 'fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 transform transition-transform duration-300 translate-x-0';
        toast.innerHTML = `<div class="flex items-center space-x-2"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg><span>${message}</span></div>`;
        document.body.appendChild(toast);
        setTimeout(() => { toast.remove(); }, 3000);
    }
});
</script>
