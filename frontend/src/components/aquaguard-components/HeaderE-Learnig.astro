    );
    transition: left 0.5s;
  }

  .btn-aqua:hover::before {
    left: 100%;
  }

  /* Mejoras para reducir movimiento */
  @media (prefers-reduced-motion: reduce) {
    .header-transition,
    .hover-lift,
    .btn-aqua::before {
      transition: none;
