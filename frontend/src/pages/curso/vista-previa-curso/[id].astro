---
// src/pages/admin/vista-previa-curso/[id].astro
import { ViewTransitions } from "astro:transitions";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../../components/aquaguard-components/FooterE-Learning.astro";

// Definición de tipos
export interface Autor {
  id_usuario: number;
  nombre: string;
  avatar_url?: string;
  biografia?: string;
}

export interface Categoria {
  id: number;
  nombre: string;
  slug: string;
}

export interface Leccion {
  id_leccion: number;
  titulo: string;
  descripcion: string;
  duracion_min: number;
  tipo_contenido: 'video' | 'texto' | 'quiz';
  contenido_url: string | null;
  orden: number;
  completada: boolean;
  gratuita: boolean;
}

export interface Modulo {
  id_modulo: number;
  titulo: string;
  descripcion: string;
  orden: number;
  lecciones: Leccion[];
}

export interface Curso {
  id_curso: number;
  titulo: string;
  descripcion: string;
  portada_url: string | null;
  tiempo_estimado_min: number;
  autor: Autor;
  categoria: Categoria;
  publicado: boolean;
  fecha_creacion?: string;
  modulos: Modulo[];
  nivel_dificultad: 'principiante' | 'intermedio' | 'avanzado';
  precio: number;
  objetivos: string[];
  requisitos: string[];
  estudiantes_inscritos: number;
  valoracion_promedio: number;
  total_valoraciones: number;
}

// Obtener ID del curso de los parámetros
export const prerender = false;
const { id } = Astro.params;

// Datos de ejemplo
let curso: Curso | null = null;
let fetchError = false;

try {
  // Datos de ejemplo para demostración
  curso = {
    id_curso: parseInt(id || '1'),
    titulo: "Gestión Sostenible del Agua",
    descripcion: "Aprende técnicas avanzadas para la conservación y gestión eficiente del recurso hídrico en entornos urbanos y rurales. Este curso te proporcionará las herramientas necesarias para implementar soluciones prácticas que contribuyan a la preservación de nuestro recurso más valioso.",
    portada_url: "/placeholder-curso.jpg",
    tiempo_estimado_min: 240,
    autor: {
      id_usuario: 1,
      nombre: "Dr. María González",
      avatar_url: "/avatar-profesor.jpg",
      biografia: "Especialista en gestión hídrica con más de 15 años de experiencia. Doctora en Ciencias Ambientales y consultora internacional en proyectos de conservación del agua. Ha trabajado con organizaciones como la UNESCO y el Banco Mundial en proyectos de sostenibilidad hídrica."
    },
    categoria: {
      id: 1,
      nombre: "Conservación",
      slug: "conservacion"
    },
    publicado: true,
    fecha_creacion: "2024-01-15",
    nivel_dificultad: "intermedio",
    precio: 49.99,
    estudiantes_inscritos: 1250,
    valoracion_promedio: 4.8,
    total_valoraciones: 342,
    objetivos: [
      "Comprender los principios fundamentales de la gestión sostenible del agua",
      "Aplicar técnicas de conservación en entornos urbanos y rurales",
      "Diseñar sistemas eficientes de uso hídrico para diferentes contextos",
      "Evaluar el impacto ambiental de las prácticas actuales de uso del agua",
      "Implementar soluciones innovadoras para la reutilización del agua"
    ],
    requisitos: [
      "Conocimientos básicos de ecología y medio ambiente",
      "Interés en temas de sostenibilidad y conservación",
      "Acceso a internet para el material del curso",
      "Disposición para aplicar los conocimientos en proyectos prácticos"
    ],
    modulos: [
      {
        id_modulo: 1,
        titulo: "Fundamentos del Agua y Ciclo Hidrológico",
        descripcion: "Comprende los conceptos básicos del agua y su ciclo natural",
        orden: 1,
        lecciones: [
          {
            id_leccion: 1,
            titulo: "Introducción al ciclo del agua",
            descripcion: "Comprendiendo el proceso natural del agua en nuestro planeta",
            duracion_min: 25,
            tipo_contenido: 'video',
            contenido_url: '/video-intro.mp4',
            orden: 1,
            completada: true,
            gratuita: true
          },
          {
            id_leccion: 2,
            titulo: "Importancia del recurso hídrico",
            descripcion: "Por qué el agua es esencial para la vida y el desarrollo",
            duracion_min: 20,
            tipo_contenido: 'texto',
            contenido_url: null,
            orden: 2,
            completada: false,
            gratuita: true
          },
          {
            id_leccion: 3,
            titulo: "Distribución global del agua",
            descripcion: "Análisis de la disponibilidad y acceso al agua en el mundo",
            duracion_min: 30,
            tipo_contenido: 'video',
            contenido_url: '/video-distribucion.mp4',
            orden: 3,
            completada: false,
            gratuita: false
          }
        ]
      },
      {
        id_modulo: 2,
        titulo: "Técnicas de Conservación y Ahorro",
        descripcion: "Métodos prácticos para optimizar el uso del agua",
        orden: 2,
        lecciones: [
          {
            id_leccion: 4,
            titulo: "Sistemas de captación de agua de lluvia",
            descripcion: "Implementación de sistemas domésticos y comunitarios",
            duracion_min: 35,
            tipo_contenido: 'video',
            contenido_url: '/video-captacion.mp4',
            orden: 1,
            completada: false,
            gratuita: false
          },
          {
            id_leccion: 5,
            titulo: "Tecnologías de riego eficiente",
            descripcion: "Métodos modernos para optimizar el uso de agua en agricultura",
            duracion_min: 40,
            tipo_contenido: 'texto',
            contenido_url: null,
            orden: 2,
            completada: false,
            gratuita: false
          },
          {
            id_leccion: 6,
            titulo: "Quiz: Evaluación de técnicas",
            descripcion: "Pon a prueba tus conocimientos sobre conservación",
            duracion_min: 15,
            tipo_contenido: 'quiz',
            contenido_url: null,
            orden: 3,
            completada: false,
            gratuita: false
          }
        ]
      },
      {
        id_modulo: 3,
        titulo: "Políticas y Gestión del Agua",
        descripcion: "Marco regulatorio y estrategias de gestión",
        orden: 3,
        lecciones: [
          {
            id_leccion: 7,
            titulo: "Marco legal del agua",
            descripcion: "Legislación y regulaciones sobre el uso del agua",
            duracion_min: 45,
            tipo_contenido: 'texto',
            contenido_url: null,
            orden: 1,
            completada: false,
            gratuita: false
          }
        ]
      }
    ]
  };
} catch (error: any) {
  fetchError = true;
  console.error("Error cargando curso:", error);
}

// Calcular estadísticas
const totalLecciones = curso?.modulos.reduce((total, modulo) => total + modulo.lecciones.length, 0) || 0;
const leccionesGratuitas = curso?.modulos.flatMap(modulo => modulo.lecciones).filter(leccion => leccion.gratuita).length || 0;
---

<Layout title={`Vista Previa: ${curso?.titulo || 'Curso'}`}>
  <Header />

  <!-- Banner de Vista Previa -->
  <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white py-3">
    <div class="container mx-auto px-4 text-center">
      <div class="flex items-center justify-center gap-3">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
        </svg>
        <span class="font-semibold">MODO VISTA PREVIA - Esta es una vista previa de cómo los estudiantes verán el curso</span>
        <a 
          href={`/curso/editar-curso/${curso?.id_curso}`}
          class="bg-white/20 hover:bg-white/30 text-white font-medium px-4 py-1 rounded-full text-sm transition-colors"
        >
          Volver a Editar
        </a>
      </div>
    </div>
  </div>

  <!-- Hero Section Mejorada -->
  <section class="relative bg-gradient-to-br from-blue-700 via-purple-700 to-indigo-800 text-white py-20 overflow-hidden">
    <!-- Elementos decorativos de fondo -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-purple-400/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-blue-400/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Información del curso -->
        <div class="text-white">
          <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md border border-white/30 rounded-full px-4 py-2 mb-6 transition-all hover:bg-white/30">
            <span class="text-blue-100 text-sm font-medium">{curso?.categoria.nombre}</span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight animate-fade-in-up">
            {curso?.titulo}
          </h1>

          <p class="text-xl text-blue-100 mb-8 leading-relaxed opacity-90">
            {curso?.descripcion}
          </p>

          <div class="flex flex-wrap gap-6 items-center mb-8">
            <div class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
              <div class="flex items-center">
                {[1, 2, 3, 4, 5].map((star) => (
                  <svg 
                    class={`w-5 h-5 ${star <= Math.floor(curso?.valoracion_promedio || 0) ? 'text-yellow-400 fill-current' : 'text-gray-300'}`}
                    fill="currentColor" 
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="text-blue-100 text-sm">{curso?.valoracion_promedio} ({curso?.total_valoraciones} reseñas)</span>
            </div>
            <div class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
              <svg class="w-5 h-5 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span class="text-blue-100 text-sm">{curso?.estudiantes_inscritos.toLocaleString()}+ estudiantes</span>
            </div>
            <div class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2">
              <svg class="w-5 h-5 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-blue-100 text-sm">{curso?.tiempo_estimado_min} minutos totales</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-4">
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-medium capitalize">
              {curso?.nivel_dificultad}
            </span>
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-medium">
              {totalLecciones} lecciones
            </span>
            <span class="bg-white/20 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-medium">
              {leccionesGratuitas} lecciones gratuitas
            </span>
          </div>
        </div>

        <!-- Portada con imagen de fondo -->
        <div class="relative">
          <div class="bg-gradient-to-br from-blue-600/90 to-purple-700/90 rounded-3xl overflow-hidden shadow-2xl relative transform hover:scale-[1.02] transition-transform duration-500">
            <!-- Imagen de fondo con overlay -->
            <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80')] bg-cover bg-center opacity-20"></div>

            <div class="aspect-video flex items-center justify-center p-8 relative z-10">
              <div class="text-center text-white">
                <div class="w-24 h-24 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-6 backdrop-blur-sm border border-white/30 transform hover:scale-110 transition-transform duration-300">
                  <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold mb-2">Gestión del Agua</h3>
                <p class="text-blue-100 text-lg opacity-90">Sostenibilidad y Conservación</p>
                <div class="mt-6 flex justify-center space-x-3">
                  <span class="bg-white/20 px-4 py-2 rounded-full text-sm backdrop-blur-sm border border-white/30">Conservación</span>
                  <span class="bg-white/20 px-4 py-2 rounded-full text-sm backdrop-blur-sm border border-white/30">Sostenibilidad</span>
                  <span class="bg-white/20 px-4 py-2 rounded-full text-sm backdrop-blur-sm border border-white/30">Tecnología</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Course Content -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <!-- Tabs Mejoradas -->
          <div class="border-b border-gray-200 mb-8">
            <nav class="flex space-x-2 overflow-x-auto pb-1">
              <button id="tab-descripcion" class="tab-button flex items-center px-6 py-4 rounded-t-lg border-b-2 border-blue-600 text-blue-600 font-semibold whitespace-nowrap transition-all bg-blue-50">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Descripción
              </button>
              <button id="tab-contenido" class="tab-button flex items-center px-6 py-4 rounded-t-lg text-gray-500 hover:text-gray-700 font-semibold whitespace-nowrap transition-all hover:bg-gray-50">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                Contenido
              </button>
              <button id="tab-instructor" class="tab-button flex items-center px-6 py-4 rounded-t-lg text-gray-500 hover:text-gray-700 font-semibold whitespace-nowrap transition-all hover:bg-gray-50">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                Instructor
              </button>
            </nav>
          </div>

          <!-- Tab Contents -->
          <!-- Descripción Mejorada -->
          <div id="content-descripcion" class="tab-content active">
            <div class="prose max-w-none">
              <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center">
                <span class="bg-blue-100 p-2 rounded-lg mr-3">
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </span>
                Lo que aprenderás
              </h2>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
                {curso?.objetivos.map((objetivo, index) => (
                  <div class="flex items-start space-x-4 p-4 rounded-xl border border-gray-100 hover:border-blue-200 hover:bg-blue-50 transition-all duration-300 group">
                    <div class="bg-green-100 p-2 rounded-lg group-hover:scale-110 transition-transform">
                      <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <span class="text-gray-700 font-medium">{objetivo}</span>
                  </div>
                ))}
              </div>

              <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 mb-8 border border-blue-100">
                <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                  <span class="bg-blue-100 p-2 rounded-lg mr-3">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                  </span>
                  Descripción del curso
                </h3>
                <p class="text-gray-700 mb-6 leading-relaxed text-lg">
                  {curso?.descripcion}
                </p>
              </div>

              <div class="bg-gradient-to-r from-yellow-50 to-amber-50 border-l-4 border-yellow-400 rounded-r-xl p-6 mb-8">
                <div class="flex items-start">
                  <div class="flex-shrink-0 bg-yellow-100 p-3 rounded-lg">
                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                  </div>
                  <div class="ml-4">
                    <p class="text-lg font-semibold text-yellow-800">¡Novedad importante!</p>
                    <p class="text-yellow-700 mt-1">Este curso ha sido actualizado recientemente con las últimas tecnologías y mejores prácticas de 2024.</p>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                  <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                    <span class="bg-purple-100 p-2 rounded-lg mr-3">
                      <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                      </svg>
                    </span>
                    ¿Para quién es este curso?
                  </h3>
                  <ul class="space-y-3">
                    <li class="flex items-start space-x-3">
                      <svg class="w-5 h-5 text-green-500 mt-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">Profesionales en gestión ambiental</span>
                    </li>
                    <li class="flex items-start space-x-3">
                      <svg class="w-5 h-5 text-green-500 mt-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">Estudiantes de ciencias ambientales</span>
                    </li>
                    <li class="flex items-start space-x-3">
                      <svg class="w-5 h-5 text-green-500 mt-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">Interesados en sostenibilidad y conservación</span>
                    </li>
                  </ul>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                    <span class="bg-green-100 p-2 rounded-lg mr-3">
                      <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
