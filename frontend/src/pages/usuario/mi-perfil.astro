---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";
// src/pages/perfil-usuario.astro
---

<Layout title="Mi Perfil">
    <!-- Header -->
    <Header />

    <!-- Breadcrumb -->
    <nav class="bg-gradient-to-r from-blue-50 to-indigo-50 py-4 border-b border-blue-100">
        <div class="container mx-auto px-4">
            <div class="flex items-center space-x-2 text-sm">
                <a href="#" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 font-medium">Inicio</a>
                <span class="text-blue-300"><i class="fas fa-chevron-right text-xs"></i></span>
                <a href="#" class="text-blue-600 hover:text-blue-800 transition-colors duration-200 font-medium">Mi Cuenta</a>
                <span class="text-blue-300"><i class="fas fa-chevron-right text-xs"></i></span>
                <span class="text-blue-800 font-semibold">Mi Perfil</span>
            </div>
        </div>
    </nav>

    <!-- Enhanced Profile Hero Section -->
    <section class="relative bg-gradient-to-br from-blue-600 via-purple-600 to-indigo-700 text-white py-16 overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10">
            <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,<svg width=\"60\" =\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><circle fill=\"%23FFFFFF\" cx=\"30\" cy=\"30\" r=\"1\"/></g></svg>')"></div>
        </div>
        
        <div class="container mx-auto px-4 relative z-10">
            <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
                <!-- Enhanced Profile Picture -->
                <div class="relative group">
                    <div class="relative w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden border-4 border-white/40 shadow-2xl ring-4 ring-white/20 transition-all duration-300 group-hover:scale-105 group-hover:border-white/60">
                        <img src="https://images.unsplash.com/photo-1494790108755-2616b612b786?w=200&h=200&fit=crop&crop=face" 
                             alt="Foto de perfil" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                    </div>
                    <button class="absolute bottom-3 right-3 bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white p-3 rounded-full shadow-xl transition-all duration-300 transform hover:scale-110 group-hover:shadow-2xl">
                        <i class="fas fa-camera text-sm"></i>
                    </button>
                    <!-- Online Status -->
                    <div class="absolute top-3 right-3 w-4 h-4 bg-green-400 border-2 border-white rounded-full shadow-lg"></div>
                </div>

                <!-- Enhanced Profile Info -->
                <div class="flex-1 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-lg border border-white/30 rounded-full px-4 py-2 mb-4 shadow-lg">
                        <div class="w-2 h-2 bg-yellow-400 rounded-full animate-pulse"></div>
                        <span class="text-white text-sm font-semibold">Estudiante Premium</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl font-bold mb-3 bg-gradient-to-r from-white to-blue-100 bg-clip-text text-transparent">
                        Ana Rodríguez
                    </h1>
                    
                    <p class="text-xl text-blue-100 mb-6 font-light leading-relaxed">
                        Desarrolladora Frontend en formación • Apasionada por crear experiencias digitales increíbles
                    </p>

                    <div class="flex flex-wrap gap-6 justify-center lg:justify-start mb-6">
                        <div class="flex items-center space-x-3 bg-white/10 backdrop-blur-sm rounded-2xl px-4 py-2 border border-white/20">
                            <i class="fas fa-map-marker-alt text-blue-200 text-lg"></i>
                            <span class="text-blue-100 font-medium">Barcelona, España</span>
                        </div>
                        <div class="flex items-center space-x-3 bg-white/10 backdrop-blur-sm rounded-2xl px-4 py-2 border border-white/20">
                            <i class="fas fa-calendar-alt text-blue-200 text-lg"></i>
                            <span class="text-blue-100 font-medium">Miembro desde Ene 2023</span>
                        </div>
                        <div class="flex items-center space-x-3 bg-white/10 backdrop-blur-sm rounded-2xl px-4 py-2 border border-white/20">
                            <i class="fas fa-globe text-blue-200 text-lg"></i>
                            <span class="text-blue-100 font-medium">Español, Inglés</span>
                        </div>
                    </div>

                    <!-- Stats Overview -->
                    <div class="flex flex-wrap gap-6 justify-center lg:justify-start">
                        <div class="text-center">
                            <div class="text-2xl font-bold text-white">12</div>
                            <div class="text-blue-200 text-sm">Cursos</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-white">87h</div>
                            <div class="text-blue-200 text-sm">Estudiadas</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-white">8</div>
                            <div class="text-blue-200 text-sm">Logros</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-white">95%</div>
                            <div class="text-blue-200 text-sm">Progreso</div>
                        </div>
                    </div>
                </div>

                <!-- Enhanced Action Buttons -->
                <div class="flex flex-col sm:flex-row lg:flex-col gap-4">
                    <button class="group bg-white text-blue-600 px-8 py-4 rounded-2xl font-semibold hover:bg-gray-50 transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl flex items-center justify-center">
                        <i class="fas fa-edit mr-3 group-hover:scale-110 transition-transform"></i>
                        Editar Perfil
                    </button>
                    <button class="group border-2 border-white text-white px-8 py-4 rounded-2xl font-semibold hover:bg-white/10 transition-all duration-300 backdrop-blur-sm flex items-center justify-center">
                        <i class="fas fa-cog mr-3 group-hover:rotate-90 transition-transform"></i>
                        Configuración
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Enhanced Profile Content -->
    <section class="py-16 bg-gradient-to-br from-gray-50 to-blue-50/30">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 xl:grid-cols-4 gap-8">
                <!-- Enhanced Sidebar Navigation -->
                <div class="xl:col-span-1 space-y-6">
                    <div class="bg-white rounded-3xl p-6 border border-gray-200/60 shadow-lg shadow-blue-100/30 backdrop-blur-sm">
                        <nav class="space-y-2">
                            <a href="#" class="flex items-center space-x-4 p-4 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-600 font-semibold border border-blue-100 shadow-sm transition-all duration-200 hover:shadow-md">
                                <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-purple-500 rounded-xl flex items-center justify-center">
                                    <i class="fas fa-user-circle text-white text-lg"></i>
                                </div>
                                <span>Mi Perfil</span>
                            </a>
                            <a href="#" class="flex items-center space-x-4 p-4 rounded-2xl text-gray-700 hover:bg-gray-50/80 transition-all duration-200 group">
                                <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center group-hover:bg-blue-100 transition-colors">
                                    <i class="fas fa-play-circle text-gray-600 group-hover:text-blue-600 text-lg"></i>
                                </div>
                                <span>Mis Cursos</span>
                            </a>
                            <a href="#" class="flex items-center space-x-4 p-4 rounded-2xl text-gray-700 hover:bg-gray-50/80 transition-all duration-200 group">
                                <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center group-hover:bg-pink-100 transition-colors">
                                    <i class="fas fa-heart text-gray-600 group-hover:text-pink-600 text-lg"></i>
                                </div>
                                <span>Favoritos</span>
                            </a>
                            <a href="#" class="flex items-center space-x-4 p-4 rounded-2xl text-gray-700 hover:bg-gray-50/80 transition-all duration-200 group">
                                <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center group-hover:bg-green-100 transition-colors">
                                    <i class="fas fa-certificate text-gray-600 group-hover:text-green-600 text-lg"></i>
                                </div>
                                <span>Certificados</span>
                            </a>
                            <a href="#" class="flex items-center space-x-4 p-4 rounded-2xl text-gray-700 hover:bg-gray-50/80 transition-all duration-200 group">
                                <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center group-hover:bg-purple-100 transition-colors">
                                    <i class="fas fa-chart-bar text-gray-600 group-hover:text-purple-600 text-lg"></i>
                                </div>
                                <span>Progreso</span>
                            </a>
                            <a href="#" class="flex items-center space-x-4 p-4 rounded-2xl text-gray-700 hover:bg-gray-50/80 transition-all duration-200 group">
                                <div class="w-10 h-10 bg-gray-100 rounded-xl flex items-center justify-center group-hover:bg-orange-100 transition-colors">
                                    <i class="fas fa-cog text-gray-600 group-hover:text-orange-600 text-lg"></i>
                                </div>
                                <span>Configuración</span>
                            </a>
                        </nav>
                    </div>

                    <!-- Enhanced Stats Card -->
                    <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl p-6 text-white shadow-xl shadow-blue-200/30">
                        <h3 class="text-xl font-bold mb-6 flex items-center">
                            <i class="fas fa-trophy mr-3 text-yellow-300"></i>
                            Mi Progreso
                        </h3>
                        <div class="space-y-5">
                            <div>
                                <div class="flex justify-between text-sm font-medium mb-2">
                                    <span class="text-blue-100">Cursos Completados</span>
                                    <span class="text-white">5/12</span>
                                </div>
                                <div class="w-full bg-blue-400/30 rounded-full h-3">
                                    <div class="bg-gradient-to-r from-green-400 to-emerald-500 h-3 rounded-full shadow-lg shadow-green-500/25" style="width: 42%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm font-medium mb-2">
                                    <span class="text-blue-100">Horas de Estudio</span>
                                    <span class="text-white">87h</span>
                                </div>
                                <div class="w-full bg-blue-400/30 rounded-full h-3">
                                    <div class="bg-gradient-to-r from-blue-400 to-cyan-500 h-3 rounded-full shadow-lg shadow-blue-500/25" style="width: 65%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm font-medium mb-2">
                                    <span class="text-blue-100">Logros Desbloqueados</span>
                                    <span class="text-white">8/15</span>
                                </div>
                                <div class="w-full bg-blue-400/30 rounded-full h-3">
                                    <div class="bg-gradient-to-r from-purple-400 to-fuchsia-500 h-3 rounded-full shadow-lg shadow-purple-500/25" style="width: 53%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6 pt-6 border-t border-blue-400/30">
                            <div class="text-center">
                                <div class="text-2xl font-bold">95%</div>
                                <div class="text-blue-100 text-sm">Progreso Total</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Enhanced Main Content -->
                <div class="xl:col-span-3 space-y-8">
                    <!-- Enhanced Profile Card with Tabs -->
                    <div class="bg-white rounded-3xl border border-gray-200/60 shadow-lg shadow-blue-100/20 overflow-hidden">
                        <!-- Enhanced Tabs -->
                        <div class="border-b border-gray-200/60 bg-gradient-to-r from-gray-50 to-blue-50/30">
                            <nav class="flex overflow-x-auto px-6">
                                <button class="relative border-b-2 border-blue-600 text-blue-600 py-5 px-6 font-semibold whitespace-nowrap transition-all duration-200 group">
                                    <span class="flex items-center">
                                        <i class="fas fa-user-edit mr-3 text-lg"></i>
                                        Información Personal
                                    </span>
                                    <div class="absolute bottom-0 left-0 w-full h-0.5 bg-gradient-to-r from-blue-600 to-purple-600"></div>
                                </button>
                                <button class="text-gray-500 hover:text-gray-700 py-5 px-6 font-semibold whitespace-nowrap transition-all duration-200 group">
                                    <span class="flex items-center">
                                        <i class="fas fa-palette mr-3 text-lg"></i>
                                        Preferencias
                                    </span>
                                </button>
                                <button class="text-gray-500 hover:text-gray-700 py-5 px-6 font-semibold whitespace-nowrap transition-all duration-200 group">
                                    <span class="flex items-center">
                                        <i class="fas fa-bell mr-3 text-lg"></i>
                                        Notificaciones
                                    </span>
                                </button>
                                <button class="text-gray-500 hover:text-gray-700 py-5 px-6 font-semibold whitespace-nowrap transition-all duration-200 group">
                                    <span class="flex items-center">
                                        <i class="fas fa-shield-alt mr-3 text-lg"></i>
                                        Seguridad
                                    </span>
                                </button>
                            </nav>
                        </div>

                        <!-- Enhanced Profile Form -->
                        <div class="p-8">
                            <div class="flex items-center justify-between mb-8">
                                <h2 class="text-3xl font-bold text-gray-900">Información Personal</h2>
                                <div class="w-12 h-12 bg-gradient-to-r from-green-400 to-emerald-500 rounded-2xl flex items-center justify-center shadow-lg shadow-green-500/25">
                                    <i class="fas fa-check text-white text-lg"></i>
                                </div>
                            </div>
                            
                            <form class="space-y-8">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">Nombre</label>
                                        <input type="text" value="Ana" class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">Apellidos</label>
                                        <input type="text" value="Rodríguez" class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50">
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700 mb-3">Correo Electrónico</label>
                                    <input type="email" value="ana.rodriguez@ejemplo.com" class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50">
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">País</label>
                                        <select class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50 appearance-none cursor-pointer">
                                            <option selected>España</option>
                                            <option>México</option>
                                            <option>Argentina</option>
                                            <option>Colombia</option>
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">Idioma Preferido</label>
                                        <select class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50 appearance-none cursor-pointer">
                                            <option selected>Español</option>
                                            <option>Inglés</option>
                                            <option>Portugués</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- NUEVO CAMPO: ESCUELA -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">Escuela/Institución</label>
                                        <div class="relative">
                                            <select class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50 appearance-none cursor-pointer pr-12">
                                                <option value="" disabled selected>Selecciona tu escuela</option>
                                                <option>Universidad de Barcelona</option>
                                                <option>Universidad Politécnica de Cataluña</option>
                                                <option>Universidad Autónoma de Barcelona</option>
                                                <option>Universidad Pompeu Fabra</option>
                                                <option>Escuela Superior de Administración y Dirección de Empresas</option>
                                                <option>Otra institución</option>
                                            </select>
                                            <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
                                                <i class="fas fa-chevron-down text-gray-400"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">Programa de Estudio</label>
                                        <input type="text" placeholder="Ingeniería Informática, Diseño Gráfico, etc." class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50">
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700 mb-3">Biografía</label>
                                    <textarea rows="4" class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50 resize-none">Soy una desarrolladora frontend apasionada por crear experiencias web increíbles. Actualmente estoy ampliando mis conocimientos en desarrollo full stack para poder construir aplicaciones completas.</textarea>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">LinkedIn</label>
                                        <div class="relative">
                                            <input type="text" value="linkedin.com/in/anarodriguez" class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50 pl-12">
                                            <div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-blue-600">
                                                <i class="fab fa-linkedin text-lg"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700 mb-3">GitHub</label>
                                        <div class="relative">
                                            <input type="text" value="github.com/anarodriguez" class="w-full px-5 py-4 border-2 border-gray-200 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 hover:border-gray-300 bg-white/50 pl-12">
                                            <div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-800">
                                                <i class="fab fa-github text-lg"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex justify-end space-x-4 pt-8 border-t border-gray-200/60">
                                    <button type="button" class="px-8 py-4 border-2 border-gray-300 text-gray-700 rounded-2xl font-semibold hover:bg-gray-50 transition-all duration-200 transform hover:-translate-y-0.5 shadow-sm hover:shadow-md">
                                        Cancelar
                                    </button>
                                    <button type="submit" class="px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-2xl font-semibold hover:from-blue-700 hover:to-purple-700 transition-all duration-200 transform hover:-translate-y-0.5 shadow-lg hover:shadow-xl shadow-blue-500/25">
                                        Guardar Cambios
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Enhanced Recent Activity -->
                    <div class="bg-white rounded-3xl border border-gray-200/60 shadow-lg shadow-blue-100/20 overflow-hidden">
                        <div class="border-b border-gray-200/60 bg-gradient-to-r from-gray-50 to-blue-50/30 px-8 py-6">
                            <div class="flex items-center justify-between">
                                <h3 class="text-2xl font-bold text-gray-900 flex items-center">
                                    <i class="fas fa-history mr-3 text-blue-600"></i>
                                    Actividad Reciente
                                </h3>
                                <button class="text-blue-600 hover:text-blue-800 font-semibold text-sm flex items-center transition-colors">
                                    Ver todo
                                    <i class="fas fa-arrow-right ml-2 text-xs"></i>
                                </button>
                            </div>
                        </div>
                        <div class="p-8">
                            <div class="space-y-6">
                                <!-- Activity Item -->
                                <div class="flex items-start space-x-5 group p-4 rounded-2xl hover:bg-blue-50/50 transition-all duration-200 cursor-pointer">
                                    <div class="w-12 h-12 bg-gradient-to-r from-green-400 to-emerald-500 rounded-2xl flex items-center justify-center shadow-lg shadow-green-500/25 flex-shrink-0 group-hover:scale-110 transition-transform duration-200">
                                        <i class="fas fa-check text-white text-lg"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-gray-800 font-medium group-hover:text-gray-900 transition-colors">
                                            Completaste el curso <span class="font-semibold text-green-600">"Introducción a React"</span>
                                        </p>
                                        <p class="text-sm text-gray-500 mt-2 flex items-center">
                                            <i class="fas fa-clock mr-2 text-xs"></i>
                                            Hace 2 días • 95% de progreso
                                        </p>
                                    </div>
                                    <div class="text-2xl font-bold text-green-500 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                        100%
                                    </div>
                                </div>

                                <!-- Activity Item -->
                                <div class="flex items-start space-x-5 group p-4 rounded-2xl hover:bg-blue-50/50 transition-all duration-200 cursor-pointer">
                                    <div class="w-12 h-12 bg-gradient-to-r from-blue-400 to-cyan-500 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/25 flex-shrink-0 group-hover:scale-110 transition-transform duration-200">
                                        <i class="fas fa-play text-white text-lg"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-gray-800 font-medium group-hover:text-gray-900 transition-colors">
                                            Comenzaste el curso <span class="font-semibold text-blue-600">"Node.js Avanzado"</span>
                                        </p>
                                        <p class="text-sm text-gray-500 mt-2 flex items-center">
                                            <i class="fas fa-clock mr-2 text-xs"></i>
                                            Hace 5 días • 35% de progreso
                                        </p>
                                    </div>
                                    <div class="text-2xl font-bold text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                        35%
                                    </div>
                                </div>

                                <!-- Activity Item -->
                                <div class="flex items-start space-x-5 group p-4 rounded-2xl hover:bg-blue-50/50 transition-all duration-200 cursor-pointer">
