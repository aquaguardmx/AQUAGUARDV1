    <!-- Footer -->
    <Footer />

    <!-- El script permanece igual, solo se actualizaron los estilos -->
    <script define:vars={{ API_URL }}>
        document.addEventListener("DOMContentLoaded", async function () {
            const profileForm = document.getElementById("profileForm");
            const saveButton = document.getElementById("saveButton");
            const cancelButton = document.getElementById("cancelButton");
            const messageContainer =
                document.getElementById("messageContainer");
            const heroSection = document.getElementById("heroSection");

            // Recuperar datos del usuario y token
            const userDataRaw =
                localStorage.getItem("userData") ||
                sessionStorage.getItem("userData");
            const authToken =
                localStorage.getItem("authToken") ||
                sessionStorage.getItem("authToken");

            let user = null;
            try {
                user = userDataRaw ? JSON.parse(userDataRaw) : null;
            } catch (err) {
                console.error("Error parseando userData:", err);
            }

            // Si no hay usuario, redirigir (movido aquí)
            if (!user || !user.id_usuario) {
                showMessage(
                    "No se encontró información del usuario. Por favor, inicia sesión nuevamente.",
                    "error",
                );
                setTimeout(() => {
                    window.location.href = "/auth/login";
                }, 2000);
                return;
            }

            // Poblar displays y form con datos reales de user
            function populateUserData() {
                // Hero displays
                document.getElementById("user-fullname").textContent =
                    `${user.nombre || ""} ${user.ap_paterno || ""} ${user.ap_materno || ""}`.trim() ||
                    "Usuario";
                document.getElementById("user-email").textContent =
                    user.correo_electronico ||
                    user.email ||
                    "Correo no disponible";
                document
                    .getElementById("profilePic")
                    .querySelector("div").textContent = (user.nombre || "U")
                    .charAt(0)
                    .toUpperCase();
                document
                    .getElementById("roleBadge")
                    .querySelector("span").textContent = getRoleName(
                    user.id_rol || 2,
                );

                // Form inputs
                document.getElementById("nombre").value = user.nombre || "";
                document.getElementById("ap_paterno").value =
                    user.ap_paterno || "";
                document.getElementById("ap_materno").value =
                    user.ap_materno || "";
                document.getElementById("correo_electronico").value =
                    user.correo_electronico || user.email || "";

                // Selects (asumiendo campos en user)
                document.getElementById("pais").value = user.pais || "España";
                document.getElementById("idioma_preferido").value =
                    user.idioma_preferido || "Español";

                // Remover loading
                heroSection.classList.remove("opacity-75");
                const loader = heroSection.querySelector(
                    'div[style*="bg-black"]',
                );
                if (loader) loader.remove();
            }

            // Función getRoleName (duplicada en JS para client)
            function getRoleName(idRol) {
                const roles = {
                    1: "Administrador",
                    2: "Usuario",
                    3: "Docente",
                };
                return roles[idRol] || "Usuario";
            }

            // Fetch stats de API (ejemplo; adáptalo)
            async function fetchUserStats() {
                try {
                    const response = await fetch(
                        `${API_URL}/usuarios/${user.id_usuario}`,
                        {
                            headers: { Authorization: `Bearer ${authToken}` },
                        },
                    );
                    if (response.ok) {
                        const stats = await response.json();
                        // Actualizar displays (ejemplos)
                        document.getElementById("stat-cursos").textContent =
                            stats.cursos || 0;
                        document.getElementById("stat-horas").textContent =
                            stats.horas || "0h";
                        document.getElementById("stat-logros").textContent =
                            stats.logros || 0;
                        document.getElementById("stat-progreso").textContent =
                            stats.progreso || "0%";
                        // Actualizar barras de progreso (ej. width basado en %)
                        document.getElementById("progress-cursos").style.width =
                            `${(stats.cursos_completados / stats.cursos_total) * 100}%`;
                        // ... similar para otros
                    }
                } catch (err) {
                    console.error("Error fetching stats:", err);
                }
            }

            // Llamar funciones
            populateUserData();
            await fetchUserStats(); // Opcional, si tienes endpoint

            // Mostrar mensaje
            function showMessage(message, type = "info") {
                const bgColor =
                    type === "error"
                        ? "bg-red-50 border-red-200 text-red-800"
                        : type === "success"
                          ? "bg-green-50 border-green-200 text-green-800"
                          : "bg-blue-50 border-blue-200 text-blue-800";

                const icon =
                    type === "error" ? "❌" : type === "success" ? "✅" : "ℹ️";

                messageContainer.innerHTML = `
                        <div class="${bgColor} border rounded-2xl p-4 flex items-center space-x-3 animate-fade-in">
                            <span class="text-lg">${icon}</span>
                            <span class="flex-1 font-medium">${message}</span>
                        </div>
                    `;

                if (type === "success") {
                    setTimeout(() => {
                        messageContainer.innerHTML = "";
                    }, 5000);
                }
            }

            // Enviar formulario (sin cambios, pero agrega manejo 401)
            profileForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                const formData = new FormData(profileForm);
                const data = {
                    nombre: formData.get("nombre"),
                    ap_paterno: formData.get("ap_paterno"),
                    ap_materno: formData.get("ap_materno"),
                    correo_electronico: formData.get("correo_electronico"),
                    pais: formData.get("pais"),
                    idioma_preferido: formData.get("idioma_preferido"),
                };

                const contrasena = formData.get("contrasena");
                if (contrasena && contrasena.trim() !== "") {
                    data.contrasena = contrasena;
                }

                if (
                    !data.nombre ||
                    !data.ap_paterno ||
                    !data.correo_electronico
                ) {
                    showMessage(
                        "Por favor, completa todos los campos obligatorios",
                        "error",
                    );
                    return;
                }

                if (data.contrasena && data.contrasena.length < 8) {
                    showMessage(
                        "La contraseña debe tener al menos 8 caracteres",
                        "error",
                    );
                    return;
                }

                try {
                    saveButton.disabled = true;
                    saveButton.innerHTML = `
                            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Guardando...
                        `;

                    console.log("User ID antes de fetch:", user.id_usuario);

                    const response = await fetch(
                        `${API_URL}/usuarios/${user.id_usuario}`,
                        {
                            method: "PUT",
                            headers: {
                                "Content-Type": "application/json",
                                Authorization: `Bearer ${authToken}`,
                                Accept: "application/json",
                                "X-Requested-With": "XMLHttpRequest",
                            },
                            body: JSON.stringify(data),
                        },
                    );

                    const result = await response.json();

                    if (response.ok) {
                        showMessage(
                            "Perfil actualizado correctamente",
                            "success",
                        );

                        // Actualizar user local
                        Object.assign(user, data);
                        if (localStorage.getItem("userData")) {
                            localStorage.setItem(
                                "userData",
                                JSON.stringify(user),
                            );
                        }
                        if (sessionStorage.getItem("userData")) {
                            sessionStorage.setItem(
                                "userData",
                                JSON.stringify(user),
                            );
                        }

                        // Repoblar displays y form inmediatamente
                        populateUserData();

                        setTimeout(() => {
                            window.location.reload();
                        }, 2000);
                    } else if (response.status === 401) {
                        showMessage(
                            "Sesión expirada. Redirigiendo al login.",
                            "error",
                        );
                        localStorage.removeItem("userData");
                        localStorage.removeItem("authToken");
                        sessionStorage.clear();
                        setTimeout(() => {
                            window.location.href = "/auth/login";
                        }, 2000);
                    } else {
                        if (result.errors) {
                            const errorMessages = Object.values(result.errors)
                                .flat()
                                .join(", ");
                            showMessage(
                                `Error de validación: ${errorMessages}`,
                                "error",
                            );
                        } else {
                            showMessage(
                                result.message ||
                                    "Error al actualizar el perfil",
                                "error",
                            );
                        }
                    }
                } catch (error) {
                    console.error("Error:", error);
                    showMessage(
                        "Error de conexión. Por favor, intenta nuevamente.",
                        "error",
                    );
                } finally {
                    saveButton.disabled = false;
                    saveButton.innerHTML = "Guardar Cambios";
                }
            });

            // Botón cancelar
            cancelButton.addEventListener("click", function () {
                populateUserData(); // Restaurar valores originales
                messageContainer.innerHTML = "";
            });

            // Validación en tiempo real para contraseña (sin cambios)
            const contrasenaInput = document.getElementById("contrasena");
            if (contrasenaInput) {
                contrasenaInput.addEventListener("input", function () {
                    const value = this.value;
                    if (value && value.length > 0 && value.length < 8) {
                        this.classList.add("border-red-300", "bg-red-50");
                        this.classList.remove("border-gray-300");
                    } else {
                        this.classList.remove("border-red-300", "bg-red-50");
                        this.classList.add("border-gray-300");
                    }
                });
            }

            // Botón editar perfil: scroll al form (opcional)
            document
                .getElementById("editProfileBtn")
                .addEventListener("click", () => {
                    document
                        .querySelector("#profileForm")
                        .scrollIntoView({ behavior: "smooth" });
                });
        });

        // Animación CSS para el mensaje (sin cambios)
        const style = document.createElement("style");
        style.textContent = `
                @keyframes fade-in {
                    from { opacity: 0; transform: translateY(-10px); }
                    to { opacity: 1; transform: translateY(0); }
                }
                .animate-fade-in {
                    animation: fade-in 0.3s ease-out;
                }
            `;
        document.head.appendChild(style);
    </script></Layout
