---
// src/pages/curso/[id].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";
import ContenidoPrincipal from "../../components/aquaguard-components/ContenidoPrincipal.astro";
import ModulosSidebar from "../../components/aquaguard-components/ModuloSidebar.astro";

// Datos estáticos del curso
const curso = {
  id_curso: 1,
  titulo: "Fundamentos de la Conservación del Agua",
  descripcion: "Aprende los principios esenciales para preservar y gestionar eficientemente los recursos hídricos en tu comunidad y entorno laboral.",
  portada_url: "/images/curso-agua.jpg",
  instructor: "María González",
  categoria: "Conservación",
  progreso_total: 65,
  modulos: [
    {
      id_modulo: 1,
      titulo: "Introducción al Ciclo del Agua",
      descripcion: "Comprende el proceso natural del agua en nuestro planeta",
      orden: 1,
      completado: true,
      lecciones: [
        {
          id_leccion: 1,
          titulo: "El ciclo hidrológico",
          descripcion: "Exploración detallada del proceso natural del agua",
          duracion_min: 15,
          tipo: "video",
          url_contenido: "/videos/ciclo-hidrologico.mp4",
          completado: true,
          bloqueado: false
        },
        {
          id_leccion: 2,
          titulo: "Importancia del agua dulce",
          descripcion: "Por qué el agua dulce es un recurso vital y limitado",
          duracion_min: 10,
          tipo: "lectura",
          url_contenido: "/lecturas/importancia-agua.pdf",
          completado: true,
          bloqueado: false
        }
      ]
    },
    {
      id_modulo: 2,
      titulo: "Problemática Actual del Agua",
      descripcion: "Analiza los principales desafíos globales del agua",
      orden: 2,
      completado: true,
      lecciones: [
        {
          id_leccion: 3,
          titulo: "Escasez hídrica mundial",
          descripcion: "Situación actual de la disponibilidad de agua",
          duracion_min: 20,
          tipo: "video",
          url_contenido: "/videos/escasez-hidrica.mp4",
          completado: true,
          bloqueado: false
        },
        {
          id_leccion: 4,
          titulo: "Contaminación de fuentes naturales",
          descripcion: "Principales contaminantes y sus efectos",
          duracion_min: 15,
          tipo: "lectura",
          url_contenido: "/lecturas/contaminacion-fuentes.pdf",
          completado: true,
          bloqueado: false
        }
      ]
    },
    {
      id_modulo: 3,
      titulo: "Técnicas de Conservación Doméstica",
      descripcion: "Aplica métodos prácticos para ahorrar agua en casa",
      orden: 3,
      completado: false,
      lecciones: [
        {
          id_leccion: 5,
          titulo: "Sistemas de captación de agua de lluvia",
          descripcion: "Implementa métodos para aprovechar el agua pluvial",
          duracion_min: 25,
          tipo: "video",
          url_contenido: "/videos/captacion-lluvia.mp4",
          completado: false,
          bloqueado: false
        },
        {
          id_leccion: 6,
          titulo: "Dispositivos ahorradores",
          descripcion: "Tecnologías para reducir el consumo de agua",
          duracion_min: 18,
          tipo: "lectura",
          url_contenido: "/lecturas/dispositivos-ahorradores.pdf",
          completado: false,
          bloqueado: false
        },
        {
          id_leccion: 7,
          titulo: "Prácticas de jardinería eficiente",
          descripcion: "Métodos de riego y selección de plantas",
          duracion_min: 22,
          tipo: "video",
          url_contenido: "/videos/jardineria-eficiente.mp4",
          completado: false,
          bloqueado: false
        }
      ]
    },
    {
      id_modulo: 4,
      titulo: "Evaluación Final",
      descripcion: "Demuestra lo aprendido en el curso",
      orden: 4,
      completado: false,
      lecciones: [
        {
          id_leccion: 8,
          titulo: "Quiz Final - Conservación del Agua",
          descripcion: "Evalúa tus conocimientos sobre conservación hídrica",
          duracion_min: 30,
          tipo: "quiz",
          url_contenido: "/quizes/quiz-final",
          completado: false,
          bloqueado: true  // Bloqueado hasta completar todos los módulos
        }
      ]
    }
  ]
};

const todosLosModulosCompletados = curso.modulos.slice(0, -1).every(modulo => modulo.completado);
const quiz = curso.modulos[3].lecciones[0];
---

<Layout title={curso.titulo}>
  <Header />
  
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <!-- Hero Section del Curso -->
    <section class="bg-gradient-to-br from-blue-900 via-blue-800 to-teal-700 text-white">
      <div class="container mx-auto px-6 py-12">
        <div class="flex flex-col lg:flex-row items-start gap-8">
          <!-- Imagen y info principal -->
          <div class="flex-1">
            <nav class="flex items-center gap-2 text-blue-200 mb-6">
              <a href="/" class="hover:text-white transition-colors">Inicio</a>
              <span>›</span>
              <a href="/cursos" class="hover:text-white transition-colors">Cursos</a>
              <span>›</span>
              <span class="text-white font-semibold">{curso.titulo}</span>
            </nav>
            
            <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">{curso.titulo}</h1>
            <p class="text-xl text-blue-100 mb-6 leading-relaxed">{curso.descripcion}</p>
            
            <div class="flex flex-wrap gap-6 items-center">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center font-bold text-white shadow-lg">
                  MG
                </div>
                <div>
                  <p class="font-semibold text-lg">{curso.instructor}</p>
                  <p class="text-blue-200 text-sm">Instructor especializado</p>
                </div>
              </div>
              <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                </svg>
                <span>{curso.categoria}</span>
              </div>
            </div>
          </div>
          
          <!-- Progress Card -->
          <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 lg:w-80 border border-white/20">
            <div class="text-center mb-6">
              <div class="relative inline-block">
                <svg class="w-24 h-24 transform -rotate-90">
                  <circle cx="48" cy="48" r="40" stroke="rgba(255,255,255,0.3)" stroke-width="8" fill="none"/>
                  <circle cx="48" cy="48" r="40" stroke="white" stroke-width="8" fill="none" 
                          stroke-dasharray="251.2" 
                          stroke-dashoffset={251.2 * (1 - curso.progreso_total / 100)}/>
                </svg>
                <span class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white font-bold text-xl">
                  {curso.progreso_total}%
                </span>
              </div>
            </div>
            
            <div class="space-y-4">
              <div class="flex justify-between text-sm">
                <span class="text-blue-200">Progreso Total</span>
                <span class="font-semibold">{curso.progreso_total}%</span>
              </div>
              
              <div class="flex justify-between text-sm">
                <span class="text-blue-200">Módulos Completados</span>
                <span class="font-semibold">
                  {curso.modulos.filter(m => m.completado).length}/{curso.modulos.length}
                </span>
              </div>

              <div class="flex justify-between text-sm">
                <span class="text-blue-200">Lecciones Restantes</span>
                <span class="font-semibold">
                  {curso.modulos.flatMap(m => m.lecciones).filter(l => !l.completado && !l.bloqueado).length}
                </span>
              </div>
            </div>

            <button class="w-full mt-6 bg-white text-blue-600 hover:bg-blue-50 font-semibold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg">
              Continuar Aprendiendo
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Contenido Principal -->
    <main class="container mx-auto px-6 py-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar de Navegación -->
        <div class="lg:w-1/3">
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg sticky top-8 border border-gray-200 dark:border-gray-700">
            <ModulosSidebar modulos={curso.modulos} cursoId={curso.id_curso} />
          </div>
        </div>
        
        <!-- Área de Contenido -->
        <div class="lg:w-2/3">
          <ContenidoPrincipal curso={curso} />
        </div>
      </div>
    </main>
  </div>

  <Footer />
</Layout>

<style>
  .sticky {
    position: sticky;
  }

  /* Animaciones suaves */
  .transition-all {
    transition: all 0.3s ease;
  }

  /* Mejoras de accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .transition-all,
    .transform {
      transition: none;
      transform: none;
    }
  }

  /* Efectos hover mejorados */
  .hover\\:scale-105:hover {
    transform: scale(1.05);
  }

  /* Scroll suave */
  html {
    scroll-behavior: smooth;
  }
</style>
