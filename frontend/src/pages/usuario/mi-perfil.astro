                                    </div>
                                    <div class="space-y-3">
                                        <label
                                            class="block text-sm font-semibold text-gray-700 mb-3 flex items-center"
                                            ><i
                                                class="fas fa-envelope mr-2 text-blue-500"
                                            ></i>Correo Electrónico *</label
                                        >
                                        <input
                                            type="email"
