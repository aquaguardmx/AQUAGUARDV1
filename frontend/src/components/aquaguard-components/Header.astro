<header>
    <div class="wrapper_inner">
        <div class="header_inner clearfix">
            <div class="logo_wrapper">
                <a href="/">
                    <img src="/img/logo.png" alt="AquaGuard" />
                </a>
            </div>

            <nav class="main_menu">
                <ul>
                    <li class="active"><a href="/">Home</a></li>
                    <li><a href="/aquaguard/comoUsar">Cómo Usar</a></li>
                    <li>
                        <a href="/aquaguard/contenidoEducativo">Educación</a>
                    </li>
                    <li><a href="/aquaguard/mapaContaminacion">Mapa</a></li>
                    <li><a href="/aquaguard/juego">Juego</a></li>
                    <li><a href="/aquaguard/trivia">Trivia</a></li>
                    <li><a href="/usuario/index-elearning">E-Learning</a></li>
                    <li><a href="../auth/login">Login</a></li>
                    <li><a href="../auth/register">Registrarse</a></li>
                    <li>
                        <a class="flex items-center h-full">
                            <svg
                                class="w-8 h-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                                stroke-width="1.5"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                ></path>
                            </svg>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="mobile_menu_button">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </div>
</header>

<script>
    const menuButton = document.querySelector(".mobile_menu_button");
    const mainMenu = document.querySelector(".main_menu");
    // Comenta
    if (menuButton && mainMenu) {
        menuButton.addEventListener("click", () => {
            mainMenu.classList.toggle("active");

            // Toggle icon
            const icon = menuButton.querySelector("i");
            if (icon) {
                if (mainMenu.classList.contains("active")) {
                    icon.classList.remove("fa-bars");
                    icon.classList.add("fa-times");
                } else {
                    icon.classList.remove("fa-times");
                    icon.classList.add("fa-bars");
                }
            }
        });
    }
</script>

<style>
    /* Estilos responsivos */
    @media (max-width: 992px) {
        .mobile_menu_button {
            display: block;
            color: var(--primary-color, #0077b6);
            font-size: 1.8rem;
            cursor: pointer;
            z-index: 1001;
        }

        .main_menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            padding: 20px 0;
            z-index: 1000;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
        }

        .main_menu.active {
            display: block;
            animation: slideDown 0.3s ease-out forwards;
        }

        .main_menu ul {
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .main_menu ul li {
            margin: 5px 0;
            width: 100%;
            text-align: center;
        }

        .main_menu ul li a {
            display: block;
            padding: 10px;
            font-size: 1.1rem;
        }

        .main_menu ul li:last-child {
            display: flex;
            justify-content: center;
        }
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
