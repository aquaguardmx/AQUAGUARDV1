---
// src/components/Footer.astro
---
<footer class="bg-gradient-to-b from-gray-900 to-blue-900 text-white relative overflow-hidden">
  <!-- Elementos decorativos de fondo -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-10 left-10 w-32 h-32 bg-blue-400 rounded-full blur-xl"></div>
    <div class="absolute top-40 right-20 w-48 h-48 bg-teal-400 rounded-full blur-xl"></div>
    <div class="absolute bottom-20 left-1/3 w-40 h-40 bg-cyan-400 rounded-full blur-xl"></div>
  </div>

  <!-- Olas decorativas -->
  <div class="absolute top-0 left-0 right-0 transform translate-y-1">
    <svg class="w-full h-12 text-blue-800" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" fill="currentColor"></path>
    </svg>
  </div>

  <div class="container mx-auto px-6 pt-20 pb-8 relative z-10">
    <!-- Contenido principal del footer -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Columna 1: Logo y descripción -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 flex items-center justify-center bg-gradient-to-br from-blue-500 to-teal-400 rounded-xl shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path>
            </svg>
          </div>
          <div>
            <span class="text-2xl font-bold">AquaGuard</span>
            <p class="text-blue-200 text-sm -mt-1">Eco Learning</p>
          </div>
        </div>
        <p class="text-blue-100 mb-6 leading-relaxed">
          Líder en educación ambiental especializada en el cuidado y conservación del agua. 
          Formamos a la próxima generación de protectores del planeta.
        </p>
        <div class="flex space-x-4">
          <a href="#" class="w-10 h-10 bg-blue-700 hover:bg-blue-600 rounded-lg flex items-center justify-center transition-all transform hover:scale-110">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 bg-blue-700 hover:bg-blue-600 rounded-lg flex items-center justify-center transition-all transform hover:scale-110">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 bg-blue-700 hover:bg-blue-600 rounded-lg flex items-center justify-center transition-all transform hover:scale-110">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 bg-blue-700 hover:bg-blue-600 rounded-lg flex items-center justify-center transition-all transform hover:scale-110">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.042-3.441.219-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001.012.001 12.017 0z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Enlaces rápidos -->
      <div>
        <h3 class="text-lg font-bold mb-6 text-blue-200 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
          Enlaces Rápidos
        </h3>
        <ul class="space-y-3">
          <li><a href="/cursos" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Todos los Cursos
          </a></li>
          <li><a href="/blog" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Blog Ambiental
          </a></li>
          <li><a href="/recursos" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Recursos Gratuitos
          </a></li>
          <li><a href="/eventos" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Eventos y Webinars
          </a></li>
          <li><a href="/certificaciones" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Certificaciones
          </a></li>
        </ul>
      </div>

      <!-- Columna 3: Soporte -->
      <div>
        <h3 class="text-lg font-bold mb-6 text-blue-200 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Soporte
        </h3>
        <ul class="space-y-3">
          <li><a href="/centro-ayuda" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Centro de Ayuda
          </a></li>
          <li><a href="/contacto" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Contáctanos
          </a></li>
          <li><a href="/preguntas-frecuentes" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Preguntas Frecuentes
          </a></li>
          <li><a href="/politica-privacidad" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Política de Privacidad
          </a></li>
          <li><a href="/terminos" class="text-blue-100 hover:text-white transition-colors flex items-center gap-2 group">
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Términos de Servicio
          </a></li>
        </ul>
      </div>

      <!-- Columna 4: Newsletter -->
      <div>
        <h3 class="text-lg font-bold mb-6 text-blue-200 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Newsletter
        </h3>
        <p class="text-blue-100 mb-4">
          Suscríbete para recibir noticias sobre nuevos cursos, recursos gratuitos y tips de conservación del agua.
        </p>
        <form class="space-y-3">
          <input 
            type="email" 
            placeholder="Tu correo electrónico" 
            class="w-full px-4 py-3 bg-blue-800 border border-blue-600 rounded-lg text-white placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent"
            required
          >
          <button 
            type="submit"
            class="w-full bg-gradient-to-r from-blue-500 to-teal-400 hover:from-blue-600 hover:to-teal-500 text-white font-semibold py-3 px-6 rounded-lg transition-all transform hover:scale-105 shadow-lg"
          >
            Suscribirse
          </button>
        </form>
        <p class="text-blue-300 text-xs mt-3">
          Respetamos tu privacidad. Puedes darte de baja en cualquier momento.
        </p>
      </div>
    </div>

    <!-- Línea divisoria -->
    <div class="border-t border-blue-700 my-8"></div>

    <!-- Footer inferior -->
    <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
      <div class="text-blue-300 text-sm">
        © 2024 AquaGuard Eco Learning. Todos los derechos reservados.
      </div>
      
      <div class="flex items-center space-x-6 text-blue-300 text-sm">
        <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/terminos" class="hover:text-white transition-colors">Términos</a>
        <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
        <a href="/mapa-sitio" class="hover:text-white transition-colors">Mapa del Sitio</a>
      </div>

      <div class="flex items-center space-x-2 text-blue-300 text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Hecho con 💧 para el planeta</span>
      </div>
    </div>
  </div>

  <!-- Burbujas decorativas en el fondo -->
  <div class="absolute bottom-0 left-0 right-0 h-20 overflow-hidden">
    <div class="bubble-footer bubble-f-1"></div>
    <div class="bubble-footer bubble-f-2"></div>
    <div class="bubble-footer bubble-f-3"></div>
    <div class="bubble-footer bubble-f-4"></div>
    <div class="bubble-footer bubble-f-5"></div>
  </div>
</footer>

<style>
/* Animaciones de burbujas para el footer */
.bubble-footer {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float-footer 15s infinite ease-in-out;
  bottom: -20px;
}

.bubble-f-1 {
  width: 20px;
  height: 20px;
  left: 10%;
  animation-delay: 0s;
}

.bubble-f-2 {
  width: 30px;
  height: 30px;
  left: 25%;
  animation-delay: 3s;
}

.bubble-f-3 {
  width: 25px;
  height: 25px;
  left: 45%;
  animation-delay: 6s;
}

.bubble-f-4 {
  width: 35px;
  height: 35px;
  left: 65%;
  animation-delay: 9s;
}

.bubble-f-5 {
  width: 28px;
  height: 28px;
  left: 85%;
  animation-delay: 12s;
}

@keyframes float-footer {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.7;
  }
  25% {
    transform: translateY(-40px) scale(1.1);
    opacity: 0.9;
  }
  50% {
    transform: translateY(-80px) scale(1);
    opacity: 0.7;
  }
  75% {
    transform: translateY(-40px) scale(0.9);
    opacity: 0.5;
  }
}

/* Mejoras de responsive */
@media (max-width: 768px) {
  .bubble-footer {
    display: none;
  }
}

/* Efectos de transición suaves */
.transition-all {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Mejoras de accesibilidad */
@media (prefers-reduced-motion: reduce) {
  .bubble-footer,
  .transition-all {
    animation: none;
    transition: none;
  }
}
</style>