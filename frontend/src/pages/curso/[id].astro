---
// src/pages/curso/[id].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";
import ContenidoPrincipal from "../../components/aquaguard-components/ContenidoPrincipal.astro";
import ModulosSidebar from "../../components/aquaguard-components/ModuloSidebar.astro";

const { id } = Astro.params;
const usuarioId = 1; // Por ahora hardcodeado

// Variables de estado
let curso = null;
let progresoUsuario = null;
let error = null;

try {
  // 1. Fetch paralelo: Curso, Progreso y Quiz
  // Usamos el ID del curso (Astro.params.id) para buscar el quiz asociado
  const [cursoResponse, progresoResponse, quizResponse] = await Promise.all([
    fetch(`https://aquaguardv1.onrender.com/api/cursos/${id}`),
    fetch(
      `https://aquaguardv1.onrender.com/api/progreso-lecciones/usuario/${usuarioId}/curso/${id}`,
    ),
    fetch(`https://aquaguardv1.onrender.com/api/quizzes/curso/${id}`),
  ]);

  if (!cursoResponse.ok) {
    throw new Error(
      `Error ${cursoResponse.status}: ${cursoResponse.statusText}`,
    );
  }

  const cursoData = await cursoResponse.json();

  // Obtener progreso del usuario
  if (progresoResponse.ok) {
    progresoUsuario = await progresoResponse.json();
  } else {
    progresoUsuario = [];
  }

  // 2. Procesar el Quiz Final y OBTENER SU ID
  let quizFinal = null;

  if (quizResponse.ok) {
    const quizzes = await quizResponse.json();

    // IMPORTANTE: Tu API devuelve un array "[]".
    // Verificamos si hay elementos y tomamos el primero (quizzes[0])
    if (Array.isArray(quizzes) && quizzes.length > 0) {
      // Aquí guardamos todo el objeto del quiz, que incluye el campo 'id'
      quizFinal = quizzes[0];
      console.log("Quiz encontrado ID:", quizFinal.id); // Debug para ver el ID
    }
  }

  // Transformar los datos e inyectar el quiz encontrado
  curso = transformarDatosCurso(cursoData, progresoUsuario, quizFinal);
} catch (err: any) {
  console.error("Error fetching curso:", err);
  error = err.message;
}

// --- FUNCIONES AUXILIARES ---

function encontrarSiguienteLeccion(modulos: any[]) {
  for (const modulo of modulos) {
    for (const leccion of modulo.lecciones) {
      if (!leccion.completado && !leccion.bloqueado) {
        return {
          id_leccion: leccion.id_leccion,
          id_modulo: modulo.id_modulo,
          titulo: leccion.titulo,
        };
      }
    }
  }
  return null;
}

function encontrarPrimeraLeccion(modulos: any[]) {
  if (modulos.length > 0 && modulos[0].lecciones.length > 0) {
    const primeraLeccion = modulos[0].lecciones[0];
    return {
      id_leccion: primeraLeccion.id_leccion,
      id_modulo: modulos[0].id_modulo,
      titulo: primeraLeccion.titulo,
    };
  }
  return null;
}

function transformarDatosCurso(
  cursoAPI: any,
  progresoUsuario: any[],
  quizFinal: any,
) {
  const leccionesCompletadasIds = progresoUsuario.map(
    (progreso: any) => progreso.leccion_id,
  );

  const modulosTransformados = cursoAPI.modulos.map((modulo: any) => {
    const leccionesTransformadas = modulo.lecciones.map((leccion: any) => {
      const leccionCompletada = leccionesCompletadasIds.includes(
        leccion.id_leccion,
      );
      return {
        id_leccion: leccion.id_leccion,
        titulo: leccion.titulo,
        descripcion: extraerDescripcion(leccion.contenido_texto),
        duracion_min: 15,
        tipo: mapearTipoContenido(leccion.tipo_contenido),
        url_contenido: leccion.video_url || "#",
        completado: leccionCompletada,
        bloqueado: false,
        contenido_original: {
          tipo_contenido: leccion.tipo_contenido,
          contenido_texto: leccion.contenido_texto,
          video_url: leccion.video_url,
        },
      };
    });

    const moduloCompletado = leccionesTransformadas.every(
      (leccion: any) => leccion.completado,
    );

    return {
      id_modulo: modulo.id_modulo,
      titulo: modulo.titulo,
      descripcion: `Módulo ${modulo.orden} del curso ${cursoAPI.titulo}`,
      orden: modulo.orden,
      completado: moduloCompletado,
      lecciones: leccionesTransformadas,
    };
  });

  const totalLecciones = modulosTransformados.reduce(
    (total: number, modulo: any) => total + modulo.lecciones.length,
    0,
  );
  const leccionesCompletadas = modulosTransformados.reduce(
    (total: number, modulo: any) =>
      total + modulo.lecciones.filter((l: any) => l.completado).length,
    0,
  );
  const progreso_total =
    totalLecciones > 0
      ? Math.round((leccionesCompletadas / totalLecciones) * 100)
      : 0;

  return {
    id_curso: cursoAPI.id_curso,
    titulo: cursoAPI.titulo,
    descripcion: cursoAPI.descripcion,
    portada_url: `https://aquaguardv1.onrender.com/storage/${cursoAPI.portada_url}`,
    instructor: `${cursoAPI.autor.nombre} ${cursoAPI.autor.ap_paterno}`,
    categoria: cursoAPI.categoria.nombre,
    progreso_total: progreso_total,
    modulos: modulosTransformados,
    // Pasamos el quiz final (que contiene el ID) al objeto curso
    quizFinal: quizFinal,
    estadisticas: {
      totalLecciones: totalLecciones,
      leccionesCompletadas: leccionesCompletadas,
      totalModulos: modulosTransformados.length,
      modulosCompletados: modulosTransformados.filter((m: any) => m.completado)
        .length,
      leccionesRestantes: totalLecciones - leccionesCompletadas,
      tieneProgreso: leccionesCompletadas > 0,
    },
    navegacion: {
      siguienteLeccion: encontrarSiguienteLeccion(modulosTransformados),
      primeraLeccion: encontrarPrimeraLeccion(modulosTransformados),
    },
    datos_originales: {
      tiempo_estimado_min: cursoAPI.tiempo_estimado_min,
      objetivos_aprendizaje: cursoAPI.objetivos_aprendizaje,
      autor: cursoAPI.autor,
      categoria: cursoAPI.categoria,
    },
  };
}

function extraerDescripcion(contenidoTexto: string) {
  if (!contenidoTexto) return "Contenido de la lección";
  const textoLimpio = contenidoTexto.replace(/<[^>]*>/g, "");
  return textoLimpio.length > 100
    ? textoLimpio.substring(0, 100) + "..."
    : textoLimpio;
}

function mapearTipoContenido(tipoAPI: string) {
  const mapeo: Record<string, string> = {
    texto: "lectura",
    mixto: "video",
    video: "video",
    quiz: "quiz",
  };
  return mapeo[tipoAPI] || "lectura";
}
---

<Layout title={curso?.titulo || "Curso no encontrado"}>
  <Header />

  {
    error ? (
      <div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
        <div class="text-center">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Error al cargar el curso
          </h1>
          <p class="text-gray-600 dark:text-gray-400 mb-6">{error}</p>
          <a
            href="/cursos"
            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition-colors"
          >
            Volver a los cursos
          </a>
        </div>
      </div>
    ) : !curso ? (
      <div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
        <div class="text-center">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4" />
          <p class="text-gray-600 dark:text-gray-400">Cargando curso...</p>
        </div>
      </div>
    ) : (
      <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
        <section class="bg-gradient-to-br from-blue-900 via-blue-800 to-teal-700 text-white">
          <div class="container mx-auto px-6 py-12">
            <div class="flex flex-col lg:flex-row items-start gap-8">
              <div class="flex-1">
                <nav class="flex items-center gap-2 text-blue-200 mb-6">
                  <a href="/" class="hover:text-white transition-colors">
                    Inicio
                  </a>
                  <span>›</span>
                  <a href="/cursos" class="hover:text-white transition-colors">
                    Cursos
                  </a>
                  <span>›</span>
                  <span class="text-white font-semibold">{curso.titulo}</span>
                </nav>

                <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">
                  {curso.titulo}
                </h1>
                <p class="text-xl text-blue-100 mb-6 leading-relaxed">
                  {curso.descripcion}
                </p>

                <div class="flex flex-wrap gap-6 items-center">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center font-bold text-white shadow-lg">
                      {curso.instructor
                        .split(" ")
                        .map((n: string) => n[0])
                        .join("")}
                    </div>
                    <div>
                      <p class="font-semibold text-lg">{curso.instructor}</p>
                      <p class="text-blue-200 text-sm">
                        Instructor especializado
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full">
                    <svg
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{curso.categoria}</span>
                  </div>
                </div>
              </div>

              <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 lg:w-80 border border-white/20">
                <div class="text-center mb-6">
                  <div class="relative inline-block">
                    <svg class="w-24 h-24 transform -rotate-90">
                      <circle
                        cx="48"
                        cy="48"
                        r="40"
                        stroke="rgba(255,255,255,0.3)"
                        stroke-width="8"
                        fill="none"
                      />
                      <circle
                        cx="48"
                        cy="48"
                        r="40"
                        stroke="white"
                        stroke-width="8"
                        fill="none"
                        stroke-dasharray="251.2"
                        stroke-dashoffset={
                          251.2 * (1 - curso.progreso_total / 100)
                        }
                      />
                    </svg>
                    <span class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white font-bold text-xl">
                      {curso.progreso_total}%
                    </span>
                  </div>
                </div>

                <div class="space-y-4">
                  <div class="flex justify-between text-sm">
                    <span class="text-blue-200">Progreso Total</span>
                    <span class="font-semibold">{curso.progreso_total}%</span>
                  </div>
                  <div class="flex justify-between text-sm">
                    <span class="text-blue-200">Lecciones Restantes</span>
                    <span class="font-semibold">
                      {curso.estadisticas.leccionesRestantes}
                    </span>
                  </div>
                </div>

                {curso.estadisticas.leccionesRestantes === 0 ? (
                  // CASO 1: Todas las lecciones terminadas
                  curso.quizFinal ? (
                    // 1A. Existe Quiz Final -> Botón para ir al Quiz
                    <div class="mt-6 space-y-3">
                      <div class="text-center p-2 bg-yellow-500/20 rounded-lg border border-yellow-400/50">
                        <p class="text-yellow-200 text-sm font-medium">
                          ¡Lecciones completadas!
                        </p>
                        <p class="text-white text-xs">
                          Presenta el examen final para certificar.
                        </p>
                      </div>
                      <a
                        href={`/curso/${curso.id_curso}/quiz/${curso.quizFinal.id_quiz}`}
                        class="w-full block text-center bg-gradient-to-r from-yellow-500 to-orange-500 text-white hover:from-yellow-600 hover:to-orange-600 font-bold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg"
                      >
                        Presentar Examen Final
                        <span class="ml-2">📝</span>
                      </a>
                    </div>
                  ) : (
                    // 1B. No existe Quiz -> Curso terminado
                    <button class="w-full mt-6 bg-green-500 text-white hover:bg-green-600 font-semibold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg cursor-default">
                      ¡Curso Completado! 🎉
                    </button>
                  )
                ) : curso.estadisticas.tieneProgreso ? (
                  // CASO 2: Curso en progreso
                  <a
                    href={`/curso/${curso.id_curso}/leccion/${curso.navegacion.siguienteLeccion?.id_leccion || curso.navegacion.primeraLeccion?.id_leccion}`}
                    class="w-full mt-6 bg-blue-600 text-white hover:bg-blue-700 font-semibold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg flex items-center justify-center"
                  >
                    Continuar Curso
                    <svg
                      class="w-5 h-5 ml-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                ) : (
                  // CASO 3: Curso no iniciado
                  <a
                    href={`/curso/${curso.id_curso}/leccion/${curso.navegacion.primeraLeccion?.id_leccion}`}
                    class="w-full mt-6 bg-white text-blue-600 hover:bg-blue-50 font-semibold py-3 px-4 rounded-xl transition-all transform hover:scale-105 shadow-lg flex items-center justify-center"
                  >
                    Comenzar Curso
                    <svg
                      class="w-5 h-5 ml-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>

        <main class="container mx-auto px-6 py-8">
          <div class="flex flex-col lg:flex-row gap-8">
            <div class="lg:w-1/3">
              <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg sticky top-8 border border-gray-200 dark:border-gray-700">
                <ModulosSidebar
                  modulos={curso.modulos}
                  cursoId={curso.id_curso}
                />
              </div>
            </div>
            <div class="lg:w-2/3">
              <ContenidoPrincipal curso={curso} />
            </div>
          </div>
        </main>
      </div>
    )
  }
  <Footer />
</Layout>

<style>
  .sticky {
    position: sticky;
  }
  .transition-all {
    transition: all 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .transition-all,
    .transform {
      transition: none;
      transform: none;
    }
  }
  .hover\:scale-105:hover {
    transform: scale(1.05);
  }
  html {
    scroll-behavior: smooth;
  }
</style>
