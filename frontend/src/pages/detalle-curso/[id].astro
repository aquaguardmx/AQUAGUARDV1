  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
      const inscribirseBtn = document.getElementById('inscribirseBtn') as HTMLButtonElement | null;

      if (inscribirseBtn) {
        const originalBtnText = inscribirseBtn.innerHTML;

        inscribirseBtn.addEventListener('click', async () => {
          
          const cursoId = inscribirseBtn.dataset.cursoId;

          let userId = null;
          // Asumiendo que usas 'userData' como me dijiste
          const userString = localStorage.getItem("userData") || sessionStorage.getItem("userData");

          if (userString) {
            try {
              const userData = JSON.parse(userString);
              // Asumiendo { "id_usuario": 123 }
              userId = userData.id_usuario; 
            } catch (error) {
              console.error("Error al obtener ID de usuario:", error);
            }
          }

          // Validaciones
          if (!userId) { 
            alert('Error: No se encontró tu ID de usuario. Por favor, inicia sesión de nuevo.');
            return;
          }
          
          if (!cursoId) {
            alert('Error: No se pudo encontrar el ID del curso.');
            return;
          }
          
          // Deshabilitar botón
          inscribirseBtn.disabled = true;
          inscribirseBtn.innerHTML = `
            <svg class...></svg>
            Procesando...
          `;
          
          // --- ⭐ CAMBIO CLAVE AQUÍ ⭐ ---
          // Prepara el objeto 'data' con las claves que tu API espera.
          const data = {
            usuario_id: parseInt(userId, 10),   // Clave actualizada
            curso_id: parseInt(cursoId, 10)     // Clave actualizada
          };
          // --- FIN DEL CAMBIO ---
          
          try {
            // ⚠️ RECUERDA: Cambia esta URL por tu endpoint real
            const response = await fetch('http://localhost:8000/api/cursos-inscritos', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                // 'Authorization': `Bearer ${localStorage.getItem('authToken')}`
              },
              // El body ahora enviará JSON con "usuario_id" y "curso_id"
              body: JSON.stringify(data) 
            });

            if (response.ok) {
              // ... (manejo de éxito) ...
              alert('¡Inscripción exitosa!');
              inscribirseBtn.textContent = '¡Inscrito!';
              inscribirseBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
              inscribirseBtn.classList.add('bg-green-600', 'cursor-not-allowed');
              
              setTimeout(() => {
                window.location.href = '/mis-cursos';
              }, 1000);
            
            } else {
              // ... (manejo de error del servidor) ...
              let errorMsg = 'Inténtalo de nuevo más tarde.';
              try {
                const errorData = await response.json();
                errorMsg = errorData.message || errorMsg;
              } catch (e) {
                errorMsg = `Error ${response.status}: No se pudo procesar la solicitud.`;
              }
              alert(`Error al inscribirse: ${errorMsg}`);
              inscribirseBtn.disabled = false;
              inscribirseBtn.innerHTML = originalBtnText;
            }
          
          } catch (error) {
            // ... (manejo de error de red) ...
            console.error('Error de red al intentar inscribirse:', error);
            alert('Error de conexión. Por favor, revisa tu conexión a internet.');
            inscribirseBtn.disabled = false;
            inscribirseBtn.innerHTML = originalBtnText;
          }
        });
      }
    });
  </script>
</Layout>