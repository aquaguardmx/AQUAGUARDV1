---
// src/pages/detalle-curso/{id}.astro
import { ViewTransitions } from "astro:transitions";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";

const { id } = Astro.params;

const apiUrl = `http://localhost:8000/api/cursos/${id}`;

// 3. Declara variables para los datos y posibles errores
let curso = null;
let error = null;

try {
    const response = await fetch(apiUrl);

    // Si la respuesta no es OK (ej. error 404 o 500), lanza un error
    if (!response.ok) {
        throw new Error(
            `Error ${response.status}: No se pudo encontrar el curso.`,
        );
    }

    // Convierte la respuesta a JSON
    curso = await response.json();

    console.log(curso.categoria.nombre);
} catch (e) {
    console.error(e);
}
