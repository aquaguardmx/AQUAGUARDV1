---
// src/pages/detalle-curso/{id}.astro
import { ViewTransitions } from "astro:transitions";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../components/aquaguard-components/FooterE-Learning.astro";

const { id } = Astro.params;

const API_URL = import.meta.env.PUBLIC_API_URL;
const apiUrl = `${API_URL}/api/cursos/${id}`;

let curso = null;
let error = null;

try {
    const response = await fetch(apiUrl);
    if (!response.ok) {
        throw new Error(
            `Error ${response.status}: No se pudo encontrar el curso.`,
        );
    }
    curso = await response.json();
    console.log(curso);
} catch (e) {
    console.error(e);
    error = e.message;
}

// Función para convertir minutos a formato legible
function formatearTiempo(minutos) {
    if (minutos < 60) {
        return `${minutos} min`;
    }
    const horas = Math.floor(minutos / 60);
    const minsRestantes = minutos % 60;
    return minsRestantes > 0 ? `${horas}h ${minsRestantes}min` : `${horas}h`;
}

// Función para obtener el número total de lecciones
function obtenerTotalLecciones(modulos) {
    return modulos?.reduce((total, modulo) => total + modulo.lecciones.length, 0) || 0;
}
---

<Layout title={curso?.titulo || "Detalles del Curso"}>
    <Header />

    {error ? (
        <!-- Error State -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-4 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-red-100 rounded-full mb-6">
                    <i class="fas fa-exclamation-triangle text-red-600 text-2xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-900 mb-4">Error al cargar el curso</h1>
                <p class="text-gray-600 mb-8">{error}</p>
                <a href="/cursos" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i> Volver a Cursos
                </a>
            </div>
        </section>
    ) : curso ? (
        <>
            <!-- Hero Section Mejorada -->
            <section
                class="relative bg-gradient-to-br from-blue-700 via-purple-700 to-indigo-800 text-white py-20 overflow-hidden"
            >
                <!-- Elementos decorativos de fondo -->
                <div class="absolute inset-0 overflow-hidden">
                    <div
                        class="absolute -top-24 -right-24 w-96 h-96 bg-white/5 rounded-full blur-3xl"
                    >
                    </div>
                    <div
                        class="absolute -bottom-32 -left-32 w-80 h-80 bg-purple-400/10 rounded-full blur-3xl"
                    >
                    </div>
                    <div
                        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-blue-400/10 rounded-full blur-3xl"
                    >
                    </div>
                </div>

                <div class="container mx-auto px-4 relative z-10">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <!-- Información del curso -->
                        <div class="text-white">
                            <div
                                class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md border border-white/30 rounded-full px-4 py-2 mb-6 transition-all hover:bg-white/30"
                            >
                                <i class="fas fa-tag text-blue-100"></i>
                                <span class="text-blue-100 text-sm font-medium"
                                    >{curso.categoria.nombre}</span
                                >
                            </div>

                            <h1
                                class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight animate-fade-in-up"
                            >
                                {curso.titulo}
                            </h1>

                            <p
                                class="text-xl text-blue-100 mb-8 leading-relaxed opacity-90"
                            >
                                {curso.descripcion.replace(/<[^>]*>?/gm, "").substring(0, 200)}...
                            </p>

                            <div class="flex flex-wrap gap-6 items-center mb-8">
                                <div
                                    class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2"
                                >
                                    <div class="flex items-center">
                                        <i class="fas fa-star text-yellow-400"></i>
                                        <i class="fas fa-star text-yellow-400"></i>
                                        <i class="fas fa-star text-yellow-400"></i>
                                        <i class="fas fa-star text-yellow-400"></i>
                                        <i class="fas fa-star-half-alt text-yellow-400"
                                        ></i>
                                    </div>
                                    <span class="text-blue-100 text-sm"
                                        >4.8 (2,450 reseñas)</span
                                    >
                                </div>
                                <div
                                    class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2"
                                >
                                    <i class="fas fa-users text-blue-200"></i>
                                    <span class="text-blue-100 text-sm"
                                        >15,000+ estudiantes</span
                                >
                                </div>
                                <div
                                    class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2"
                                >
                                    <i class="fas fa-clock text-blue-200"></i>
                                    <span class="text-blue-100 text-sm"
                                        >{formatearTiempo(curso.tiempo_estimado_min)}</span
                                    >
                                </div>
                            </div>

                            <div class="flex flex-wrap gap-4">
                                <button
                                    data-curso-id={curso.id_curso}
                                    id="btn-inscribir"
                                    class="group bg-white text-blue-600 px-8 py-4 rounded-xl font-semibold hover:bg-gray-50 transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl flex items-center"
                                >
                                    <i
                                        class="fas fa-shopping-cart mr-2 transition-transform group-hover:scale-110"
                                    ></i>
                                    Inscribirse ahora
                                </button>
                                <button
                                    class="group border-2 border-white text-white px-8 py-4 rounded-xl font-semibold hover:bg-white/10 transition-all duration-300 flex items-center"
                                >
                                    <i
                                        class="far fa-heart mr-2 transition-transform group-hover:scale-110"
                                    ></i>
                                    Agregar a favoritos
                                </button>
                            </div>
                        </div>

                        <!-- Portada con imagen de fondo -->
                        <div class="relative">
                            <div
                                class="bg-gradient-to-br from-blue-600/90 to-purple-700/90 rounded-3xl overflow-hidden shadow-2xl relative transform hover:scale-[1.02] transition-transform duration-500"
                            >
                                <!-- Imagen de portada dinámica -->
                                {curso.portada_url ? (
                                    <div
                                        class="aspect-video bg-cover bg-center"
                                        style={`background-image: url('${API_URL}/storage/${curso.portada_url}')`}
                                    ></div>
                                ) : (
                                    <div
                                        class="aspect-video flex items-center justify-center p-8 relative z-10"
                                    >
                                        <div class="text-center text-white">
                                            <div
                                                class="w-24 h-24 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-6 backdrop-blur-sm border border-white/30 transform hover:scale-110 transition-transform duration-300"
                                            >
                                                <i class="fas fa-graduation-cap text-white text-4xl"
                                                ></i>
                                            </div>
                                            <h3 class="text-2xl font-bold mb-2">
                                                {curso.titulo.substring(0, 30)}...
                                            </h3>
                                            <p class="text-blue-100 text-lg opacity-90">
                                                {curso.categoria.nombre}
                                            </p>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Course Content -->
            <section class="py-16 bg-white">
                <div class="container mx-auto px-4">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                        <!-- Main Content -->
                        <div class="lg:col-span-2">
                            <!-- Tabs Mejoradas -->
                            <div class="border-b border-gray-200 mb-8">
                                <nav class="flex space-x-2 overflow-x-auto pb-1">
                                    <button
                                        id="tab-descripcion"
                                        class="tab-button flex items-center px-6 py-4 rounded-t-lg border-b-2 border-blue-600 text-blue-600 font-semibold whitespace-nowrap transition-all bg-blue-50"
                                    >
                                        <i class="fas fa-info-circle mr-2"
                                        ></i>Descripción
                                    </button>
                                    <button
                                        id="tab-contenido"
                                        class="tab-button flex items-center px-6 py-4 rounded-t-lg text-gray-500 hover:text-gray-700 font-semibold whitespace-nowrap transition-all hover:bg-gray-50"
                                    >
                                        <i class="fas fa-list-ol mr-2"></i>Contenido
                                        <span class="ml-2 bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">
                                            {obtenerTotalLecciones(curso.modulos)} lecciones
                                        </span>
                                    </button>
                                    <button
                                        id="tab-objetivos"
                                        class="tab-button flex items-center px-6 py-4 rounded-t-lg text-gray-500 hover:text-gray-700 font-semibold whitespace-nowrap transition-all hover:bg-gray-50"
                                    >
                                        <i class="fas fa-bullseye mr-2"></i>Objetivos
                                    </button>
                                    <button
                                        id="tab-instructor"
                                        class="tab-button flex items-center px-6 py-4 rounded-t-lg text-gray-500 hover:text-gray-700 font-semibold whitespace-nowrap transition-all hover:bg-gray-50"
                                    >
                                        <i class="fas fa-user mr-2"></i>Instructor
                                    </button>
                                </nav>
                            </div>

                            <!-- Tab Contents -->
                            <!-- Descripción Mejorada -->
                            <div id="content-descripcion" class="tab-content active">
                                <div class="prose max-w-none">
                                    <h2
                                        class="text-3xl font-bold text-gray-900 mb-8 flex items-center"
                                    >
                                        <span class="bg-blue-100 p-2 rounded-lg mr-3">
                                            <i
                                                class="fas fa-graduation-cap text-blue-600"
                                            ></i>
                                        </span>
                                        Lo que aprenderás
                                    </h2>

                                    {curso.objetivos_aprendizaje && curso.objetivos_aprendizaje.length > 0 ? (
                                        <div
                                            class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10"
                                        >
                                            {curso.objetivos_aprendizaje.map((objetivo) => (
                                                <div
                                                    class="flex items-start space-x-4 p-4 rounded-xl border border-gray-100 hover:border-blue-200 hover:bg-blue-50 transition-all duration-300 group"
                                                >
                                                    <div
                                                        class="bg-green-100 p-2 rounded-lg group-hover:scale-110 transition-transform"
                                                    >
                                                        <i class="fas fa-check text-green-600"
                                                        ></i>
                                                    </div>
                                                    <span class="text-gray-700 font-medium"
                                                        >{objetivo.descripcion}</span
                                                    >
                                                </div>
                                            ))}
                                        </div>
                                    ) : (
                                        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-10">
                                            <p class="text-yellow-800">
                                                <i class="fas fa-info-circle mr-2"></i>
                                                No se han definido objetivos de aprendizaje para este curso.
                                            </p>
                                        </div>
                                    )}

                                    <div
                                        class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 mb-8 border border-blue-100"
                                    >
                                        <h3
                                            class="text-2xl font-bold text-gray-900 mb-4 flex items-center"
                                        >
                                            <span
                                                class="bg-blue-100 p-2 rounded-lg mr-3"
                                            >
                                                <i class="fas fa-book text-blue-600"
                                                ></i>
                                            </span>
                                            Descripción del curso
                                        </h3>
                                        <div class="prose-lg text-gray-700 mb-6 leading-relaxed"
                                            set:html={curso.descripcion.replace(/<[^>]*>?/gm, "")} 
                                        />
                                    </div>

                                    <div
                                        class="bg-gradient-to-r from-yellow-50 to-amber-50 border-l-4 border-yellow-400 rounded-r-xl p-6 mb-8"
                                    >
                                        <div class="flex items-start">
                                            <div
                                                class="flex-shrink-0 bg-yellow-100 p-3 rounded-lg"
                                            >
                                                <i
                                                    class="fas fa-lightbulb text-yellow-600 text-xl"
                                                ></i>
                                            </div>
                                            <div class="ml-4">
                                                <p
                                                    class="text-lg font-semibold text-yellow-800"
                                                >
                                                    ¡Curso actualizado!
                                                </p>
                                                <p class="text-yellow-700 mt-1">
                                                    Este curso contiene información actualizada sobre la cultura del agua y prácticas sostenibles.
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                        <div>
                                            <h3
                                                class="text-2xl font-bold text-gray-900 mb-4 flex items-center"
                                            >
                                                <span
                                                    class="bg-purple-100 p-2 rounded-lg mr-3"
                                                >
                                                    <i
                                                        class="fas fa-user-friends text-purple-600"
                                                    ></i>
                                                </span>
                                                ¿Para quién es este curso?
                                            </h3>
                                            <ul class="space-y-3">
                                                <li class="flex items-start space-x-3">
                                                    <i
                                                        class="fas fa-check text-green-500 mt-1"
                                                    ></i>
                                                    <span class="text-gray-700"
                                                        >Personas interesadas en la conservación del agua</span
                                                    >
                                                </li>
                                                <li class="flex items-start space-x-3">
                                                    <i
                                                        class="fas fa-check text-green-500 mt-1"
                                                    ></i>
                                                    <span class="text-gray-700"
                                                        >Familias que desean adoptar hábitos sostenibles</span
                                                    >
                                                </li>
                                                <li class="flex items-start space-x-3">
                                                    <i
                                                        class="fas fa-check text-green-500 mt-1"
                                                    ></i>
                                                    <span class="text-gray-700"
                                                        >Profesionales del sector ambiental</span
                                                    >
                                                </li>
                                            </ul>
                                        </div>
                                        <div>
                                            <h3
                                                class="text-2xl font-bold text-gray-900 mb-4 flex items-center"
                                            >
                                                <span
                                                    class="bg-green-100 p-2 rounded-lg mr-3"
                                                >
                                                    <i
                                                        class="fas fa-clipboard-list text-green-600"
                                                    ></i>
                                                </span>
                                                Requisitos
                                            </h3>
                                            <ul class="space-y-3">
                                                <li class="flex items-start space-x-3">
                                                    <i
                                                        class="fas fa-check text-blue-500 mt-1"
                                                    ></i>
                                                    <span class="text-gray-700"
                                                        >Interés por el cuidado del medio ambiente</span
                                                    >
                                                </li>
                                                <li class="flex items-start space-x-3">
                                                    <i
                                                        class="fas fa-check text-blue-500 mt-1"
                                                    ></i>
                                                    <span class="text-gray-700"
                                                        >Disposición para implementar cambios en el hogar</span
                                                    >
                                                </li>
                                                <li class="flex items-start space-x-3">
                                                    <i
                                                        class="fas fa-check text-blue-500 mt-1"
                                                    ></i>
                                                    <span class="text-gray-700"
                                                        >Deseo de aprender sobre cultura hídrica</span
                                                    >
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Contenido Mejorado -->
                            <div id="content-contenido" class="tab-content">
                                <div class="flex justify-between items-center mb-8">
                                    <h2
                                        class="text-3xl font-bold text-gray-900 flex items-center"
                                    >
                                        <span class="bg-blue-100 p-2 rounded-lg mr-3">
                                            <i class="fas fa-list-ol text-blue-600"></i>
                                        </span>
                                        Contenido del curso
                                    </h2>
                                    <div
                                        class="text-lg font-semibold text-blue-600 bg-blue-50 px-4 py-2 rounded-full"
                                    >
                                        <span>{formatearTiempo(curso.tiempo_estimado_min)}</span> de contenido
                                    </div>
                                </div>

                                {curso.modulos && curso.modulos.length > 0 ? (
                                    <div class="space-y-6">
                                        {curso.modulos.map((modulo, index) => {
                                            const totalLecciones = modulo.lecciones.length;
                                            const colores = ['from-blue-50 to-indigo-50', 'from-purple-50 to-pink-50', 'from-green-50 to-emerald-50', 'from-orange-50 to-red-50', 'from-teal-50 to-cyan-50'];
                                            const iconos = ['fa-play-circle', 'fa-palette', 'fa-flask', 'fa-chart-line', 'fa-code'];
                                            const colorFondo = colores[index % colores.length];
                                            const icono = iconos[index % iconos.length];
                                            
                                            return (
                                                <div
                                                    class="border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300"
                                                >
                                                    <div
                                                        class={`bg-gradient-to-r ${colorFondo} px-6 py-5 border-b border-gray-200 flex justify-between items-center`}
                                                    >
                                                        <div class="flex items-center space-x-4">
                                                            <div
                                                                class="bg-blue-600 text-white p-2 rounded-lg"
                                                            >
                                                                <i class={`fas ${icono}`}></i>
                                                            </div>
                                                            <div>
                                                                <h3
                                                                    class="font-semibold text-gray-900 text-lg"
                                                                >
                                                                    Módulo {index + 1}: {modulo.titulo}
                                                                </h3>
                                                                <p
                                                                    class="text-gray-600 text-sm mt-1"
                                                                >
                                                                    {modulo.lecciones.length} lecciones
                                                                </p>
                                                            </div>
                                                        </div>
                                                        <span
                                                            class="text-sm text-gray-500 bg-white px-3 py-1 rounded-full"
                                                        >{totalLecciones} lecciones</span>
                                                    </div>
                                                    <div class="divide-y divide-gray-100">
                                                        {modulo.lecciones.map((leccion, lecIndex) => (
                                                            <div
                                                                class="px-6 py-4 flex items-center justify-between hover:bg-blue-50 transition-all duration-200 group"
                                                            >
                                                                <div
                                                                    class="flex items-center space-x-4"
                                                                >
                                                                    <i
                                                                        class={`fas ${leccion.tipo_contenido === 'mixto' ? 'fa-film' : 'fa-play-circle'} text-gray-400 group-hover:text-blue-600 transition-colors`}
                                                                    ></i>
                                                                    <div>
                                                                        <span
                                                                            class="text-gray-700 group-hover:text-gray-900 font-medium"
                                                                        >{leccion.titulo}</span>
                                                                        {leccion.tipo_contenido === 'mixto' && (
                                                                            <span class="ml-3 text-xs bg-purple-100 text-purple-800 px-2 py-1 rounded-full">
                                                                                <i class="fas fa-video mr-1"></i>Video
                                                                            </span>
                                                                        )}
                                                                    </div>
                                                                </div>
                                                                <div
                                                                    class="flex items-center space-x-4"
                                                                >
                                                                    <i
                                                                        class="fas fa-lock text-gray-300 group-hover:text-blue-500 transition-colors"
                                                                    ></i>
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                ) : (
                                    <div class="text-center py-12">
                                        <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4">
                                            <i class="fas fa-book-open text-gray-400 text-2xl"></i>
                                        </div>
                                        <h3 class="text-xl font-semibold text-gray-700 mb-2">Contenido no disponible</h3>
                                        <p class="text-gray-500">El contenido de este curso estará disponible próximamente.</p>
                                    </div>
                                )}

                                {curso.modulos && curso.modulos.length > 3 && (
                                    <div class="mt-8 text-center">
                                        <button
                                            id="ver-mas-modulos"
                                            class="group bg-white border-2 border-blue-600 text-blue-600 px-8 py-3 rounded-xl font-semibold hover:bg-blue-600 hover:text-white transition-all duration-300 flex items-center mx-auto"
                                        >
                                            <span>Ver todos los módulos</span>
                                            <i
                                                class="fas fa-chevron-down ml-2 group-hover:rotate-180 transition-transform duration-300"
                                            ></i>
                                        </button>
                                    </div>
                                )}
                            </div>

                            <!-- Objetivos de Aprendizaje -->
                            <div id="content-objetivos" class="tab-content">
                                <h2
                                    class="text-3xl font-bold text-gray-900 mb-8 flex items-center"
                                >
                                    <span class="bg-blue-100 p-2 rounded-lg mr-3">
                                        <i class="fas fa-bullseye text-blue-600"></i>
                                    </span>
                                    Objetivos de Aprendizaje
                                </h2>

                                {curso.objetivos_aprendizaje && curso.objetivos_aprendizaje.length > 0 ? (
                                    <div class="space-y-6">
                                        {curso.objetivos_aprendizaje.map((objetivo, index) => (
                                            <div
                                                class="border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-all duration-300 bg-white"
                                            >
                                                <div class="flex items-start">
                                                    <div class="flex-shrink-0">
                                                        <div class="flex items-center justify-center w-10 h-10 bg-blue-100 text-blue-600 rounded-full font-bold text-lg">
                                                            {index + 1}
                                                        </div>
                                                    </div>
                                                    <div class="ml-4">
                                                        <p class="text-gray-700 text-lg leading-relaxed">
                                                            {objetivo.descripcion}
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                ) : (
                                    <div class="text-center py-12">
                                        <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4">
                                            <i class="fas fa-bullseye text-gray-400 text-2xl"></i>
                                        </div>
                                        <h3 class="text-xl font-semibold text-gray-700 mb-2">Objetivos no definidos</h3>
                                        <p class="text-gray-500">No se han definido objetivos específicos para este curso.</p>
                                    </div>
                                )}
                            </div>

                            <!-- Instructor -->
                            <div id="content-instructor" class="tab-content">
                                <h2
                                    class="text-3xl font-bold text-gray-900 mb-8 flex items-center"
                                >
                                    <span class="bg-blue-100 p-2 rounded-lg mr-3">
                                        <i class="fas fa-user text-blue-600"></i>
                                    </span>
                                    Instructor del Curso
                                </h2>

                                <div class="bg-gradient-to-r from-gray-50 to-blue-50 rounded-2xl p-8 border border-gray-200">
                                    <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
                                        <div class="flex-shrink-0">
                                            <div class="w-24 h-24 bg-blue-100 rounded-full flex items-center justify-center">
                                                <i class="fas fa-user text-blue-600 text-3xl"></i>
                                            </div>
                                        </div>
                                        <div class="flex-1">
                                            <h3 class="text-2xl font-bold text-gray-900 mb-2">
                                                {curso.autor.nombre} {curso.autor.ap_paterno}
                                            </h3>
                                            <p class="text-blue-600 font-medium mb-3">
                                                <i class="fas fa-envelope mr-2"></i>
                                                {curso.autor.correo_electronico}
                                            </p>
                                            <p class="text-gray-700 mb-4">
                                                Instructor certificado y experto en cultura del agua con amplia experiencia en educación ambiental y sostenibilidad.
                                            </p>
                                            <div class="flex flex-wrap gap-2">
                                                <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm">
                                                    <i class="fas fa-star mr-1"></i> Experto en Agua
                                                </span>
                                                <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">
                                                    <i class="fas fa-graduation-cap mr-1"></i> Educador Ambiental
                                                </span>
                                                <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm">
                                                    <i class="fas fa-leaf mr-1"></i> Sostenibilidad
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="bg-white border border-gray-200 rounded-xl p-6">
                                        <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                                            <i class="fas fa-chart-line text-blue-600 mr-2"></i>
                                            Experiencia
                                        </h4>
                                        <p class="text-gray-700">
                                            Más de 10 años de experiencia en educación ambiental y desarrollo de programas de cultura del agua.
                                        </p>
                                    </div>
                                    <div class="bg-white border border-gray-200 rounded-xl p-6">
                                        <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                                            <i class="fas fa-users text-green-600 mr-2"></i>
                                            Estudiantes
                                        </h4>
                                        <p class="text-gray-700">
                                            Ha capacitado a más de 15,000 estudiantes en temas de conservación del agua y prácticas sostenibles.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar Mejorada -->
                        <div class="space-y-6 sticky-sidebar">
                            

                            <!-- Información técnica -->
                            <div
                                class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm"
                            >
                                <h3 class="font-bold text-gray-900 mb-4 flex items-center">
                                    <i class="fas fa-info-circle text-blue-600 mr-2"></i>
                                    Información del curso
                                </h3>
                                <div class="space-y-3">
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="text-gray-600">Categoría</span>
                                        <span class="font-medium">{curso.categoria.nombre}</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="text-gray-600">Duración</span>
                                        <span class="font-medium">{formatearTiempo(curso.tiempo_estimado_min)}</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="text-gray-600">Módulos</span>
                                        <span class="font-medium">{curso.modulos?.length || 0}</span>
                                    </div>
                                    <div class="flex justify-between py-2">
                                        <span class="text-gray-600">Nivel</span>
                                        <span class="font-medium text-green-600">Principiante</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </>
    ) : (
        <!-- Loading State -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-4 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-6">
                    <i class="fas fa-spinner fa-spin text-blue-600 text-2xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-900 mb-4">Cargando curso...</h1>
                <p class="text-gray-600">Por favor espera mientras cargamos la información del curso.</p>
            </div>
        </section>
    )}

    
    <Footer />

    <script>
        const API_URL = import.meta.env.PUBLIC_API_URL;

        // ==========================================================
        // 1. OBTENER DATOS DE SESIÓN
        // ==========================================================
        const userDataRaw =
            localStorage.getItem("userData") ||
            sessionStorage.getItem("userData");
        const authToken =
            localStorage.getItem("authToken") ||
            sessionStorage.getItem("authToken");

        let user = null;
        try {
            user = userDataRaw ? JSON.parse(userDataRaw) : null;
        } catch (err) {
            console.error("Error parseando userData:", err);
        }

        // ==========================================================
        // 2. ESPERAR A QUE CARGUE EL HTML
        // ==========================================================
        document.addEventListener("DOMContentLoaded", () => {
            // ==========================================================
            // 3. MANEJO DE TABS
            // ==========================================================
            const tabButtons = document.querySelectorAll('.tab-button');
            const tabContents = document.querySelectorAll('.tab-content');

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const tabId = button.id.replace('tab-', '');
                    
                    // Remover clases activas
                    tabButtons.forEach(btn => {
                        btn.classList.remove('border-blue-600', 'text-blue-600', 'bg-blue-50');
                        btn.classList.add('text-gray-500');
                    });
                    tabContents.forEach(content => {
                        content.classList.remove('active');
                    });

                    // Agregar clases activas
                    button.classList.add('border-blue-600', 'text-blue-600', 'bg-blue-50');
                    button.classList.remove('text-gray-500');
                    document.getElementById(`content-${tabId}`).classList.add('active');
                });
            });

            // ==========================================================
            // 4. MANEJO DE FAQ
            // ==========================================================
            const faqQuestions = document.querySelectorAll('.faq-question');
            faqQuestions.forEach(question => {
                question.addEventListener('click', () => {
                    const answer = question.nextElementSibling;
                    const icon = question.querySelector('i');
                    
                    answer.classList.toggle('hidden');
                    icon.classList.toggle('rotate-180');
                });
            });

            // ==========================================================
            // 5. MANEJO DE MÓDULOS COLAPSABLES
            // ==========================================================
            const verMasBtn = document.getElementById('ver-mas-modulos');
            if (verMasBtn) {
                verMasBtn.addEventListener('click', () => {
                    const modulos = document.querySelectorAll('.border-gray-200.rounded-2xl');
                    modulos.forEach((modulo, index) => {
                        if (index >= 3) {
                            modulo.classList.toggle('hidden');
                        }
                    });
                    
                    verMasBtn.querySelector('span').textContent = 
                        verMasBtn.querySelector('span').textContent === 'Ver todos los módulos' 
                        ? 'Ver menos módulos' 
                        : 'Ver todos los módulos';
                });
            }

            // ==========================================================
            // 6. MANEJO DE BOTONES DE INSCRIPCIÓN
            // ==========================================================
            const botonInscribir = document.getElementById('btn-inscribir');
            const botonSidebarInscribir = document.getElementById('btn-sidebar-inscribir');
            
            const botonesInscribir = [botonInscribir, botonSidebarInscribir].filter(btn => btn);

            if (botonesInscribir.length === 0) {
                console.error("Error: No se pudo encontrar ningún botón de inscripción");
                return;
            }

            const cursoId = botonesInscribir[0].dataset.cursoId;

            // ==========================================================
            // 7. COMPROBAR SI EL USUARIO ESTÁ LOGUEADO
            // ==========================================================
            if (!user || !authToken) {
                console.log("Usuario no logueado.");
                botonesInscribir.forEach(boton => {
                    boton.innerHTML = '<i class="fas fa-sign-in-alt mr-2"></i> Inicia sesión para inscribirte';
                    boton.disabled = true;
                    boton.addEventListener("click", () => {
                        window.location.href = "/login";
                    });
                });
                return;
            }

            const usuarioId = user.id_usuario;

            if (!usuarioId) {
                console.error("No se pudo encontrar 'id_usuario' en el objeto 'user' del localStorage.");
                botonesInscribir.forEach(boton => {
                    boton.textContent = "Error de sesión";
                    boton.disabled = true;
                });
                return;
            }

            // ==========================================================
            // FUNCIÓN A: Inscribir usuario (POST)
            // ==========================================================
            const inscribirUsuario = async () => {
                botonesInscribir.forEach(boton => {
                    boton.disabled = true;
                    boton.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Inscribiendo...';
                });

                try {
                    const response = await fetch(
                        `${API_URL}/api/cursos-inscritos/usuario/${usuarioId}/inscribir/${cursoId}`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                Accept: "application/json",
                                Authorization: `Bearer ${authToken}`,
                            },
                        },
                    );

                    const data = await response.json();

                    if (!response.ok) {
                        if (data.inscrito) {
                            // Ya está inscrito
                            mostrarBotonEntrarAlCurso();
                            return;
                        }
                        throw new Error(
                            data.message || `Error ${response.status}`,
                        );
                    }

                    console.log("Inscripción exitosa:", data);

                    if (data.inscrito) {
                        mostrarBotonEntrarAlCurso();
                    }
                } catch (error) {
                    console.error("Error en la inscripción:", error);
                    alert(`Hubo un error: ${error.message || error}`);

                    // Revertir el botón
                    mostrarBotonInscribirse();
                }
            };

            // ==========================================================
            // FUNCIÓN B: Verificar inscripción (GET)
            // ==========================================================
            const verificarInscripcion = async () => {
                try {
                    const response = await fetch(
                        `${API_URL}/api/cursos-inscritos/usuario/${usuarioId}/curso/${cursoId}`,
                        {
                            method: "GET",
                            headers: {
                                Accept: "application/json",
                                Authorization: `Bearer ${authToken}`,
                            },
                        },
                    );

                    if (response.status === 404) {
                        return false;
                    }

                    if (!response.ok) {
                        throw new Error(
                            `Error ${response.status}: ${response.statusText}`,
                        );
                    }

                    const data = await response.json();
                    return data.inscrito === true;
                } catch (error) {
                    console.error("Error al verificar inscripción:", error);
                    return false;
                }
            };

            // ==========================================================
            // FUNCIÓN C: Mostrar botón "Entrar al curso"
            // ==========================================================
            const mostrarBotonEntrarAlCurso = () => {
                botonesInscribir.forEach(boton => {
                    boton.innerHTML = '<i class="fas fa-play-circle mr-2"></i> Entrar al curso';
                    boton.classList.remove(
                        "bg-white",
                        "text-blue-600",
                        "hover:bg-gray-50",
                        "from-blue-600",
                        "to-purple-600",
                        "hover:from-blue-700",
                        "hover:to-purple-700",
                        "text-white"
                    );
                    boton.classList.add(
                        "bg-green-600",
                        "text-white",
                        "hover:bg-green-700"
                    );

                    // Cambiar comportamiento para redirigir al curso
                    boton.onclick = () => {
                        window.location.href = `/curso/${cursoId}`;
                    };

                    boton.disabled = false;
                });
            };

            // ==========================================================
            // FUNCIÓN D: Mostrar botón "Inscribirse"
            // ==========================================================
            const mostrarBotonInscribirse = () => {
                botonesInscribir.forEach(boton => {
                    if (boton.id === 'btn-inscribir') {
                        boton.innerHTML = '<i class="fas fa-shopping-cart mr-2"></i> Inscribirse ahora';
                        boton.classList.remove(
                            "bg-green-600",
                            "text-white",
                            "hover:bg-green-700"
                        );
                        boton.classList.add(
                            "bg-white",
                            "text-blue-600",
                            "hover:bg-gray-50"
                        );
                    } else {
                        boton.innerHTML = '<i class="fas fa-shopping-cart mr-3"></i> Inscribirse ahora';
                        boton.classList.remove(
                            "bg-green-600",
                            "text-white",
                            "hover:bg-green-700"
                        );
                        boton.classList.add(
                            "from-blue-600",
                            "to-purple-600",
                            "hover:from-blue-700",
                            "hover:to-purple-700",
                            "text-white"
                        );
                    }

                    boton.onclick = inscribirUsuario;
                    boton.disabled = false;
                });
            };

            // ==========================================================
            // FUNCIÓN E: Inicializar los botones
            // ==========================================================
            const inicializarBotones = async () => {
                botonesInscribir.forEach(boton => {
                    boton.disabled = true;
                    boton.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Verificando...';
                });

                try {
                    const estaInscrito = await verificarInscripcion();
                    console.log(
                        `Usuario ${usuarioId} inscrito en curso ${cursoId}:`,
                        estaInscrito,
                    );

                    if (estaInscrito) {
                        mostrarBotonEntrarAlCurso();
                    } else {
                        mostrarBotonInscribirse();
                    }
                } catch (error) {
                    console.error("Error en inicialización:", error);
                    mostrarBotonInscribirse();
                }
            };

            // ==========================================================
            // 8. EJECUTAR LA INICIALIZACIÓN
            // ==========================================================
            inicializarBotones();
        });
    </script>
</Layout>

<ViewTransitions />

