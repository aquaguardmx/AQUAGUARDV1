---
// src/pages/curso/editar-curso/[id].astro
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/aquaguard-components/HeaderE-Learnig.astro";
import Footer from "../../../components/aquaguard-components/FooterE-Learning.astro";

// 1. Definimos la interfaz para la estructura de los datos de la API
interface Usuario {
    id_usuario: number;
    nombre: string;
    ap_paterno: string;
    ap_materno: string;
    correo_electronico: string;
    id_rol: number;
    id_escuela: number | null;
    created_at: string;
    updated_at: string;
    email_verified_at: string;
}

interface Categoria {
    id: number;
    nombre: string;
    slug: string;
    created_at: string;
}

interface Leccion {
    id_leccion: number;
    modulo_id: number;
    titulo: string;
    tipo_contenido: string;
    contenido_texto: string | null;
    video_url: string | null;
    orden: number;
    created_at: string;
}

interface Modulo {
    id_modulo: number;
    curso_id: number;
    titulo: string;
    orden: number;
    lecciones: Leccion[];
}

interface ObjetivoAprendizaje {
    id_objetivo?: number;
    curso_id?: number;
    descripcion: string;
    created_at?: string;
}

interface Curso {
    id_curso: number;
    titulo: string;
    descripcion: string;
    portada_url: string;
    tiempo_estimado_min: number;
    autor_id: number;
    categoria_id: number;
    publicado: boolean;
    created_at: string;
    updated_at: string;
    autor: Usuario;
    categoria: Categoria;
    modulos: Modulo[];
    objetivos_aprendizaje: ObjetivoAprendizaje[];
}

// Configuración de la API
const API_URL = "https://aquaguardv1.onrender.com/api/cursos/";

// Parámetros de la ruta
export async function getStaticPaths() {
    return [
        { params: { id: '21' } },
        { params: { id: '22' } },
        // Agrega más IDs según necesites
    ];
}

const { id } = Astro.params;

// 2. Obtener datos del curso desde la API
let curso: Curso | null = null;
let error: string | null = null;

try {
    const response = await fetch(`${API_URL}${id}`);
    
    if (!response.ok) {
        throw new Error(`Error HTTP: ${response.status}`);
    }
    
    const data = await response.json();
    curso = data as Curso;
} catch (err) {
    console.error("Error al obtener el curso:", err);
    error = "No se pudo cargar la información del curso";
}

// Calcular estadísticas
const totalLecciones = curso ? curso.modulos.reduce((total, modulo) => total + modulo.lecciones.length, 0) : 0;
const moduloCount = curso ? curso.modulos.length : 0;
---

<Layout title={`${curso ? curso.titulo : 'Editar Curso'} - AquaGuard`}>
    <!-- Header con funcionalidad de cierre de sesión -->
    <Header />

    <!-- Hero Section para Editar Curso -->
    <section
        class="relative min-h-[40vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-blue-900 via-blue-700 to-teal-600"
    >
        <!-- Elementos de fondo animados -->
        <div class="absolute inset-0 bg-black/20"></div>

        <!-- Ondas animadas -->
        <div class="absolute bottom-0 left-0 right-0">
            <svg
                class="w-full h-20 md:h-28 text-blue-800/30"
                viewBox="0 0 1200 120"
                preserveAspectRatio="none"
            >
                <path
                    d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z"
                    opacity=".25"
                    fill="currentColor"
                >
                </path>
                <path
                    d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z"
                    opacity=".5"
                    fill="currentColor"></path>
                <path
                    d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z"
                    fill="currentColor"></path>
            </svg>
        </div>

        <!-- Burbujas flotantes -->
        <div class="absolute inset-0 overflow-hidden">
            <div class="bubble bubble-1"></div>
            <div class="bubble bubble-2"></div>
            <div class="bubble bubble-3"></div>
            <div class="bubble bubble-4"></div>
        </div>

        <!-- Contenido principal -->
        <div class="container mx-auto px-6 text-center relative z-10 py-12">
            <!-- Badge destacado -->
            <div
                class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-md border border-white/30 rounded-full px-5 py-2 mb-6 animate-pulse"
            >
                <svg
                    class="w-4 h-4 text-blue-200"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"
                        clip-rule="evenodd"
                    />
                </svg>
                <span class="text-blue-100 text-sm font-medium tracking-wide"
                    >Gestiona tu contenido educativo</span
                >
            </div>

            <!-- Título principal -->
            <div class="mb-6">
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight"
                >
                    {curso ? 'Gestionar' : 'Cargando'}
                    <span
                        class="block bg-gradient-to-r from-blue-200 to-teal-200 bg-clip-text text-transparent mt-2"
                    >
                        {curso ? curso.titulo : 'Curso'}
                    </span>
                </h1>
            </div>

            <!-- Descripción -->
            {curso && (
                <div class="mb-8">
                    <p
                        class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto leading-relaxed"
                    >
                        Organiza módulos, lecciones y controla el estado de tu curso de
                        <span class="font-semibold text-white">educación ambiental</span>.
                    </p>
                </div>
            )}
        </div>
    </section>

    <!-- Contenido Principal -->
    <main
        class="bg-gradient-to-b from-blue-50 via-white to-white dark:from-gray-900 dark:via-gray-800 dark:to-gray-900"
    >
        <div class="container mx-auto px-6 py-16">
            <div class="max-w-6xl mx-auto">
                {error ? (
                    <!-- Mensaje de error -->
                    <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 text-red-700 dark:text-red-300 p-6 rounded-2xl mb-8">
                        <div class="flex items-center">
                            <svg class="w-8 h-8 mr-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <p class="font-bold text-xl">Error al cargar el curso</p>
                                <p>{error}</p>
                            </div>
                        </div>
                    </div>
                ) : !curso ? (
                    <!-- Loading state -->
                    <div class="text-center py-16">
                        <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-blue-500 mx-auto mb-4"></div>
                        <p class="text-gray-600 dark:text-gray-400 text-lg">Cargando información del curso...</p>
                    </div>
                ) : (
                    <!-- Contenido del curso -->
                    <>
                        <!-- Información del Curso -->
                        <div class="mb-12">
                            <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-lg rounded-3xl shadow-2xl border-2 border-gray-200/50 dark:border-gray-700/50 overflow-hidden">
                                <div class="bg-gradient-to-r from-blue-600 to-teal-500 p-6 text-white">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                            </svg>
                                        </div>
                                        <div>
                                            <h2 class="text-2xl font-bold mb-1">{curso.titulo}</h2>
                                            <p class="text-blue-100 text-sm">
                                                Curso ID: {curso.id_curso} | 
                                                Categoría: {curso.categoria.nombre} | 
                                                Estado: <span class="font-semibold">{curso.publicado ? 'Publicado' : 'Borrador'}</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-6">
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
                                        <div>
                                            <span class="font-semibold text-gray-600 dark:text-gray-400">Autor:</span>
                                            <p class="text-gray-800 dark:text-gray-200">{curso.autor.nombre} {curso.autor.ap_paterno}</p>
                                        </div>
                                        <div>
                                            <span class="font-semibold text-gray-600 dark:text-gray-400">Duración:</span>
                                            <p class="text-gray-800 dark:text-gray-200">{Math.floor(curso.tiempo_estimado_min / 60)}h {curso.tiempo_estimado_min % 60}m</p>
                                        </div>
                                        <div>
                                            <span class="font-semibold text-gray-600 dark:text-gray-400">Creado:</span>
                                            <p class="text-gray-800 dark:text-gray-200">{new Date(curso.created_at).toLocaleDateString()}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Gestión de Módulos y Lecciones -->
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                            <!-- Panel de Módulos -->
                            <div class="lg:col-span-2">
                                <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-lg rounded-3xl shadow-2xl border-2 border-gray-200/50 dark:border-gray-700/50 overflow-hidden">
                                    <!-- Header del panel -->
                                    <div class="bg-gradient-to-r from-blue-600 to-teal-500 p-6 text-white">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                                                </svg>
                                                <h3 class="text-xl font-bold">Módulos del Curso</h3>
                                            </div>
                                            <button id="agregar-modulo" class="bg-white/20 hover:bg-white/30 text-white font-semibold py-2 px-4 rounded-xl transition-all duration-300 flex items-center gap-2">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                                </svg>
                                                Agregar Módulo
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Lista de Módulos -->
                                    <div class="p-6">
                                        <div id="modulos-container" class="space-y-4">
                                            {curso.modulos.map((modulo) => {
                                                const totalLeccionesModulo = modulo.lecciones.length;
                                                const duracionEstimada = totalLeccionesModulo * 15; // Estimación de 15min por lección
                                                
                                                return (
                                                    <div class="modulo-item bg-white dark:bg-gray-700 border-2 border-gray-200/50 dark:border-gray-600/50 rounded-2xl overflow-hidden transition-all duration-300 hover:border-blue-300/50 dark:hover:border-blue-600/50" data-modulo-id={modulo.id_modulo}>
                                                        <div class="bg-blue-50 dark:bg-blue-900/20 p-4 flex items-center justify-between">
                                                            <div class="flex items-center gap-3">
                                                                <div class="w-10 h-10 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold">
                                                                    {modulo.orden}
                                                                </div>
                                                                <div>
                                                                    <h4 class="font-bold text-gray-800 dark:text-gray-200">{modulo.titulo}</h4>
                                                                    <p class="text-sm text-gray-600 dark:text-gray-400">{totalLeccionesModulo} lecciones • {duracionEstimada} minutos</p>
                                                                </div>
                                                            </div>
                                                            <div class="flex items-center gap-2">
                                                                <button class="editar-modulo p-2 text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-all duration-300" data-modulo-id={modulo.id_modulo}>
                                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                                    </svg>
                                                                </button>
                                                                <button class="eliminar-modulo p-2 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-all duration-300" data-modulo-id={modulo.id_modulo}>
                                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div class="p-4">
                                                            <div class="lecciones-container space-y-3">
                                                                {modulo.lecciones.map((leccion) => (
                                                                    <div class="leccion-item flex items-center gap-3 p-3 bg-gray-50 dark:bg-gray-600/50 rounded-xl" data-leccion-id={leccion.id_leccion}>
                                                                        <div class="flex items-center gap-3 flex-1">
                                                                            <div class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center text-sm font-bold">
                                                                                {leccion.orden}
                                                                            </div>
                                                                            <div>
                                                                                <h5 class="font-medium text-gray-800 dark:text-gray-200">{leccion.titulo}</h5>
                                                                                <p class="text-xs text-gray-600 dark:text-gray-400">
                                                                                    15 minutos • {leccion.tipo_contenido === 'texto' ? 'Texto' : leccion.tipo_contenido === 'video' ? 'Video' : 'Mixto'}
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                        <div class="flex items-center gap-1">
                                                                            <button class="editar-leccion p-1.5 text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-all duration-300" data-leccion-id={leccion.id_leccion}>
                                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                                                </svg>
                                                                            </button>
                                                                            <button class="eliminar-leccion p-1.5 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-all duration-300" data-leccion-id={leccion.id_leccion}>
                                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                                                </svg>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                ))}
                                                            </div>
                                                            <button class="agregar-leccion mt-4 w-full py-2 border-2 border-dashed border-gray-300/50 dark:border-gray-600/50 rounded-xl text-gray-600 dark:text-gray-400 hover:border-green-500 hover:text-green-500 transition-all duration-300 flex items-center justify-center gap-2 text-sm font-medium" data-modulo-id={modulo.id_modulo}>
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                                                </svg>
                                                                Agregar Lección
                                                            </button>
                                                        </div>
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Panel de Control -->
                            <div class="lg:col-span-1">
                                <!-- Estado del Curso -->
                                <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-lg rounded-3xl shadow-2xl border-2 border-gray-200/50 dark:border-gray-700/50 overflow-hidden mb-8">
                                    <div class="bg-gradient-to-r from-blue-600 to-teal-500 p-6 text-white">
                                        <div class="flex items-center gap-3">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                            </svg>
                                            <h3 class="text-xl font-bold">Estado del Curso</h3>
                                        </div>
                                    </div>
                                    <div class="p-6">
                                        <div class="space-y-6">
                                            <!-- Selector de Estado -->
                                            <div>
                                                <label class="block text-lg font-bold text-gray-800 dark:text-gray-200 mb-3">
                                                    Estado Actual
                                                </label>
                                                <select id="estado-curso" class="w-full px-4 py-3 bg-white dark:bg-gray-700 border-2 border-gray-300/50 dark:border-gray-600/50 rounded-xl text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all duration-300">
                                                    <option value="false" selected={!curso.publicado}>Borrador</option>
                                                    <option value="true" selected={curso.publicado}>Publicado</option>
                                                </select>
                                            </div>

                                            <!-- Estadísticas -->
                                            <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4">
                                                <h4 class="font-bold text-gray-800 dark:text-gray-200 mb-3">Resumen del Curso</h4>
                                                <div class="space-y-2">
                                                    <div class="flex justify-between">
                                                        <span class="text-gray-600 dark:text-gray-400">Módulos:</span>
                                                        <span class="font-bold text-gray-800 dark:text-gray-200">{moduloCount}</span>
                                                    </div>
                                                    <div class="flex justify-between">
                                                        <span class="text-gray-600 dark:text-gray-400">Lecciones:</span>
                                                        <span class="font-bold text-gray-800 dark:text-gray-200">{totalLecciones}</span>
                                                    </div>
                                                    <div class="flex justify-between">
                                                        <span class="text-gray-600 dark:text-gray-400">Duración Total:</span>
                                                        <span class="font-bold text-gray-800 dark:text-gray-200">{Math.floor(curso.tiempo_estimado_min / 60)}h {curso.tiempo_estimado_min % 60}m</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Acciones -->
                                            <div class="space-y-3">
                                                <button id="guardar-cambios" class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-2">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    Guardar Cambios
                                                </button>
                                                <button id="vista-previa" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-2">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
