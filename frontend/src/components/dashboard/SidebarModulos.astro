---
const { id: paramId } = Astro.params;

// Interfaces para las props
export interface Leccion {
  id_leccion: number;
  titulo: string;
  activa?: boolean;
  completada?: boolean;
  url: string;
}

export interface Modulo {
  id_modulo: number;
  titulo: string;
  lecciones: Leccion[];
  expandido?: boolean;
}

export interface Props {
  modulos: Modulo[];
  cursoId?: string;
  currentLeccionId?: number;
  modoCreacion?: boolean;
  moduloActual?: Modulo | null;
}

// Función segura para obtener datos
function obtenerDatosNormalizados() {
  // Usar valores por defecto seguros
  const props = Astro.props || {};
  const modulos = props.modulos || [];
  const cursoId = props.cursoId || paramId || "1";
  const currentLeccionId = props.currentLeccionId || null;
  
  const cursoIdFinal = cursoId?.toString() || paramId?.toString() || "1";

  const modulosNormalizados = Array.isArray(modulos) 
    ? modulos.map((modulo, index) => {
        const moduloSafe = modulo || {};
        return {
          id: moduloSafe.id_modulo || (index + 1),
          titulo: moduloSafe.titulo || 'Sin título',
          lecciones: Array.isArray(moduloSafe.lecciones) 
            ? moduloSafe.lecciones.map((leccion, lecIndex) => {
                const leccionSafe = leccion || {};
                const leccionId = leccionSafe.id_leccion || (lecIndex + 1);
                
                return {
                  ...leccionSafe,
                  id: leccionId,
                  id_leccion: leccionId,
                  titulo: leccionSafe.titulo || 'Lección sin título',
                  activa: leccionId === currentLeccionId,
                  completada: leccionSafe.completada || false,
                  url: leccionSafe.url || `/admin/cursos/${cursoIdFinal}/lecciones/${leccionId}`
                };
              })
            : [],
          expandido: moduloSafe.expandido || false
        };
      })
    : [];

  return {
    modulosNormalizados,
    cursoIdFinal,
    currentLeccionId
  };
}

// Obtener datos normalizados
const { modulosNormalizados, cursoIdFinal, currentLeccionId: currentLeccionIdCache } = obtenerDatosNormalizados();

// Convertir a JSON para el script
const modulosJSON = JSON.stringify(modulosNormalizados);
const cursoIdForScript = cursoIdFinal;
---

<style>
    /* Estilos optimizados */
    .rotate-180 { transform: rotate(180deg); }
    .module-arrow { transition: transform 0.3s ease; }
    
    .thin-scrollbar::-webkit-scrollbar { width: 4px; }
    .thin-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .thin-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }
    .thin-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    
    @media (prefers-color-scheme: dark) {
        .thin-scrollbar::-webkit-scrollbar-thumb { background: #4b5563; }
        .thin-scrollbar::-webkit-scrollbar-thumb:hover { background: #6b7280; }
    }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .module-content { will-change: max-height; }
    
    /* Loading overlay */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.95);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        backdrop-filter: blur(4px);
        transition: opacity 0.3s ease;
    }
    
    .dark .loading-overlay { background: rgba(0, 0, 0, 0.95); }
    
    .loading-spinner {
        width: 3rem;
        height: 3rem;
        border: 4px solid #e5e7eb;
        border-left: 4px solid #3b82f6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    
    .dark .loading-spinner {
        border: 4px solid #4b5563;
        border-left: 4px solid #60a5fa;
    }
    
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    .loading-text {
        margin-top: 1rem;
        font-size: 1.125rem;
        font-weight: 500;
        color: #374151;
    }
    
    .dark .loading-text { color: #d1d5db; }
    
    .loading-progress {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: #6b7280;
    }
    
    .dark .loading-progress { color: #9ca3af; }
</style>

<!-- Overlay de carga -->
<div id="loading-overlay" class="loading-overlay">
    <div class="loading-spinner"></div>
    <div class="loading-text" id="loading-text">Cargando contenido del curso...</div>
    <div class="loading-progress" id="loading-progress">Inicializando...</div>
</div>

<aside class="w-full lg:w-80 xl:w-96 flex-shrink-0">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 lg:p-6 sticky top-20 lg:top-24 max-h-[calc(100vh-6rem)] overflow-hidden flex flex-col">
        <!-- Header -->
        <div class="flex items-center justify-between mb-4 lg:mb-6">
            <h2 class="text-lg lg:text-xl font-bold text-gray-900 dark:text-white truncate">
                Contenido del Curso
            </h2>
            <button
                type="button"
                class="inline-flex items-center p-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors flex-shrink-0"
                id="add-module-btn"
                title="Añadir nuevo módulo"
            >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Añadir Módulo</span>
            </button>
        </div>

        <!-- Lista de Módulos -->
        <div class="flex-1 overflow-y-auto space-y-3 thin-scrollbar" id="modules-list">
            {modulosNormalizados.length === 0 ? (
                <div class="text-center py-6 lg:py-8" id="empty-state">
                    <svg class="w-10 h-10 lg:w-12 lg:h-12 text-gray-400 mx-auto mb-3 lg:mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
