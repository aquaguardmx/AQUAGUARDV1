                            >
                                <div
                                    class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center group-hover:bg-orange-100 transition-all duration-300 group-hover:scale-110"
                                >
                                    <i
                                        class="fas fa-cog text-gray-600 group-hover:text-orange-600 text-xl"
                                    ></i>
                                </div>
                                <span>Configuración</span>
                            </a>
                        </nav>
                    </div>

                    <!-- Enhanced Stats Card (agregar id para JS) -->
                    <div
                        id="statsCard"
                        class="bg-gradient-to-br from-blue-500 via-purple-500 to-indigo-600 rounded-3xl p-7 text-white shadow-2xl shadow-blue-200/40 transition-all duration-300 hover:shadow-3xl hover:shadow-purple-200/40"
                    >
                        <h3 class="text-2xl font-bold mb-7 flex items-center">
                            <i class="fas fa-trophy mr-3 text-yellow-300"></i>
                            Mi Progreso
                        </h3>
                        <div class="space-y-6">
                            <div>
                                <div
                                    class="flex justify-between text-sm font-medium mb-3"
                                >
                                    <span class="text-blue-100"
                                        >Cursos Completados</span
                                    >
                                    <span
                                        id="stat-cursos-completados"
