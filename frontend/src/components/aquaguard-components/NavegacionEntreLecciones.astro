                                    </div>
                                    <div class="flex-1 min-w-0">
                                        {/* TÍTULO DEL MÓDULO COMPLETO - SIN TRUNCATE */}
                                        <h4 class="font-semibold text-gray-900 dark:text-white text-base leading-snug break-words">
                                            {modulo.titulo}
                                        </h4>
                                        <div class="flex items-center flex-wrap gap-2 mt-2">
                                            <span class="text-sm text-gray-600 dark:text-gray-400">
