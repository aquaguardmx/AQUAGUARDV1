<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Registro</title>
        <!-- Importar CSS si es necesario -->
        <style>
            :root {
                --primary-color: #2563eb;
                --error-color: #dc2626;
                --success-color: #16a34a;
            }
            .rg-spin {
                animation: rg-spin 1s linear infinite;
                vertical-align: middle;
            }
            @keyframes rg-spin {
                to {
                    transform: rotate(360deg);
                }
            }
        </style>
    </head>
    <body
        class="bg-gray-100 min-h-screen flex items-center justify-center px-4"
    >
        <main class="w-full max-w-md bg-white shadow-xl rounded-2xl p-6">
            <header class="flex items-center justify-center gap-3 mb-4">
                <h1 class="text-2xl font-semibold text-gray-800">
                    Crear cuenta
                </h1>
            </header>

            <p class="text-center text-gray-600 mb-6">
                Regístrate para acceder al contenido y llevar un mejor registro
                de tu progreso.
            </p>

            <form id="registerForm" class="space-y-4">
                <!-- Nombre -->
                <div>
                    <label
                        for="nombre"
                        class="block text-sm font-medium text-gray-700 mb-1"
                    >
                        Nombre *
                    </label>
                    <input
                        type="text"
                        id="nombre"
                        name="nombre"
                        required
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        placeholder="Tu nombre"
                    />
                </div>

                <!-- Apellidos -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label
                            for="ap_paterno"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Apellido paterno *
                        </label>
                        <input
                            type="text"
                            id="ap_paterno"
                            name="ap_paterno"
                            required
                            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            placeholder="Apellido paterno"
                        />
                    </div>
                    <div>
                        <label
                            for="ap_materno"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Apellido materno
                        </label>
                        <input
                            type="text"
                            id="ap_materno"
                            name="ap_materno"
                            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            placeholder="Apellido materno"
                        />
                    </div>
                </div>

                <!-- Correo -->
                <div>
                    <label
                        for="correo_electronico"
                        class="block text-sm font-medium text-gray-700 mb-1"
                    >
                        Correo electrónico *
                    </label>
                    <input
                        type="email"
                        id="correo_electronico"
                        name="correo_electronico"
                        required
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        placeholder="tucorreo@ejemplo.com"
                    />
                </div>

                <!-- Contraseña -->
                <div>
                    <label
                        for="contraseña"
                        class="block text-sm font-medium text-gray-700 mb-1"
                    >
                        Contraseña *
                    </label>
                    <input
                        type="password"
                        id="contraseña"
                        name="contraseña"
                        required
                        minlength="8"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        placeholder="Mínimo 8 caracteres"
                    />
                </div>

                <!-- Confirmar contraseña -->
                <div>
                    <label
                        for="confirmar_contraseña"
                        class="block text-sm font-medium text-gray-700 mb-1"
                    >
                        Confirmar contraseña *
                    </label>
                    <input
                        type="password"
                        id="confirmar_contraseña"
                        name="confirmar_contraseña"
                        required
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        placeholder="Repite la contraseña"
                    />
                </div>

                <!-- Mensaje de error/success -->
                <div id="message" class="text-center text-sm min-h-6"></div>

                <!-- Botón de registro -->
                <button
                    type="submit"
                    id="submitBtn"
                    class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition font-medium"
                >
                    Crear cuenta
                </button>
            </form>

            <div class="my-6 flex items-center gap-3">
                <hr class="flex-1 border-gray-300" />
                <span class="text-gray-500 text-sm">o</span>
                <hr class="flex-1 border-gray-300" />
            </div>

            <p class="text-center text-gray-600 text-sm">
                ¿Ya tienes cuenta?
                <a
                    href="../auth/login"
                    class="text-blue-600 hover:underline font-medium"
                >
                    Inicia sesión
                </a>
            </p>
        </main>

        <script is:inline>
            // 1. Configuración de la URL de la API (ajusta según tu entorno)
            // OPCIÓN A: Si estás usando el mismo dominio
            const API_URL = window.location.origin;

            // OPCIÓN B: Si tu API está en otro servidor (descomenta y ajusta)
            // const API_URL = 'http://localhost:8000'; // URL de tu API Laravel

            // OPCIÓN C: Desde variable global (configura en tu index.html principal)
            // const API_URL = window.API_URL || 'http://tu-api.com';

            // 2. Verificar si ya está autenticado
            const token =
                localStorage.getItem("authToken") ||
                sessionStorage.getItem("authToken");
            if (token) {
                window.location.href = "/home";
            }

            // 3. Manejo del formulario
            document.addEventListener("DOMContentLoaded", () => {
                const form = document.getElementById("registerForm");
                const messageEl = document.getElementById("message");
                const submitBtn = document.getElementById("submitBtn");

                // Validación de contraseñas
                function validatePasswords() {
                    const password =
                        document.getElementById("contraseña").value;
                    const confirmPassword = document.getElementById(
                        "confirmar_contraseña",
                    ).value;

                    if (password !== confirmPassword) {
                        showMessage("Las contraseñas no coinciden", "error");
                        return false;
                    }

                    if (password.length < 8) {
                        showMessage(
                            "La contraseña debe tener al menos 8 caracteres",
                            "error",
                        );
                        return false;
                    }

                    return true;
                }

                // Mostrar mensajes
                function showMessage(text, type = "info") {
                    messageEl.textContent = text;
                    messageEl.className = "text-center text-sm min-h-6";

                    if (type === "error") {
                        messageEl.style.color = "#dc2626";
                    } else if (type === "success") {
                        messageEl.style.color = "#16a34a";
                    } else {
                        messageEl.style.color = "#4b5563";
                    }
                }

                // Estado de carga
                function setLoading(loading) {
                    submitBtn.disabled = loading;
                    if (loading) {
                        submitBtn.innerHTML = `
                        <span class="rg-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full mr-2"></span>
                        Registrando...
                    `;
                        submitBtn.classList.add("opacity-70");
                    } else {
                        submitBtn.innerHTML = "Crear cuenta";
                        submitBtn.classList.remove("opacity-70");
                    }
                }

                // Envío del formulario
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();

                    if (!validatePasswords()) {
                        return;
                    }

                    // Recoger datos del formulario
                    const formData = new FormData(form);
                    const data = {
                        nombre: formData.get("nombre"),
                        ap_paterno: formData.get("ap_paterno"),
                        ap_materno: formData.get("ap_materno") || "",
                        correo_electronico: formData.get("correo_electronico"),
                        contraseña: formData.get("contraseña"),
                        id_rol: 2, // Valor fijo según tu requerimiento
                        id_escuela: null, // Valor nulo según tu requerimiento
                    };

                    setLoading(true);
                    showMessage("");

                    try {
                        const response = await fetch(
                            `${API_URL}/api/register`,
                            {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    Accept: "application/json",
                                },
                                body: JSON.stringify(data),
                            },
                        );

                        const result = await response.json();

                        if (response.ok) {
                            showMessage(
                                "¡Registro exitoso! Redirigiendo...",
                                "success",
                            );

                            // Guardar token si la API lo devuelve
                            if (result.token || result.access_token) {
                                localStorage.setItem(
                                    "authToken",
                                    result.token || result.access_token,
                                );
                                setTimeout(
                                    () => (window.location.href = "/home"),
                                    1500,
                                );
                            } else {
                                setTimeout(
                                    () =>
                                        (window.location.href = "/auth/login"),
                                    1500,
                                );
                            }

                            form.reset();
                        } else {
                            // Manejo de errores de Laravel
                            if (result.errors) {
                                const errorMessages = Object.values(
                                    result.errors,
                                )
                                    .flat()
                                    .join(" ");
                                showMessage(errorMessages, "error");
                            } else {
                                showMessage(
                                    result.message || "Error en el registro",
                                    "error",
                                );
                            }
                        }
                    } catch (error) {
                        console.error("Error:", error);
                        showMessage(
                            "Error de conexión con el servidor",
                            "error",
                        );
                    } finally {
                        setLoading(false);
                    }
                });
            });
        </script>
    </body>
</html>
