---
// --- Datos de Ejemplo ---
const autores = [
  { id: 1, nombre: "Juan Pérez" },
  { id: 2, nombre: "Ana Gómez (Tú)" },
  { id: 3, nombre: "Carlos Ruiz" },
];
const categorias = [
  { id: 1, nombre: "Programación" },
  { id: 2, nombre: "Diseño Web" },
  { id: 3, nombre: "Marketing Digital" },
  { id: 4, nombre: "Idiomas" },
];

if (Astro.request.method === "POST") {
  // console.log("Formulario recibido:", await Astro.request.formData());
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agregar Nuevo Curso</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    body {
      font-family: "Inter", sans-serif;
      background: linear-gradient(to bottom right, #f8fafc, #eef2ff);
    }

    form > div {
  margin-top: 0.75rem; /* ~12px */
  margin-bottom: 0.75rem;
}


    .editor-container {
      border: 1px solid #e2e8f0;
      border-radius: 0.75rem;
      overflow: hidden;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      background-color: white;
    }

    .ql-toolbar.ql-snow {
      background-color: #f8fafc;
      border: none;
      border-bottom: 1px solid #e2e8f0;
      padding: 0.75rem;
    }

    .ql-container.ql-snow {
      border: none;
    }

    .ql-editor {
      min-height: 180px;
      padding: 1rem;
    }

    .form-input-flowbite {
      @apply bg-white border border-gray-300 text-gray-900 text-sm rounded-xl 
             focus:ring-4 focus:ring-blue-200 focus:border-blue-500 block w-full p-2.5 
             transition ease-in-out duration-150;
    }

    .form-label-flowbite {
      @apply block mb-2 text-sm font-semibold text-gray-800;
    }

    .btn-primary {
      @apply px-8 py-3 text-lg font-semibold text-white bg-blue-600 rounded-xl 
             shadow-sm hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 
             transition-transform duration-200 hover:-translate-y-0.5 active:translate-y-0;
    }

    .card-form {
      @apply bg-white p-6 md:p-10 rounded-2xl shadow-lg border border-gray-200 
             hover:shadow-xl transition-shadow duration-300;
    }

    h1 {
      background: linear-gradient(to right, #2563eb, #4f46e5);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</head>

<body>
  <div class="min-h-screen p-4 md:p-8 flex flex-col items-center">
    <main class="w-full max-w-6xl">
      <h1 class="text-4xl font-extrabold mb-10 text-center">Crear Nuevo Curso</h1>

      <div class="card-form">
        <form 
          method="POST" 
          enctype="multipart/form-data" 
          class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-10"
        >
          <!-- Título -->
          <div class="md:col-span-2">
            <label for="titulo" class="form-label-flowbite">Título del Curso</label>
            <input 
              type="text" 
              id="titulo" 
              name="titulo" 
              class="form-input-flowbite" 
              placeholder="Ej: Introducción a JavaScript Moderno" 
              required 
            />
          </div>

          <!-- Descripción -->
          <div class="md:col-span-2">
            <label class="form-label-flowbite">Descripción del Curso</label>
            <div class="editor-container">
              <div id="toolbar-container">
                <span class="ql-formats">
                  <select class="ql-header">
                    <option value="1">Título 1</option>
                    <option value="2">Título 2</option>
                    <option selected>Normal</option>
                  </select>
                </span>
                <span class="ql-formats">
                  <button class="ql-bold"></button>
                  <button class="ql-italic"></button>
                  <button class="ql-underline"></button>
                </span>
                <span class="ql-formats">
                  <button class="ql-list" value="ordered"></button>
                  <button class="ql-list" value="bullet"></button>
                </span>
                <span class="ql-formats"><button class="ql-link"></button></span>
                <span class="ql-formats"><button class="ql-clean"></button></span>
              </div>
              <div id="editor">
                <p>Escribe la descripción <strong>detallada</strong> aquí...</p>
              </div>
            </div>
            <textarea name="descripcion" id="descripcion-oculta" class="hidden"></textarea>
          </div>

          <!-- Autor -->
          <div>
            <label for="autor_id" class="form-label-flowbite">Autor del Curso</label>
            <select id="autor_id" name="autor_id" class="form-input-flowbite" required>
              <option selected disabled value="">Selecciona un autor</option>
              {autores.map(autor => (
                <option value={autor.id}>{autor.nombre}</option>
              ))}
            </select>
          </div>

          <!-- Categoría -->
          <div>
            <label for="categoria_id" class="form-label-flowbite">Categoría</label>
            <select id="categoria_id" name="categoria_id" class="form-input-flowbite" required>
              <option selected disabled value="">Selecciona una categoría</option>
              {categorias.map(cat => (
                <option value={cat.id}>{cat.nombre}</option>
              ))}
            </select>
          </div>

          <!-- Tiempo -->
          <div>
            <label for="tiempo_estimado_min" class="form-label-flowbite">
              Tiempo Estimado (minutos)
            </label>
            <input 
              type="number" 
              id="tiempo_estimado_min" 
              name="tiempo_estimado_min"
              class="form-input-flowbite" 
              placeholder="Ej: 120" 
              min="0"
            />
          </div>

          <!-- Portada -->
          <div>
            <label class="form-label-flowbite" for="portada_url">Subir Portada</label>
            <input 
              class="block w-full text-sm text-gray-900 border border-gray-300 rounded-xl cursor-pointer bg-gray-50 focus:outline-none focus:ring-4 focus:ring-blue-100" 
              id="portada_url" 
              name="portada_url"
              type="file"
              accept="image/png, image/jpeg, image/webp"
            >
            <p class="mt-1 text-xs text-gray-500">PNG, JPG o WEBP (MAX. 800x400px).</p>
          </div>

          <!-- Objetivos -->
          <div class="md:col-span-2">
            <label for="objetivos" class="form-label-flowbite">Objetivos (Lo que el estudiante aprenderá)</label>
            <textarea 
              id="objetivos" 
              name="objetivos" 
              rows="4" 
              class="form-input-flowbite" 
              placeholder="Escribe un objetivo por línea:&#10;- Comprender los fundamentos de...&#10;- Desarrollar habilidades en..."
            ></textarea>
            <p class="mt-1 text-xs text-gray-500">Cada línea se guardará como un objetivo separado.</p>
          </div>

          <!-- Publicar -->
          <div class="md:col-span-2 flex items-center pt-2">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="publicado" value="true" class="sr-only peer">
              <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-blue-600 
                after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                after:bg-white after:border-gray-300 after:border after:rounded-full 
                after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full
                peer-checked:after:border-white"></div>
              <span class="ml-3 text-sm font-medium text-gray-900">
                Publicar curso inmediatamente
              </span>
            </label>
          </div>

          <!-- Botón -->
          <div class="md:col-span-2 flex justify-end pt-6 border-t border-gray-200">
            <button type="submit" class="btn-primary">Guardar Curso</button>
          </div>

        </form>
      </div>
    </main>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
  <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      initFlowbite();
      const quillOptions = { modules: { toolbar: "#toolbar-container" }, theme: "snow" };
      const editor = new Quill("#editor", quillOptions);
      const hiddenTextarea = document.querySelector("#descripcion-oculta");

      if (hiddenTextarea.value) editor.root.innerHTML = hiddenTextarea.value;
      editor.on("text-change", () => (hiddenTextarea.value = editor.root.innerHTML));
      document.querySelector("form").addEventListener("submit", () => {
        hiddenTextarea.value = editor.root.innerHTML;
      });
    });
  </script>
</body>
</html>
