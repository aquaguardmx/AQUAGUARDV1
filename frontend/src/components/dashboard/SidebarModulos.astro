</div>

<script is:inline define:vars={{ modulosJSON, cursoId: cursoIdForScript, currentLeccionId: currentLeccionIdCache || null }}>
    // CACHÉ GLOBAL EN CLIENTE
    if (!window.sidebarCache) {
        window.sidebarCache = new Map();
    }
    
    const CACHE_DURATION = 5 * 60 * 1000; // 5 minutos
    
    // Función segura para obtener elementos
    function getElementSafe(selector) {
        try {
            return document.querySelector(selector);
        } catch (error) {
            console.warn('Elemento no encontrado:', selector);
            return null;
        }
    }
    
    // Función para obtener datos con caché en cliente
    async function obtenerConCache(clave, funcionObtener) {
        const ahora = Date.now();
        const cacheEntry = window.sidebarCache.get(clave);
        
        // Si existe en caché y no ha expirado
        if (cacheEntry && (ahora - cacheEntry.timestamp < CACHE_DURATION)) {
            console.log(`📦 [CLIENTE] Usando caché para: ${clave}`);
            return cacheEntry.datos;
        }
        
        // Obtener datos frescos
        console.log(`🔄 [CLIENTE] Obteniendo datos frescos para: ${clave}`);
        const datos = await funcionObtener();
        
        // Guardar en caché
        window.sidebarCache.set(clave, {
            datos,
            timestamp: ahora
        });
        
        return datos;
    }

    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 Sidebar optimizado cargado');
        
        // Ocultar loading inmediatamente
        const loadingOverlay = getElementSafe('#loading-overlay');
        setTimeout(() => {
            if (loadingOverlay) {
                loadingOverlay.style.opacity = '0';
                setTimeout(() => {
                    loadingOverlay.style.display = 'none';
                }, 300);
            }
        }, 500);

        // Parsear los módulos desde JSON de forma segura
        let modulosNormalizados = [];
        try {
            modulosNormalizados = JSON.parse(modulosJSON || '[]');
            console.log('Módulos procesados:', modulosNormalizados.length);
        } catch (error) {
            console.error('Error parseando modulosJSON:', error);
            modulosNormalizados = [];
        }

        // Función auxiliar para construir URLs
        function construirURLLeccion(leccionId) {
            const cursoIdSafe = cursoId || '1';
            return `/admin/cursos/${cursoIdSafe}/lecciones/${leccionId}`;
        }

        // Función para obtener lecciones con caché
        async function obtenerLeccionesDelModulo(moduloId) {
            const cacheKey = `lecciones_modulo_${moduloId}`;
            
            return await obtenerConCache(cacheKey, async () => {
                try {
                    console.log(`🔍 Obteniendo lecciones para módulo ${moduloId}...`);
                    const response = await fetch(`http://localhost:8000/api/modulos/${moduloId}/lecciones`);
                    
                    if (!response.ok) {
                        throw new Error(`Error ${response.status}: ${response.statusText}`);
                    }
                    
                    const lecciones = await response.json();
                    console.log(`✅ Lecciones obtenidas para módulo ${moduloId}:`, lecciones.length);
                    
                    return Array.isArray(lecciones) ? lecciones.map((leccion, index) => ({
                        ...leccion,
                        id: leccion.id_leccion || leccion.id || (index + 1),
                        id_leccion: leccion.id_leccion || leccion.id || (index + 1),
                        titulo: leccion.titulo || 'Sin título',
                        completada: leccion.completada || false
                    })) : [];
                } catch (error) {
                    console.error(`❌ Error al obtener lecciones del módulo ${moduloId}:`, error);
                    return [];
                }
            });
        }

        // Función optimizada para cargar contadores
        async function cargarContadoresDeLecciones() {
            console.log('⚡ Cargando contadores...');
            
            const moduleToggles = document.querySelectorAll('.module-toggle');
            const totalModulos = moduleToggles.length;
            
            if (totalModulos === 0) return;
            
            const promesas = Array.from(moduleToggles).map(async (button) => {
                const moduleId = button.getAttribute('data-module-id');
                if (!moduleId) return;
                
                try {
                    const leccionesAPI = await obtenerLeccionesDelModulo(moduleId);
                    const counter = button.querySelector('.lecciones-counter');
                    
                    if (counter) {
                        counter.textContent = leccionesAPI.length;
                    }
                    
                    await new Promise(resolve => setTimeout(resolve, 50));
                    
                } catch (error) {
                    console.error(`Error en módulo ${moduleId}:`, error);
                }
            });
            
            await Promise.allSettled(promesas);
            console.log('✅ Contadores cargados');
        }

        // Función para actualizar lecciones en sidebar
        async function actualizarLeccionesEnSidebar(moduloId) {
            const moduleContent = getElementSafe(`[data-module-content="${moduloId}"]`);
            if (!moduleContent) return;

            const leccionesContainer = moduleContent.querySelector('.lecciones-container');
            if (!leccionesContainer) return;

            // Mostrar loading
            leccionesContainer.innerHTML = `
                <div class="flex justify-center items-center py-4">
                    <svg class="animate-spin h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="ml-2 text-sm text-gray-600 dark:text-gray-400">Cargando lecciones...</span>
                </div>
            `;

            try {
                const leccionesAPI = await obtenerLeccionesDelModulo(moduloId);
                
                // Actualizar contador
                const moduleToggle = getElementSafe(`[data-module-id="${moduloId}"]`);
                if (moduleToggle) {
                    const counter = moduleToggle.querySelector('.lecciones-counter');
                    if (counter) {
                        counter.textContent = leccionesAPI.length;
                    }
                }

                // Crear HTML de lecciones
                let leccionesHTML = '';
                if (leccionesAPI.length > 0) {
                    leccionesAPI.forEach(leccion => {
                        const esActiva = leccion.id === currentLeccionId;
                        const esCompletada = leccion.completada || false;
                        const url = construirURLLeccion(leccion.id);

                        leccionesHTML += `
                            <a href="${url}" class="flex items-center p-2 lg:p-3 rounded-lg transition-colors group/leccion ${
                                esActiva 
                                    ? 'bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800' 
                                    : 'text-gray-700 dark:text-gray-300 hover:bg-white dark:hover:bg-gray-600 border border-transparent'
                            }" data-leccion-id="${leccion.id}">
                                <div class="w-6 h-6 lg:w-8 lg:h-8 rounded-full flex items-center justify-center flex-shrink-0 ${
                                    esActiva ? 'bg-blue-600' : esCompletada ? 'bg-green-500' : 'bg-gray-200 dark:bg-gray-600'
                                }">
                                    ${esActiva ? '<svg class="w-3 h-3 lg:w-4 lg:h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"></path></svg>' : 
                                    esCompletada ? '<svg class="w-3 h-3 lg:w-4 lg:h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>' : 
                                    '<svg class="w-3 h-3 lg:w-4 lg:h-4 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>'}
                                </div>
                                <span class="ml-2 lg:ml-3 text-sm lg:text-base font-medium line-clamp-2 flex-1 ${
                                    esActiva ? 'text-blue-700 dark:text-blue-300' : 'text-gray-700 dark:text-gray-300'
                                }">
                                    ${leccion.titulo || 'Sin título'}
                                </span>
                            </a>
                        `;
                    });
                } else {
                    leccionesHTML = `
                        <div class="text-center py-3 lg:py-4">
                            <svg class="w-6 h-6 lg:w-8 lg:h-8 text-gray-400 mx-auto mb-1 lg:mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                            </svg>
                            <p class="text-xs lg:text-sm text-gray-500 dark:text-gray-400">No hay lecciones en este módulo</p>
                        </div>
                    `;
                }

                leccionesContainer.innerHTML = leccionesHTML;

            } catch (error) {
                console.error(`Error al actualizar lecciones para módulo ${moduloId}:`, error);
                leccionesContainer.innerHTML = `
                    <div class="text-center py-3 lg:py-4">
                        <svg class="w-6 h-6 lg:w-8 lg:h-8 text-red-400 mx-auto mb-1 lg:mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-xs lg:text-sm text-red-500 dark:text-red-400">Error al cargar lecciones</p>
                    </div>
                `;
            }
        }

        // Inicializar acordeón
        function initAccordion() {
            const moduleToggles = document.querySelectorAll('.module-toggle');
            
            moduleToggles.forEach((button) => {
                const moduleId = button.getAttribute('data-module-id');
                if (!moduleId) return;
                
                const moduleContent = getElementSafe(`[data-module-content="${moduleId}"]`);
                const arrow = button.querySelector('.module-arrow');

                if (moduleContent && arrow) {
                    const moduleData = modulosNormalizados.find(m => m.id == moduleId);
                    if (moduleData?.expandido) {
                        moduleContent.style.maxHeight = moduleContent.scrollHeight + 'px';
                        arrow.classList.add('rotate-180');
                    }

                    button.addEventListener('click', async function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const isExpanded = moduleContent.style.maxHeight && moduleContent.style.maxHeight !== '0px';
                        
                        if (isExpanded) {
                            moduleContent.style.maxHeight = '0px';
                            arrow.classList.remove('rotate-180');
                        } else {
                            moduleContent.style.maxHeight = moduleContent.scrollHeight + 'px';
                            arrow.classList.add('rotate-180');
                            
                            await actualizarLeccionesEnSidebar(moduleId);
                            
                            setTimeout(() => {
                                moduleContent.style.maxHeight = moduleContent.scrollHeight + 'px';
                            }, 100);
                        }
                    });
                }
            });
        }

        // Inicializar
        initAccordion();
        
        // Cargar contadores en segundo plano
        setTimeout(() => {
            cargarContadoresDeLecciones();
        }, 1000);

        // Manejo del modal (código seguro)
        const addModuleBtn = getElementSafe('#add-module-btn');
        const moduleModal = getElementSafe('#module-modal');
        const closeModuleModal = getElementSafe('#close-module-modal');
        const cancelModuleBtn = getElementSafe('#cancel-module-btn');
        const addModuleForm = getElementSafe('#add-module-form');

        if (addModuleBtn && moduleModal) {
            addModuleBtn.addEventListener('click', function() {
                moduleModal.classList.remove('hidden');
                moduleModal.classList.add('flex');
                const moduleNameInput = getElementSafe('#module-name');
                if (moduleNameInput) moduleNameInput.focus();
            });
        }

        function closeModal() {
            if (moduleModal) {
                moduleModal.classList.remove('flex');
                moduleModal.classList.add('hidden');
                if (addModuleForm) addModuleForm.reset();
                
                const submitModuleBtn = getElementSafe('#submit-module-btn');
                const submitText = getElementSafe('#submit-text');
                const loadingSpinner = getElementSafe('#loading-spinner');
                
                if (submitModuleBtn) submitModuleBtn.disabled = false;
                if (submitText) submitText.classList.remove('hidden');
                if (loadingSpinner) loadingSpinner.classList.add('hidden');
            }
        }

        if (closeModuleModal) closeModuleModal.addEventListener('click', closeModal);
        if (cancelModuleBtn) cancelModuleBtn.addEventListener('click', closeModal);

        if (moduleModal) {
            moduleModal.addEventListener('click', function(e) {
                if (e.target === moduleModal) closeModal();
            });
        }

        // Manejo del formulario
        if (addModuleForm) {
            addModuleForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const moduleInput = getElementSafe('#module-name');
                const moduleName = moduleInput?.value.trim();
                
                if (moduleName) {
                    const submitModuleBtn = getElementSafe('#submit-module-btn');
                    const submitText = getElementSafe('#submit-text');
                    const loadingSpinner = getElementSafe('#loading-spinner');
                    
                    if (submitModuleBtn) submitModuleBtn.disabled = true;
                    if (submitText) submitText.classList.add('hidden');
                    if (loadingSpinner) loadingSpinner.classList.remove('hidden');

                    try {
                        const response = await fetch('http://localhost:8000/api/modulos/', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                curso_id: parseInt(cursoId || '1'), 
                                titulo: moduleName 
                            })
                        });

                        if (!response.ok) {
                            throw new Error(`Error ${response.status}: ${response.statusText}`);
                        }

                        const data = await response.json();
                        console.log('Módulo creado:', data);
                        
                        // Recargar la página para ver el nuevo módulo
                        window.location.reload();
                        
                    } catch (error) {
                        console.error('Error al añadir el módulo:', error);
                        alert('Hubo un error al añadir el módulo. Inténtalo de nuevo.');
                        
                        // Restaurar el botón
                        if (submitModuleBtn) submitModuleBtn.disabled = false;
                        if (submitText) submitText.classList.remove('hidden');
                        if (loadingSpinner) loadingSpinner.classList.add('hidden');
                    }
                }
            });
        }

        // Función para limpiar caché
        window.limpiarCacheSidebar = function() {
            window.sidebarCache.clear();
            console.log('🗑️ Caché limpiado');
        };
    });
</script>