---
import SidebarModulos from '../../../components/dashboard/SidebarModulos.astro';
import EditorLecciones from '../../../components/dashboard/EditorLecciones.astro';

// Interfaces para TypeScript
interface Modulo {
  id_modulo: number;
  titulo: string;
  descripcion: string;
  orden: number;
  curso_id: number;
  lecciones: Leccion[];
}

interface Leccion {
  id_leccion: number;
  titulo: string;
  descripcion: string;
  contenido: string;
  tipo_contenido: 'video' | 'texto';
  url_video?: string;
  orden: number;
  modulo_id: number;
  recursos: Recurso[];
}

interface Recurso {
  id_recurso: number;
  titulo: string;
  url: string;
  tipo: string;
  leccion_id: number;
}

// Obtener el ID del curso de la URL
const { id } = Astro.params;

// Estado para controlar la visibilidad del editor
let mostrarEditor = false;
let leccionActual = null;
let modulos = [];
let modoCreacion = false; // Nuevo estado para diferenciar entre crear y editar

// Obtener los módulos del curso
try {
    const modulosResponse = await fetch(`http://localhost:8000/api/cursos/${id}/modulos`);
    
    if (modulosResponse.ok) {
        const modulosData = await modulosResponse.json();
        
        if (Array.isArray(modulosData)) {
            modulos = modulosData;
        } else if (modulosData && Array.isArray(modulosData.data)) {
            modulos = modulosData.data;
        } else if (modulosData && Array.isArray(modulosData.modulos)) {
            modulos = modulosData.modulos;
        }
    }
} catch (error) {
    console.error('Error cargando módulos:', error);
}

// Verificar si estamos creando una nueva lección
if (Astro.url.searchParams.has('nueva_leccion')) {
    const moduloId = Astro.url.searchParams.get('nueva_leccion');
    mostrarEditor = true;
    modoCreacion = true;
    
    // Crear objeto de lección vacío para nueva lección
    leccionActual = {
        titulo: "",
        descripcion: "",
        contenido: "",
        tipo_contenido: "texto",
        url_video: "",
        modulo_id: parseInt(moduloId),
        recursos: []
    };
}
// Si hay una lección específica para editar, cargarla y mostrar el editor
else if (Astro.url.searchParams.has('leccion_id')) {
    const leccionId = Astro.url.searchParams.get('leccion_id');
    try {
        const leccionResponse = await fetch(`http://localhost:8000/api/lecciones/${leccionId}/`);
        if (leccionResponse.ok) {
            const leccionData = await leccionResponse.json();
            
            if (leccionData) {
                leccionActual = {
                    id_leccion: leccionData.id_leccion || leccionData.id,
                    titulo: leccionData.titulo || "",
                    descripcion: leccionData.descripcion || "",
                    contenido: leccionData.contenido || "",
                    tipo_contenido: leccionData.tipo_contenido || "texto",
                    url_video: leccionData.url_video || "",
                    modulo_id: leccionData.modulo_id,
                    recursos: Array.isArray(leccionData.recursos) ? leccionData.recursos : []
                };
                mostrarEditor = true;
                modoCreacion = false;
            }
        }
    } catch (error) {
        console.error('Error cargando lección:', error);
    }
}

// Si no se pudo cargar la lección y estamos en modo creación, usar valores por defecto
if (modoCreacion && !leccionActual) {
    leccionActual = {
        titulo: "",
        descripcion: "",
        contenido: "",
        tipo_contenido: "texto",
        url_video: "",
        modulo_id: parseInt(Astro.url.searchParams.get('nueva_leccion')),
        recursos: []
    };
}
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Lecciones - AquaLearn</title>
    <style>
        .ql-editor {
            min-height: 200px;
            font-size: 14px;
            line-height: 1.6;
        }
        
        .ql-toolbar.ql-snow {
            border-top: 1px solid #e5e7eb;
            border-left: 1px solid #e5e7eb;
            border-right: 1px solid #e5e7eb;
            border-bottom: none;
            border-radius: 8px 8px 0 0;
        }
        
        .ql-container.ql-snow {
            border-bottom: 1px solid #e5e7eb;
            border-left: 1px solid #e5e7eb;
            border-right: 1px solid #e5e7eb;
            border-top: none;
            border-radius: 0 0 8px 8px;
        }

        /* Estilos para el estado de bienvenida */
        .welcome-state {
            text-align: center;
            padding: 4rem 2rem;
        }
        
        .welcome-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
        }

        @media (prefers-color-scheme: dark) {
            .ql-snow .ql-stroke {
                stroke: #d1d5db;
            }
            
            .ql-snow .ql-fill {
                fill: #d1d5db;
            }
            
            .ql-snow .ql-picker-label {
                color: #d1d5db;
            }
            
            .ql-snow .ql-picker-options {
                background-color: #374151;
                border-color: #4b5563;
            }
            
            .ql-snow .ql-picker-item {
                color: #d1d5db;
            }
            
            .ql-snow.ql-toolbar button:hover,
            .ql-snow .ql-toolbar button:hover,
            .ql-snow.ql-toolbar button:focus,
            .ql-snow .ql-toolbar button:focus,
            .ql-snow.ql-toolbar button.ql-active,
            .ql-snow .ql-toolbar button.ql-active,
            .ql-snow.ql-toolbar .ql-picker-label:hover,
            .ql-snow .ql-toolbar .ql-picker-label:hover,
            .ql-snow.ql-toolbar .ql-picker-label.ql-active,
            .ql-snow .ql-toolbar .ql-picker-label.ql-active,
            .ql-snow.ql-toolbar .ql-picker-item:hover,
            .ql-snow .ql-toolbar .ql-picker-item:hover,
            .ql-snow.ql-toolbar .ql-picker-item.ql-selected,
            .ql-snow .ql-toolbar .ql-picker-item.ql-selected {
                color: #3b82f6;
            }
            
            .ql-snow.ql-toolbar button:hover .ql-stroke,
            .ql-snow .ql-toolbar button:hover .ql-stroke,
            .ql-snow.ql-toolbar button:focus .ql-stroke,
            .ql-snow .ql-toolbar button:focus .ql-stroke,
            .ql-snow.ql-toolbar button.ql-active .ql-stroke,
            .ql-snow .ql-toolbar button.ql-active .ql-stroke,
            .ql-snow.ql-toolbar .ql-picker-label:hover .ql-stroke,
            .ql-snow .ql-toolbar .ql-picker-label:hover .ql-stroke,
            .ql-snow.ql-toolbar .ql-picker-label.ql-active .ql-stroke,
            .ql-snow .ql-toolbar .ql-picker-label.ql-active .ql-stroke,
            .ql-snow.ql-toolbar .ql-picker-item:hover .ql-stroke,
            .ql-snow .ql-toolbar .ql-picker-item:hover .ql-stroke,
            .ql-snow.ql-toolbar .ql-picker-item.ql-selected .ql-stroke,
            .ql-snow .ql-toolbar .ql-picker-item.ql-selected .ql-stroke,
            .ql-snow.ql-toolbar button:hover .ql-fill,
            .ql-snow .ql-toolbar button:hover .ql-fill,
            .ql-snow.ql-toolbar button:focus .ql-fill,
            .ql-snow .ql-toolbar button:focus .ql-fill,
            .ql-snow.ql-toolbar button.ql-active .ql-fill,
            .ql-snow .ql-toolbar button.ql-active .ql-fill,
            .ql-snow.ql-toolbar .ql-picker-label:hover .ql-fill,
            .ql-snow .ql-toolbar .ql-picker-label:hover .ql-fill,
            .ql-snow.ql-toolbar .ql-picker-label.ql-active .ql-fill,
            .ql-snow .ql-toolbar .ql-picker-label.ql-active .ql-fill,
            .ql-snow.ql-toolbar .ql-picker-item:hover .ql-fill,
            .ql-snow .ql-toolbar .ql-picker-item:hover .ql-fill,
            .ql-snow.ql-toolbar .ql-picker-item.ql-selected .ql-fill,
            .ql-snow .ql-toolbar .ql-picker-item.ql-selected .ql-fill {
                stroke: #3b82f6;
                fill: #3b82f6;
            }
        }
    </style>
</head>
<body>
    <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
        <!-- Header de Navegación -->
        <nav class="bg-white border-b border-gray-200 dark:bg-gray-800 dark:border-gray-700 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <!-- Logo y Título -->
                    <div class="flex items-center space-x-4">
                        <a href="/" class="flex items-center space-x-3">
                            <img class="h-8 w-8" src="/img/logo.png" alt="AquaLearn Logo" />
                            <span class="text-xl font-bold text-gray-900 dark:text-white">AquaLearn</span>
                        </a>
                        <div class="hidden md:block">
                            <span class="text-lg font-semibold text-gray-700 dark:text-gray-300">
                                {mostrarEditor ? (modoCreacion ? 'Nueva Lección' : leccionActual.titulo) : 'Creación de Curso'}
                            </span>
                        </div>
                    </div>

                    <!-- Menú de Usuario -->
                    <div class="flex items-center space-x-4">
                        <a 
                            href="/dashboardAdmin" 
                            class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors"
                        >
                            ← Volver al Panel
                        </a>
                        <div class="relative">
                            <button
                                type="button"
                                class="flex text-sm bg-gray-800 rounded-full focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-800"
                                id="user-menu-button"
                            >
                                <span class="sr-only">Abrir menú de usuario</span>
                                <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center">
                                    <span class="text-white text-sm font-medium">A</span>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Contenido Principal -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Sidebar - Módulos y Lecciones -->
                <SidebarModulos 
                    modulos={modulos} 
                    cursoId={id} 
                    currentLeccionId={leccionActual?.id_leccion}
                    modoCreacion={modoCreacion}
                />

                <!-- Contenido Principal - Formulario de Edición o Bienvenida -->
                <main class="flex-1 min-w-0 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
                    {mostrarEditor ? (
                        <EditorLecciones 
                            leccionActual={leccionActual} 
                            modoCreacion={modoCreacion}
                            cursoId={id}
                        />
                    ) : (
                        <div class="welcome-state">
                            <div class="welcome-icon">📚</div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
                                Bienvenido a la Creación de Curso
                            </h2>
                            <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
                                Selecciona una lección existente del sidebar o haz clic en "Agregar Lección" 
                                para comenzar a crear contenido educativo.
                            </p>
                            <div class="text-gray-500 dark:text-gray-500 text-sm">
                                <p>💡 <strong>Tip:</strong> Organiza tu curso en módulos y lecciones</p>
                                <p>🚀 Comienza agregando tu primera lección</p>
                            </div>
                        </div>
                    )}
                </main>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
</body>
</html>